/-- Higham, 2nd ed., Chapter 20, Theorem 20.7 QR dependency:
    reduced-space `j^2` row-wise envelope transported to original space through
    Chapter 19's packaged `sqrt(m)` transfer.

    The hypothesis is exactly the still-separate reduced-difference estimate.
    The conclusion is honest about the extra `sqrt(m)` factor and does not
    claim the final row-specific Powell--Reid bound. -/
theorem theorem20_7_packaged_original_space_sqrt_m_j_sq_of_reducedDiff_bound
    {m n : ℕ} (jbound : ℕ)
    (Q : Fin m → Fin m → ℝ) (Rhat : Fin m → Fin n → ℝ)
    (AP DeltaA : Fin m → Fin n → ℝ)
    (gammaTildeClass alpha rowMax : ℝ)
    (hγ : 0 ≤ gammaTildeClass) (hα : 0 ≤ alpha) (hrowMax : 0 ≤ rowMax)
    (hQ : IsOrthogonal m Q)
    (hfact : ∀ i j, AP i j + DeltaA i j = matMulRect m m n Q Rhat i j)
    (hE_reduced : ∀ (k : Fin m) (j : Fin n),
      |Wave18C.reducedDiff Q Rhat AP k j| ≤
        ((jbound : ℝ) ^ 2) * gammaTildeClass * alpha * rowMax)
    (i : Fin m) (j : Fin n) :
    |DeltaA i j| ≤
      Real.sqrt (m : ℝ) *
        (((jbound : ℝ) ^ 2) * gammaTildeClass * alpha * rowMax) :=
  Wave18C.theorem19_6_packaged_original_space_printed_j_sq
    jbound Q Rhat AP DeltaA gammaTildeClass alpha rowMax
    hγ hα hrowMax hQ hfact hE_reduced i j
/-- Higham, 2nd ed., Chapter 20, Theorem 20.7 QR dependency:
    the Chapter 19 row-specific route's concrete pivot-row obstruction exposed
    at the row-wise least-squares boundary.

An entrywise per-step perturbation budget `c` is amplified by an exact
Householder reflector into a pivot-row bound with the `sqrt(m)` factor.  This is
the local Chapter 20.7-facing form of the reason the available per-step route
does not by itself prove the printed Powell--Reid row-local envelope. -/
theorem theorem20_7_pivot_row_entrywiseBudget_incurs_sqrt_m_of_ch19_row_specific_route
    (m : ℕ) (p : Fin m) (v : Fin m → ℝ) (β c : ℝ) (w : Fin m → ℝ)
    (hvprefix : ∀ i : Fin m, i.val < p.val → v i = 0)
    (horth : IsOrthogonal m (householder m v β))
    (hc : 0 ≤ c) (hw : ∀ i : Fin m, |w i| ≤ c) :
    ∃ K : ℝ, K = Real.sqrt (m : ℝ) ∧
      |matMulVec m (householder m v β) w p| ≤ K * c :=
  Wave18D.pivotRow_entrywiseBudget_incurs_sqrt_m
    m p v β c w hvprefix horth hc hw
/-- Higham, 2nd ed., Chapter 20, Theorem 20.7 QR dependency:
    Cox--Higham's row-wise elementwise column-pivoted Householder QR backward
    error, exposed at the weighted least-squares boundary.

Unlike the earlier original-space transfer wrappers, this Chapter 19.6 route
keeps the forward row-growth scale `alpha_i` and gives the printed `j^2`
row-wise envelope without an ambient `sqrt(m)` factor.  The hard QR hypotheses
remain explicit in the imported theorem: the factored perturbation identity,
nonnegative row-growth scales, and the Cox--Higham stage-sum bound. -/
theorem theorem20_7_coxHigham_rowwise_elementwise_backward_error_no_sqrt_m
    {m n : ℕ} (A : Fin m → Fin n → ℝ) (π : Equiv.Perm (Fin n))
    (Q : Fin m → Fin m → ℝ) (Rhat : Fin m → Fin n → ℝ)
    (DeltaA : Fin m → Fin n → ℝ)
    (alpha : Fin m → ℝ) (gammaTilde : ℝ)
    (hgamma : 0 ≤ gammaTilde)
    (halpha : ∀ i, 0 ≤ alpha i)
    (hQ : IsOrthogonal m Q)
    (hR : IsUpperTrapezoidal m n Rhat)
    (hfact : ∀ i j, Wave13.columnPermuteMatrix A π i j + DeltaA i j =
      matMulRect m m n Q Rhat i j)
    (hstage : ∀ (i : Fin m) (j : Fin n),
      |DeltaA i j| ≤
        (∑ s ∈ Finset.range j.val, (1 + 4 * ((s : ℝ) + 1))) *
          gammaTilde * alpha i) :
    IsOrthogonal m Q ∧
    IsUpperTrapezoidal m n Rhat ∧
    (∀ i j, Wave13.columnPermuteMatrix A π i j + DeltaA i j =
      matMulRect m m n Q Rhat i j) ∧
    (∀ i j, |DeltaA i j| ≤
      (j.val : ℝ) ^ 2 * (5 * gammaTilde) * alpha i) :=
  Wave19.H19_Theorem19_6_rowwise_elementwise_backward_error
    A π Q Rhat DeltaA alpha gammaTilde hgamma halpha hQ hR hfact hstage
/-- Source-shaped nonzero-row hypotheses discharge both denominator
    positivity side conditions used by the Theorem 20.7 row-growth bridges. -/
theorem theorem20_7_denominators_pos_of_rows_nonzero {m n : ℕ}
    (hn : 0 < n) (A : Fin m → Fin n → ℝ) (b : Fin m → ℝ)
    {phi : ℝ} (hphi : 0 < phi)
    (hrows : ∀ i : Fin m, ∃ j : Fin n, A i j ≠ 0) :
    (∀ i : Fin m, 0 < theorem20_7_initialRowMax hn A i) ∧
      (∀ i : Fin m, 0 < theorem20_7_initialWeightedRowMax hn A b phi i) := by
  constructor
  · intro i
    exact theorem20_7_initialRowMax_pos_of_exists_entry_ne_zero hn A i (hrows i)
  · intro i
    exact
      theorem20_7_initialWeightedRowMax_pos_of_exists_entry_ne_zero
        hn A b hphi i (hrows i)

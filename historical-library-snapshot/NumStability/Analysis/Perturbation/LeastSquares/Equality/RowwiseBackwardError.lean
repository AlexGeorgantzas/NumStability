    (i : Fin m) :
    0 ≤ theorem20_7_initialWeightedRowMax hn A b phi i := by
  dsimp [theorem20_7_initialWeightedRowMax]
  exact
    (mul_nonneg hphi (theorem20_7_initialRowMax_nonneg hn A i)).trans
      (le_max_left _ _)

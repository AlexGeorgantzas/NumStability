noncomputable def theorem20_7_initialWeightedRowMax {m n : ℕ} (hn : 0 < n)
    (A : Fin m → Fin n → ℝ) (b : Fin m → ℝ) (phi : ℝ) (i : Fin m) : ℝ :=

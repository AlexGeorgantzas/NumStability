        ∀ a : Fin m,
          matMulVec m (householder m (v i.val) (beta i.val))
            (fun r => Astage i.val r j) a = Astage i.val a j)
    (hpivot :
      ∀ i : Fin m, i.val + 1 < n → ∀ j : Fin n, j.val = i.val →

def Theorem20_7RowwiseBackwardError.of_permuteRows {m n : ℕ}
    {hn : 0 < n} {A : Fin m → Fin n → ℝ} {b : Fin m → ℝ}
    {Astage : ℕ → Fin m → Fin n → ℝ} {bstage : ℕ → Fin m → ℝ}

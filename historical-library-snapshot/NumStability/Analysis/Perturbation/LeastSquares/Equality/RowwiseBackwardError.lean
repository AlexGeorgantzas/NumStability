        ext i
        simp [b', vecPermute]
      rw [hAperm, hbperm]
      exact hcert.exact_solution y
    rw [lsObjective_permuteRows σ A' b' xhat] at hperm
    rw [lsObjective_permuteRows σ A' b' y] at hperm
    simpa [A', b'] using hperm

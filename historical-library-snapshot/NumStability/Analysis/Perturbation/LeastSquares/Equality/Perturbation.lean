          ≤ LSEKKTInverseSolutionStatCoeff hB hnull * vecNorm2 statRhs := hop
      _ ≤ LSEKKTInverseSolutionStatCoeff hB hnull *
            (statScale * vecNorm2 x) := hrhs
      _ = (LSEKKTInverseSolutionStatCoeff hB hnull * statScale) *

      vecNorm2 (fun j : Fin n => y j - x j) ≤
        eps * theorem20_8FirstOrderRHS A b B d x r APplus BAplus *
          vecNorm2 x :=
    hbase.trans (hcombined.trans hsum)
  exact (div_le_iff₀ hxpos).2 (by simpa [BAplus, mul_assoc] using hscaled)

    ⟨h⟩
  have hMP :
      RectMoorePenrosePseudoinverse (r + (k + 1)) (p + (k + 1))
        (theorem20_8AP A B (undetAplusOfGramNonsingInv B))
        h.liftedReducedGramAPplus :=

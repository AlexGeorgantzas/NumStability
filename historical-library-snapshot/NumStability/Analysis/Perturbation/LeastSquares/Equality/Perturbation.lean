      eps * theorem20_8FirstOrderRHS A b B d x r APplus
          (theorem20_8BAplus A B Bplus APplus) ≤
        eps * theorem20_8FirstOrderRHS A b B d x r APplus
            (theorem20_8BAplus A B Bplus APplus) +
          eps ^ 2 *

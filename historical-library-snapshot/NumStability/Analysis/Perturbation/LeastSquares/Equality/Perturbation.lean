            residualR := by
      linarith
    have hscaled_direct_data :
        eps *
            (theorem20_8KappaA B BAplus *
                (vecNorm2 d / (frobNormRect B * vecNorm2 x) + 1) +
              theorem20_8KappaB A APplus *
                (vecNorm2 b / (frobNormRect A * vecNorm2 x) + 1)) *
            vecNorm2 x ≤
          eps *
              (theorem20_8KappaA B BAplus *

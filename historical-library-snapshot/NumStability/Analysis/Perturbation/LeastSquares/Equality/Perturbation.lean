  have hsmall_prod :
      eps * theorem20_8KKTLinearizedGainSmallnessCoeff hB hnull < 1 :=
    theorem20_8KKTLinearizedGainSmallnessCoeff_eps_mul_lt_one_of_eps_lt_threshold

    have hr_i := congrFun hr i
    have hres_i := congrFun hres i
    unfold lsResidual at hdecomp_i
    unfold lsResidualHigham at hr_i hres_i
    dsimp [apAction, correction] at hdecomp_i ⊢
    linarith

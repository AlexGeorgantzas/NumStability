/-- Single source-facing smallness threshold for the current Theorem 20.8 KKT
    route.  It is the minimum of the two rank-preservation radii and the
    linearized KKT gain threshold. -/
noncomputable def theorem20_8RankKKTSmallnessThreshold {m n p : ℕ}
    {A : Fin m → Fin n → ℝ} {B : Fin p → Fin n → ℝ}
    (hB : LSEFullRowRank B) (hStack : LSEStackedFullColumnRank A B) : ℝ :=
  min (hB.transposeVecNorm2LowerMargin / frobNormRect B)
    (min (hStack.vecNorm2LowerMargin / (frobNormRect A + frobNormRect B))
      (theorem20_8KKTLinearizedGainSmallnessThreshold hB
        ((LSENullIntersectionTrivial.iff_lseStackedFullColumnRank A B).2
          hStack)))
/-- Positivity of the combined rank-preservation/KKT smallness threshold under
    the source nonzero-norm hypotheses used by the displayed maximum-relative
    perturbation route. -/
theorem theorem20_8RankKKTSmallnessThreshold_pos {m n p : ℕ}
    {A : Fin m → Fin n → ℝ} {B : Fin p → Fin n → ℝ}
    (hB : LSEFullRowRank B) (hStack : LSEStackedFullColumnRank A B)
    (hApos : 0 < frobNormRect A) (hBpos : 0 < frobNormRect B) :
    0 < theorem20_8RankKKTSmallnessThreshold hB hStack := by
  have hBmargin_pos : 0 < hB.transposeVecNorm2LowerMargin :=
    hB.transposeVecNorm2LowerMargin_pos
  have hStackMargin_pos : 0 < hStack.vecNorm2LowerMargin :=
    hStack.vecNorm2LowerMargin_pos
  have hsum_pos : 0 < frobNormRect A + frobNormRect B :=
    add_pos hApos hBpos
  have hBquota :
      0 < hB.transposeVecNorm2LowerMargin / frobNormRect B :=
    div_pos hBmargin_pos hBpos
  have hStackQuota :
      0 < hStack.vecNorm2LowerMargin /
        (frobNormRect A + frobNormRect B) :=
    div_pos hStackMargin_pos hsum_pos
  have hKKT :
      0 <
        theorem20_8KKTLinearizedGainSmallnessThreshold hB
          ((LSENullIntersectionTrivial.iff_lseStackedFullColumnRank A B).2
            hStack) :=
    theorem20_8KKTLinearizedGainSmallnessThreshold_pos hB
      ((LSENullIntersectionTrivial.iff_lseStackedFullColumnRank A B).2
        hStack)
  dsimp [theorem20_8RankKKTSmallnessThreshold]
  exact lt_min hBquota (lt_min hStackQuota hKKT)
/-- A strict comparison with the combined Theorem 20.8 smallness threshold
    discharges both rank-preservation margins and the KKT gain threshold. -/
theorem theorem20_8_rank_kkt_smallness_conditions_of_eps_lt_threshold
    {m n p : ℕ}
    {A : Fin m → Fin n → ℝ} {B : Fin p → Fin n → ℝ}
    (hB : LSEFullRowRank B) (hStack : LSEStackedFullColumnRank A B)
    {eps : ℝ}
    (hApos : 0 < frobNormRect A) (hBpos : 0 < frobNormRect B)
    (hsmall : eps < theorem20_8RankKKTSmallnessThreshold hB hStack) :
    eps * frobNormRect B < hB.transposeVecNorm2LowerMargin ∧
      eps * frobNormRect A + eps * frobNormRect B <
        hStack.vecNorm2LowerMargin ∧
      eps <
        theorem20_8KKTLinearizedGainSmallnessThreshold hB
          ((LSENullIntersectionTrivial.iff_lseStackedFullColumnRank A B).2
            hStack) := by
  have hBraw :
      eps < hB.transposeVecNorm2LowerMargin / frobNormRect B :=
    lt_of_lt_of_le hsmall (by
      dsimp [theorem20_8RankKKTSmallnessThreshold]
      exact min_le_left _ _)
  have hrest :
      eps <
        min (hStack.vecNorm2LowerMargin /
            (frobNormRect A + frobNormRect B))
          (theorem20_8KKTLinearizedGainSmallnessThreshold hB
            ((LSENullIntersectionTrivial.iff_lseStackedFullColumnRank A B).2
              hStack)) :=
    lt_of_lt_of_le hsmall (by
      dsimp [theorem20_8RankKKTSmallnessThreshold]
      exact min_le_right _ _)
  have hStackRaw :
      eps <
        hStack.vecNorm2LowerMargin / (frobNormRect A + frobNormRect B) :=
    lt_of_lt_of_le hrest (min_le_left _ _)
  have hKKT :
      eps <
        theorem20_8KKTLinearizedGainSmallnessThreshold hB
          ((LSENullIntersectionTrivial.iff_lseStackedFullColumnRank A B).2
            hStack) :=
    lt_of_lt_of_le hrest (min_le_right _ _)
  have hBsmall : eps * frobNormRect B < hB.transposeVecNorm2LowerMargin := by
    rw [lt_div_iff₀ hBpos] at hBraw
    exact hBraw
  have hsum_pos : 0 < frobNormRect A + frobNormRect B :=
    add_pos hApos hBpos
  have hStackMul :
      eps * (frobNormRect A + frobNormRect B) <
        hStack.vecNorm2LowerMargin := by
    rw [lt_div_iff₀ hsum_pos] at hStackRaw
    exact hStackRaw
  have hStackSmall :
      eps * frobNormRect A + eps * frobNormRect B <
        hStack.vecNorm2LowerMargin := by
    nlinarith
  exact ⟨hBsmall, hStackSmall, hKKT⟩

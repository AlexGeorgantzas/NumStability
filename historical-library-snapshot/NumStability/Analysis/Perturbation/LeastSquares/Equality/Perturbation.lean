          eps * vecNorm2 b := by
    exact
      theorem20_8_vecNorm2_perturbed_residual_correction_BAplus_split_le_of_relativeBudget_op2
        A DeltaA b Deltab B DeltaB Bplus APplus d Deltad y hbudget

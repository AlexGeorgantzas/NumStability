theorem
    IsLSEMinimizer.kkt_solution_difference_relative_le_of_inverseSolutionLinearMap_canonical_response_coeffs_relativeBudget_sourceResidual_scales_of_multiplier
    {m n p : ℕ}
    {A DeltaA : Fin m → Fin n → ℝ} {b Deltab : Fin m → ℝ}

            (LSEKKTInverseMultiplierDataCoeff hB hnull * dataScale +
              LSEKKTInverseMultiplierStatCoeff hB hnull * statScale +
              LSEKKTInverseMultiplierConstrCoeff hB hnull * constrScale) *
              vecNorm2 x := add_le_add hlambdaScale hdiff

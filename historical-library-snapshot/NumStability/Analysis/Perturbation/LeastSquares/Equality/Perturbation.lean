/-- Elementary norm-growth corollary: any relative solution-difference bound
    gives the corresponding perturbed-solution scale. -/
theorem vecNorm2_le_one_add_relative_bound_mul {n : ℕ}
    (x y : Fin n → ℝ) {radius : ℝ}
    (hxnorm : 0 < vecNorm2 x)
    (hrel :
      vecNorm2 (fun j : Fin n => y j - x j) / vecNorm2 x ≤ radius) :
    vecNorm2 y ≤ (1 + radius) * vecNorm2 x := by
  have hbase := vecNorm2_le_one_add_relative_difference_mul x y hxnorm
  have hfactor :
      1 + vecNorm2 (fun j : Fin n => y j - x j) / vecNorm2 x ≤
        1 + radius := by
    simpa [add_comm] using add_le_add_left hrel 1
  exact hbase.trans
    (mul_le_mul_of_nonneg_right hfactor (le_of_lt hxnorm))

        LSEKKTInverseSolutionLinearMap hB hnull
          (fun i => Deltab i - rectMatMulVec DeltaA y i,
           fun j =>
            (∑ r : Fin p, DeltaB r j * mu r) -
              (∑ i : Fin m,
                DeltaA i j *

          (fun k : Fin n => y k - x k))
    (hx : LSEFeasible B d x)
    (hy : LSEFeasible (fun i j => B i j + DeltaB i j)
      (fun i => d i + Deltad i) y)
    (hr : lsResidualHigham A b x = r)

theorem theorem20_8KKTSourceResidualRatioGainConditions_of_coupledNumerator_lt_solutionMargin
    {m n p : ℕ}
    {A : Fin m → Fin n → ℝ} {B : Fin p → Fin n → ℝ}
    (hB : LSEFullRowRank B) (hnull : LSENullIntersectionTrivial A B)
    {eps : ℝ}
    (hmultGain :

    (hmultGainHalf :
      LSEKKTInverseMultiplierStatCoeff hB hnull * (eps * frobNormRect B) ≤
        (1 : ℝ) / 2)
    (hsolSmall :
      eps * theorem20_8KKTSolutionSelfLinearCoeff hB hnull < 1)
    (hcoupledLinearMargin :
      LSEKKTInverseSolutionStatCoeff hB hnull * (eps * frobNormRect B) *

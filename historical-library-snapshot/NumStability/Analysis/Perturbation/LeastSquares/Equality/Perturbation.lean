theorem
    GeneralizedQRFactorization.theorem20_8_solution_difference_relative_le_firstOrderRHS_plus_eps_sq_coefficient_of_liftedReducedGram_source_residual_gap
    {r p q : ℕ}
    (A DeltaA : Fin (r + q) → Fin (p + q) → ℝ)

    (hu : fp.u ≤ Ucap)
    (huCap : (m : ℝ) * Ucap < 1)
    (hGcap : ((m : ℝ) * Ucap) / (1 - (m : ℝ) * Ucap) ≤ Gcap)
    (hsmall :
      let Fcap :=
        Ucap * (1 + Gcap) * (1 + Ucap) +
          Ucap * (1 + Gcap) +
          Gcap +
          Ucap * (1 + Gcap) * (1 + Ucap) ^ 2
      2 * Dcap *
          ((m : ℝ) *
            ((((n : ℝ) * ((n : ℝ) + 1) * (Ucap + 2 * Fcap)) *
                Ncap) ^ 2)) <
        1) :
    2 * storedQRDiagDominantInvFactorBudget hmn A_hat *
        ((m : ℝ) *
          (((n : ℝ) *
              ((n : ℝ) *
                storedQRCompactStepNormBudgetCoeffBudget hmn fp A_hat alpha +
                storedQRCompactStepNormBudgetCoeffBudget hmn fp A_hat alpha)) *
            storedQRPivotColumnNormBudget hmn A_hat) ^ 2) <
      1 := by
  let Fcap : ℝ :=
    Ucap * (1 + Gcap) * (1 + Ucap) +
      Ucap * (1 + Gcap) +

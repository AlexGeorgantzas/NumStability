      householderCompactNormBudgetCoeffFactor_le_of_u_cap_gamma_cap
        fp m Ucap Gcap hUcap_nonneg hu huCap hGcap
  have hFcap_nonneg : 0 ≤ Fcap :=
    le_trans (householderCompactNormBudgetCoeffFactor_nonneg fp m hm) hF
  exact
    storedQRCompactNormBudgetCoeffSmallness_of_pointwise_source_den_ne_zero_cap_bounds
      hmn fp A_hat alpha Dcap Ncap Ucap Fcap hm hDD
      hDcap_nonneg hNcap_nonneg hUcap_nonneg hFcap_nonneg
      hD hden hN hu hF (by simpa [Fcap] using hsmall)
/-- Source-denominator coefficient route with the rational gamma cap chosen
    explicitly from the unit-roundoff cap.

    Compared with
    `storedQRCompactNormBudgetCoeffSmallness_of_pointwise_source_den_ne_zero_uGammaCapBounds`,
    this theorem removes the separate `Gcap` parameter and rational-domination

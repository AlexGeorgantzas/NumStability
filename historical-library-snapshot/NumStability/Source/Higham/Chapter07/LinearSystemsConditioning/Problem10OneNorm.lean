    (hsubT : ∀ i : Fin n,
      ρ * y i ≤
        matMulVec n
          (matMul n (matTranspose (absMatrix n A))
            (matTranspose (absMatrix n A_inv))) y i)
    (d₁ d₁Inv d₂ d₂Inv : Fin n → ℝ)
    (hd₁pos : ∀ i : Fin n, 0 < d₁ i)
    (hd₁Invpos : ∀ i : Fin n, 0 < d₁Inv i)
    (hd₂pos : ∀ i : Fin n, 0 < d₂ i)
    (hd₂Invpos : ∀ i : Fin n, 0 < d₂Inv i)
    (hd₁ : ∀ i : Fin n, d₁ i * d₁Inv i = 1)
    (hd₂ : ∀ i : Fin n, d₂ i * d₂Inv i = 1) :
    ρ ≤ ch7TwoSidedScaledOneKappa A A_inv d₁ d₁Inv d₂ d₂Inv := by
  rw [ch7TwoSidedScaledOneKappa_eq_abs_scaledOneCond hn
    A A_inv d₁ d₁Inv d₂ d₂Inv
    (fun i => le_of_lt (hd₁pos i)) (fun i => le_of_lt (hd₁Invpos i))
    (fun i => le_of_lt (hd₂pos i)) (fun i => le_of_lt (hd₂Invpos i))]
  exact problem7_10e_scaled_oneCond_ge_perron_of_transpose_positive_subeigenvector
    hn (absMatrix n A) (absMatrix n A_inv) ρ y hρ hy hsubT
    d₁ d₁Inv d₂ d₂Inv
    hd₁pos hd₁Invpos hd₂pos hd₂Invpos hd₁ hd₂

/-- Problem 7.10(e), one-norm `κ₁` value-set lower bound from a positive
subeigenvector for `|A|ᵀ|A⁻¹|ᵀ`. -/
theorem problem7_10e_scaledOneKappaSet_sInf_ge_perron_of_abs_inverse_transpose_positive_subeigenvector
    {n : ℕ} (hn : 0 < n)
    (A A_inv : Fin n → Fin n → ℝ) (ρ : ℝ) (y : Fin n → ℝ)
    (hρ : 0 ≤ ρ)
    (hy : ∀ i : Fin n, 0 < y i)
    (hsubT : ∀ i : Fin n,
      ρ * y i ≤
        matMulVec n
          (matMul n (matTranspose (absMatrix n A))
            (matTranspose (absMatrix n A_inv))) y i) :
    ρ ≤ sInf (ch7TwoSidedScaledOneKappaSet A A_inv) := by
  let S : Set ℝ := ch7TwoSidedScaledOneKappaSet A A_inv
  have hS_nonempty : S.Nonempty := by
    simpa [S] using ch7TwoSidedScaledOneKappaSet_nonempty A A_inv
  have hlower : ∀ κ : ℝ, κ ∈ S → ρ ≤ κ := by
    intro κ hκ
    rcases hκ with
      ⟨d₁, d₁Inv, d₂, d₂Inv, hd₁pos, hd₁Invpos,
        hd₂pos, hd₂Invpos, hd₁, hd₂, rfl⟩
    exact
      problem7_10e_scaled_oneKappa_ge_perron_of_abs_inverse_transpose_positive_subeigenvector
        hn A A_inv ρ y hρ hy hsubT d₁ d₁Inv d₂ d₂Inv
        hd₁pos hd₁Invpos hd₂pos hd₂Invpos hd₁ hd₂
  exact le_csInf hS_nonempty hlower

/-- Problem 7.10(e), canonical one-norm two-sided scaling for
`B = |A|`, `C = |A⁻¹|`, under an explicit positive Perron-vector certificate
for `|A|ᵀ|A⁻¹|ᵀ`. -/
theorem problem7_10e_canonical_scaled_oneKappa_eq_perron_of_abs_inverse_transpose_positive_eigenvector
    {n : ℕ} (hn : 0 < n)
    (A A_inv : Fin n → Fin n → ℝ) (ρ : ℝ) (y : Fin n → ℝ)
    (hy : ∀ i : Fin n, 0 < y i)
    (hCt_y : ∀ i : Fin n, 0 < matMulVec n (matTranspose (absMatrix n A_inv)) y i)
    (heigT : ∀ i : Fin n,
      matMulVec n
          (matMul n (matTranspose (absMatrix n A))
            (matTranspose (absMatrix n A_inv))) y i = ρ * y i) :
    ch7TwoSidedScaledOneKappa A A_inv
        (fun i => matMulVec n (matTranspose (absMatrix n A_inv)) y i)
        (fun i => (matMulVec n (matTranspose (absMatrix n A_inv)) y i)⁻¹)
        (fun i => (y i)⁻¹) y = ρ := by
  rw [ch7TwoSidedScaledOneKappa_eq_abs_scaledOneCond hn A A_inv
    (fun i => matMulVec n (matTranspose (absMatrix n A_inv)) y i)
    (fun i => (matMulVec n (matTranspose (absMatrix n A_inv)) y i)⁻¹)
    (fun i => (y i)⁻¹) y
    (fun i => le_of_lt (hCt_y i))
    (fun i => inv_nonneg.mpr (le_of_lt (hCt_y i)))
    (fun i => inv_nonneg.mpr (le_of_lt (hy i)))
    (fun i => le_of_lt (hy i))]
  exact problem7_10e_canonical_scaled_oneCond_eq_perron_of_transpose_positive_eigenvector
    hn (absMatrix n A) (absMatrix n A_inv) ρ y
    (by intro i j; exact abs_nonneg _)
    (by intro i j; exact abs_nonneg _)
    hy hCt_y heigT

/-- Problem 7.10(e), positive-entry wrapper for the one-norm canonical
`B = |A|`, `C = |A⁻¹|` scaling.  Perron-Frobenius existence and
spectral-radius identification remain separate source-facing targets. -/
theorem problem7_10e_positive_abs_entries_canonical_scaled_oneKappa_eq_perron_of_transpose
    {n : ℕ} (hn : 0 < n)
    (A A_inv : Fin n → Fin n → ℝ) (ρ : ℝ) (y : Fin n → ℝ)
    (hApos : ∀ i j : Fin n, 0 < absMatrix n A i j)
    (hAinvpos : ∀ i j : Fin n, 0 < absMatrix n A_inv i j)
    (hy : ∀ i : Fin n, 0 < y i)
    (heigT : ∀ i : Fin n,
      matMulVec n
          (matMul n (matTranspose (absMatrix n A))
            (matTranspose (absMatrix n A_inv))) y i = ρ * y i) :
    ch7TwoSidedScaledOneKappa A A_inv
        (fun i => matMulVec n (matTranspose (absMatrix n A_inv)) y i)
        (fun i => (matMulVec n (matTranspose (absMatrix n A_inv)) y i)⁻¹)
        (fun i => (y i)⁻¹) y = ρ := by
  rw [ch7TwoSidedScaledOneKappa_eq_abs_scaledOneCond hn A A_inv
    (fun i => matMulVec n (matTranspose (absMatrix n A_inv)) y i)
    (fun i => (matMulVec n (matTranspose (absMatrix n A_inv)) y i)⁻¹)
    (fun i => (y i)⁻¹) y
    (fun i => le_of_lt (ch7_bauer_Cx_pos_of_pos hn
      (matTranspose (absMatrix n A_inv)) y (fun i j => hAinvpos j i) hy i))
    (fun i => inv_nonneg.mpr (le_of_lt (ch7_bauer_Cx_pos_of_pos hn
      (matTranspose (absMatrix n A_inv)) y (fun i j => hAinvpos j i) hy i)))
    (fun i => inv_nonneg.mpr (le_of_lt (hy i)))
    (fun i => le_of_lt (hy i))]
  exact problem7_10e_positive_entries_canonical_scaled_oneCond_eq_perron_of_transpose
    hn (absMatrix n A) (absMatrix n A_inv) ρ y hApos hAinvpos hy heigT

/-- Problem 7.10(e), source-shaped one-norm condition-product infimum under an
explicit positive Perron-vector certificate for `|A|ᵀ|A⁻¹|ᵀ`. -/
theorem problem7_10e_scaledOneKappaSet_sInf_eq_perron_of_abs_inverse_transpose_positive_eigenvector
    {n : ℕ} (hn : 0 < n)
    (A A_inv : Fin n → Fin n → ℝ) (ρ : ℝ) (y : Fin n → ℝ)
    (hy : ∀ i : Fin n, 0 < y i)
    (hCt_y : ∀ i : Fin n, 0 < matMulVec n (matTranspose (absMatrix n A_inv)) y i)
    (heigT : ∀ i : Fin n,
      matMulVec n
          (matMul n (matTranspose (absMatrix n A))
            (matTranspose (absMatrix n A_inv))) y i = ρ * y i) :
    sInf (ch7TwoSidedScaledOneKappaSet A A_inv) = ρ := by
  let S : Set ℝ := ch7TwoSidedScaledOneKappaSet A A_inv
  have hS_nonempty : S.Nonempty := by
    simpa [S] using ch7TwoSidedScaledOneKappaSet_nonempty A A_inv
  have hS_bdd : BddBelow S := by
    simpa [S] using ch7TwoSidedScaledOneKappaSet_bddBelow A A_inv
  have hlower : ∀ κ : ℝ, κ ∈ S → ρ ≤ κ := by
    intro κ hκ
    rcases hκ with
      ⟨d₁, d₁Inv, d₂, d₂Inv, hd₁pos, hd₁Invpos,
        hd₂pos, hd₂Invpos, hd₁, hd₂, rfl⟩
    exact
      problem7_10e_scaled_oneKappa_ge_perron_of_abs_inverse_transpose_positive_eigenvector
        hn A A_inv ρ y hy heigT d₁ d₁Inv d₂ d₂Inv
        hd₁pos hd₁Invpos hd₂pos hd₂Invpos hd₁ hd₂
  have hle_sInf : ρ ≤ sInf S := le_csInf hS_nonempty hlower
  let d₁ : Fin n → ℝ :=
    fun i => matMulVec n (matTranspose (absMatrix n A_inv)) y i
  let d₁Inv : Fin n → ℝ :=
    fun i => (matMulVec n (matTranspose (absMatrix n A_inv)) y i)⁻¹
  let d₂ : Fin n → ℝ := fun i => (y i)⁻¹
  let d₂Inv : Fin n → ℝ := y
  have hcan :
      ch7TwoSidedScaledOneKappa A A_inv d₁ d₁Inv d₂ d₂Inv = ρ := by
    dsimp [d₁, d₁Inv, d₂, d₂Inv]
    exact
      problem7_10e_canonical_scaled_oneKappa_eq_perron_of_abs_inverse_transpose_positive_eigenvector
        hn A A_inv ρ y hy hCt_y heigT
  have hmem :
      ch7TwoSidedScaledOneKappa A A_inv d₁ d₁Inv d₂ d₂Inv ∈ S := by
    dsimp [S, d₁, d₁Inv, d₂, d₂Inv]
    exact ch7TwoSidedScaledOneKappa_mem_set A A_inv
      (fun i => matMulVec n (matTranspose (absMatrix n A_inv)) y i)
      (fun i => (matMulVec n (matTranspose (absMatrix n A_inv)) y i)⁻¹)
      (fun i => (y i)⁻¹) y
      hCt_y
      (fun i => inv_pos.mpr (hCt_y i))
      (fun i => inv_pos.mpr (hy i))
      hy
      (fun i => mul_inv_cancel₀ (ne_of_gt (hCt_y i)))
      (fun i => inv_mul_cancel₀ (ne_of_gt (hy i)))
  have hρmem : ρ ∈ S := by
    simpa [hcan] using hmem
  have hsInf_le : sInf S ≤ ρ := csInf_le hS_bdd hρmem
  exact le_antisymm hsInf_le hle_sInf

/-- Problem 7.10(e), genuine minimum-attainment form for the positive
two-sided `κ₁` value set, under the same explicit transpose-side
Perron-vector certificate as the `sInf` wrapper. -/
theorem problem7_10e_scaledOneKappaSet_isLeast_perron_of_abs_inverse_transpose_positive_eigenvector
    {n : ℕ} (hn : 0 < n)
    (A A_inv : Fin n → Fin n → ℝ) (ρ : ℝ) (y : Fin n → ℝ)
    (hy : ∀ i : Fin n, 0 < y i)

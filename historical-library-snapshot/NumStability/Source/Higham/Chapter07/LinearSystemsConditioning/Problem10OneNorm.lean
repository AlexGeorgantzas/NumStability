theorem problem7_10e_irreducible_transpose_products_canonical_scaled_oneCond_eq_perron_of_nonzero_nonneg_eigenvector
    {n : ℕ} (hn : 0 < n)
    (B C : Fin n → Fin n → ℝ) (ρ : ℝ) (y : Fin n → ℝ)

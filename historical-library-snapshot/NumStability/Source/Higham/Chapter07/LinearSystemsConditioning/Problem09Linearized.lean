/-- Radius-feasible first-order normwise scalar-output values for Problem 7.9.
The matrix perturbation constraint uses the repository's `opNorm2Le` interface. -/
def Ch7Problem79NormwiseLinearizedRadiusSet
    (n : ℕ)
    (A_inv : Fin n → Fin n → ℝ) (E_norm f_norm : ℝ)
    (c x : Fin n → ℝ) (rho : ℝ) : Set ℝ :=
  { q | ∃ ε : ℝ, ∃ ΔA : Fin n → Fin n → ℝ, ∃ Δb : Fin n → ℝ,
      0 < ε ∧
      ε ≤ rho ∧
      opNorm2Le ΔA (ε * E_norm) ∧
      vecNorm2 Δb ≤ ε * f_norm ∧
      q = ch7Problem79LinearizedRelativeChange n A_inv c x Δb ΔA / ε }


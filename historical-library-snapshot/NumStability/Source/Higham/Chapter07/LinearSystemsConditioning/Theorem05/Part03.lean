/-- Euclidean norm of rectangular row `i`, the `p = 2` row-scaling analogue
of Higham's source notation `‖A(i,:)‖₂` in equation `(7.19)`. -/
noncomputable def ch7RectRowNorm2 {m n : ℕ}
    (A : Fin m → Fin n → ℝ) (i : Fin m) : ℝ :=
  vecNorm2 (fun j : Fin n => A i j)

/-- The row-equilibrating reciprocal scale for the Euclidean operator norm:
`d_i = 1 / ‖A(i,:)‖₂`. -/
noncomputable def ch7RowEquilibratingScale2Rect {m n : ℕ}
    (A : Fin m → Fin n → ℝ) (i : Fin m) : ℝ :=
  1 / ch7RectRowNorm2 A i

lemma ch7RectRowNorm2_nonneg {m n : ℕ}
    (A : Fin m → Fin n → ℝ) (i : Fin m) :

        (fun j : Fin n => ch7RectColumnLpNormOfReal p A j) ≤
      (n : ℝ) ^ (1 - p⁻¹) * μ := by
  exact theorem7_5_lp_column_equilibration_le_card_rpow_min_right_scalings

    (ch7_bauer_Cx_pos_of_pos hn (absMatrix n A_inv) x hAinvpos hx) heig

/-- The positive-entry hypotheses in Problem 7.10(b) imply the irreducibility
hypotheses on `|A||A⁻¹|` and `|A⁻¹||A|` used in Theorem 7.8 / Problem 7.10(d). -/
theorem problem7_10b_positive_abs_entries_products_irreducible {n : ℕ}
    (hn : 0 < n)
    (A A_inv : Fin n → Fin n → ℝ)
    (hApos : ∀ i j : Fin n, 0 < absMatrix n A i j)
    (hAinvpos : ∀ i j : Fin n, 0 < absMatrix n A_inv i j) :
    Matrix.IsIrreducible
        (Matrix.of (matMul n (absMatrix n A) (absMatrix n A_inv)) :
          Matrix (Fin n) (Fin n) ℝ) ∧
      Matrix.IsIrreducible
        (Matrix.of (matMul n (absMatrix n A_inv) (absMatrix n A)) :
          Matrix (Fin n) (Fin n) ℝ) :=
  ch7_bauer_positive_products_irreducible hn
    (absMatrix n A) (absMatrix n A_inv) hApos hAinvpos


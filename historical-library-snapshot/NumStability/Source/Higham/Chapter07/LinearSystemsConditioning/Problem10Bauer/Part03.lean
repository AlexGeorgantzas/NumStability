    {n : ℕ} (hn : 0 < n)
    (A A_inv : Fin n → Fin n → ℝ) (ρ : ℝ) (x : Fin n → ℝ)
    (hBC : Matrix.IsIrreducible
      (Matrix.of (matMul n (absMatrix n A) (absMatrix n A_inv)) :
        Matrix (Fin n) (Fin n) ℝ))
    (hCB : Matrix.IsIrreducible
      (Matrix.of (matMul n (absMatrix n A_inv) (absMatrix n A)) :
        Matrix (Fin n) (Fin n) ℝ))
    (hx_nonneg : ∀ i : Fin n, 0 ≤ x i)
    (hx_ne : x ≠ 0)
    (heig : ∀ i : Fin n,
      matMulVec n (matMul n (absMatrix n A) (absMatrix n A_inv)) x i =
        ρ * x i) :
    IsLeast (ch7TwoSidedScaledInfKappaSet A A_inv) ρ := by
  have hx : ∀ i : Fin n, 0 < x i :=
    ch7_nonzero_nonneg_irreducible_right_eigenvector_pos
      (matMul n (absMatrix n A) (absMatrix n A_inv)) ρ x
      hBC hx_nonneg hx_ne heig
  exact problem7_10b_irreducible_products_scaledInfKappaSet_isLeast_perron
    hn A A_inv ρ x hBC hCB hx heig

/-- Problem 7.10(b), positive-entry `sInf` wrapper for
`min κ∞(D₁AD₂) = ρ(|A||A⁻¹|)` at the strength of an explicit positive
Perron-vector certificate. -/
theorem problem7_10b_positive_abs_entries_scaledInfKappaSet_sInf_eq_perron
    {n : ℕ} (hn : 0 < n)
    (A A_inv : Fin n → Fin n → ℝ) (ρ : ℝ) (x : Fin n → ℝ)
    (_hApos : ∀ i j : Fin n, 0 < absMatrix n A i j)
    (hAinvpos : ∀ i j : Fin n, 0 < absMatrix n A_inv i j)
    (hx : ∀ i : Fin n, 0 < x i)
    (heig : ∀ i : Fin n,
      matMulVec n (matMul n (absMatrix n A) (absMatrix n A_inv)) x i =
        ρ * x i) :
    sInf (ch7TwoSidedScaledInfKappaSet A A_inv) = ρ :=
  problem7_10b_scaledInfKappaSet_sInf_eq_perron_of_abs_inverse_positive_eigenvector
    hn A A_inv ρ x hx
    (ch7_bauer_Cx_pos_of_pos hn (absMatrix n A_inv) x hAinvpos hx)
    heig

/-- Problem 7.10(b), positive-entry minimum-attainment wrapper for
`B = |A|`, `C = |A⁻¹|`, under an explicit positive Perron-vector certificate. -/
theorem problem7_10b_positive_abs_entries_scaledInfKappaSet_isLeast_perron
    {n : ℕ} (hn : 0 < n)
    (A A_inv : Fin n → Fin n → ℝ) (ρ : ℝ) (x : Fin n → ℝ)
    (_hApos : ∀ i j : Fin n, 0 < absMatrix n A i j)
    (hAinvpos : ∀ i j : Fin n, 0 < absMatrix n A_inv i j)
    (hx : ∀ i : Fin n, 0 < x i)
    (heig : ∀ i : Fin n,
      matMulVec n (matMul n (absMatrix n A) (absMatrix n A_inv)) x i =
        ρ * x i) :

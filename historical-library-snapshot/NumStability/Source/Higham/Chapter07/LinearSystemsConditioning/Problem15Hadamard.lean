    IsLeast (ch7TwoSidedScaledOp2KappaSet A A_inv)
      (complexMatrixOp2
        (realRectToCMatrix (ch7HadamardProduct A (matTranspose A_inv)))) := by
  constructor
  · exact hmem
  · intro κ hκ
    exact problem7_15_hadamard_op2_le_twoSidedScaledOp2Kappa_mem A A_inv hκ


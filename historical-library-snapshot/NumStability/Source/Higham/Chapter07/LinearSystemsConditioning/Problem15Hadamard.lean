    IsLeast (ch7TwoSidedScaledOp2KappaSet A A_inv)
      (complexMatrixOp2
        (realRectToCMatrix (ch7HadamardProduct A (matTranspose A_inv)))) := by
  apply problem7_15_twoSidedScaledOp2Kappa_isLeast_hadamard_op2_of_mem
  refine ⟨d₁, d₁Inv, d₂, d₂Inv,
    hd₁pos, hd₁Invpos, hd₂pos, hd₂Invpos, hd₁, hd₂, ?_⟩
  exact hattain.symm

/-- A nonempty real orthogonal matrix has exact complexified Euclidean
operator-2 norm equal to one.  This local bridge turns the sign-diagonal
matrices used in Problem 7.15's diagonal attainability case into exact
`complexMatrixOp2` values. -/
lemma problem7_15_complexMatrixOp2_realRectToCMatrix_orthogonal_eq_one {n : ℕ}
    (hn : 0 < n) {U : Fin n → Fin n → ℝ} (hU : IsOrthogonal n U) :
    complexMatrixOp2 (realRectToCMatrix U) = 1 := by
  apply le_antisymm
  · exact complexMatrixOp2_realRectToCMatrix_le_of_opNorm2Le U (by norm_num)
      hU.opNorm2Le_one
  · let j : Fin n := ⟨0, hn⟩
    have hcert :=
      opNorm2Le_complexMatrixOp2_realRectToCMatrix U (finiteBasisVec j)
    have hmat : vecNorm2 (matMulVec n U (finiteBasisVec j)) = 1 := by
      rw [vecNorm2_orthogonal U (finiteBasisVec j) hU]
      exact ch7Problem79_vecNorm2_finiteBasisVec j
    have hbasis : vecNorm2 (finiteBasisVec j) = 1 :=
      ch7Problem79_vecNorm2_finiteBasisVec j
    simpa [hmat, hbasis] using hcert

lemma problem7_15_ch7TwoSidedScale_diagMatrix_eq {n : ℕ}
    (dL a dR : Fin n → ℝ) :
    ch7TwoSidedScale dL (diagMatrix a) dR =
      diagMatrix (fun i : Fin n => dL i * a i * dR i) := by
  ext i j
  by_cases hij : i = j
  · subst j
    simp [ch7TwoSidedScale, diagMatrix]
  · simp [ch7TwoSidedScale, diagMatrix, hij]

lemma problem7_15_hadamard_diag_inverse_transpose_eq_idMatrix {n : ℕ}
    (a : Fin n → ℝ) (ha : ∀ i : Fin n, a i ≠ 0) :
    ch7HadamardProduct (diagMatrix a)
        (matTranspose (diagMatrix (fun i : Fin n => (a i)⁻¹))) =
      idMatrix n := by
  ext i j
  by_cases hij : i = j
  · subst j
    simp [ch7HadamardProduct, matTranspose, diagMatrix, idMatrix, ha]
  · have hji : j ≠ i := fun h => hij h.symm
    simp [ch7HadamardProduct, matTranspose, diagMatrix, idMatrix, hij, hji]

lemma problem7_15_abs_inv_mul_sq_eq_one {x : ℝ} (hx : x ≠ 0) :
    (|x|⁻¹ * x) ^ 2 = 1 := by
  have habs : |x| ≠ 0 := abs_ne_zero.mpr hx
  field_simp [habs]
  rw [sq_abs]

lemma problem7_15_inv_mul_abs_sq_eq_one {x : ℝ} (hx : x ≠ 0) :
    (x⁻¹ * |x|) ^ 2 = 1 := by
  field_simp [hx]
  rw [sq_abs]

/-- Problem 7.15 diagonal attainability side condition: if `A` is a
nonsingular diagonal matrix, then the source lower-bound matrix
`A ∘ A^{-T}` is the identity and has exact operator-2 norm one. -/
theorem problem7_15_diagonal_hadamard_op2_eq_one {n : ℕ}
    (hn : 0 < n) (a : Fin n → ℝ) (ha : ∀ i : Fin n, a i ≠ 0) :
    complexMatrixOp2
      (realRectToCMatrix
        (ch7HadamardProduct (diagMatrix a)
          (matTranspose (diagMatrix (fun i : Fin n => (a i)⁻¹))))) = 1 := by
  rw [problem7_15_hadamard_diag_inverse_transpose_eq_idMatrix a ha]
  exact problem7_15_complexMatrixOp2_realRectToCMatrix_orthogonal_eq_one hn
    (IsOrthogonal.id n)

lemma problem7_15_diagonal_attaining_scaling_eq_hadamard_op2 {n : ℕ}
    (hn : 0 < n) (a : Fin n → ℝ) (ha : ∀ i : Fin n, a i ≠ 0) :
    complexMatrixOp2
        (realRectToCMatrix
          (ch7TwoSidedScale (fun i : Fin n => |a i|⁻¹) (diagMatrix a)
            (fun _ : Fin n => (1 : ℝ)))) *
      complexMatrixOp2
        (realRectToCMatrix
          (ch7TwoSidedScale (fun _ : Fin n => (1 : ℝ))
            (diagMatrix (fun i : Fin n => (a i)⁻¹)) (fun i : Fin n => |a i|))) =
    complexMatrixOp2
      (realRectToCMatrix
        (ch7HadamardProduct (diagMatrix a)
          (matTranspose (diagMatrix (fun i : Fin n => (a i)⁻¹))))) := by
  have hscaled :
      ch7TwoSidedScale (fun i : Fin n => |a i|⁻¹) (diagMatrix a)
          (fun _ : Fin n => (1 : ℝ)) =
        diagMatrix (fun i : Fin n => |a i|⁻¹ * a i) := by
    simpa using
      problem7_15_ch7TwoSidedScale_diagMatrix_eq
        (fun i : Fin n => |a i|⁻¹) a (fun _ : Fin n => (1 : ℝ))
  have hinvScaled :
      ch7TwoSidedScale (fun _ : Fin n => (1 : ℝ))
          (diagMatrix (fun i : Fin n => (a i)⁻¹)) (fun i : Fin n => |a i|) =
        diagMatrix (fun i : Fin n => (a i)⁻¹ * |a i|) := by
    simpa using
      problem7_15_ch7TwoSidedScale_diagMatrix_eq
        (fun _ : Fin n => (1 : ℝ)) (fun i : Fin n => (a i)⁻¹)
        (fun i : Fin n => |a i|)
  have hOpScaled :
      complexMatrixOp2
        (realRectToCMatrix
          (ch7TwoSidedScale (fun i : Fin n => |a i|⁻¹) (diagMatrix a)
            (fun _ : Fin n => (1 : ℝ)))) = 1 := by
    rw [hscaled]
    exact problem7_15_complexMatrixOp2_realRectToCMatrix_orthogonal_eq_one hn
      (IsOrthogonal.diagMatrix_of_sq_eq_one
        (fun i : Fin n => |a i|⁻¹ * a i)
        (fun i => problem7_15_abs_inv_mul_sq_eq_one (ha i)))
  have hOpInvScaled :
      complexMatrixOp2
        (realRectToCMatrix
          (ch7TwoSidedScale (fun _ : Fin n => (1 : ℝ))
            (diagMatrix (fun i : Fin n => (a i)⁻¹)) (fun i : Fin n => |a i|))) =
        1 := by
    rw [hinvScaled]
    exact problem7_15_complexMatrixOp2_realRectToCMatrix_orthogonal_eq_one hn
      (IsOrthogonal.diagMatrix_of_sq_eq_one
        (fun i : Fin n => (a i)⁻¹ * |a i|)
        (fun i => problem7_15_inv_mul_abs_sq_eq_one (ha i)))
  have hHad := problem7_15_diagonal_hadamard_op2_eq_one hn a ha
  calc
    complexMatrixOp2
        (realRectToCMatrix
          (ch7TwoSidedScale (fun i : Fin n => |a i|⁻¹) (diagMatrix a)
            (fun _ : Fin n => (1 : ℝ)))) *
      complexMatrixOp2
        (realRectToCMatrix
          (ch7TwoSidedScale (fun _ : Fin n => (1 : ℝ))
            (diagMatrix (fun i : Fin n => (a i)⁻¹)) (fun i : Fin n => |a i|))) =
        1 := by
          rw [hOpScaled, hOpInvScaled]
          norm_num
    _ = complexMatrixOp2
      (realRectToCMatrix
        (ch7HadamardProduct (diagMatrix a)
          (matTranspose (diagMatrix (fun i : Fin n => (a i)⁻¹))))) := hHad.symm

/-- Appendix A.7.15 diagonal attainability case: for every nonsingular
diagonal `A = diag(a)`, the positive two-sided scaling
`D₁ = diag(|aᵢ|⁻¹)`, `D₂ = I` realizes equality in the Problem 7.15
operator-2 lower bound, so the infimum value is exactly one. -/
theorem problem7_15_diagonal_twoSidedScaledOp2Kappa_sInf_eq_one {n : ℕ}
    (hn : 0 < n) (a : Fin n → ℝ) (ha : ∀ i : Fin n, a i ≠ 0) :
    sInf (ch7TwoSidedScaledOp2KappaSet (diagMatrix a)
      (diagMatrix (fun i : Fin n => (a i)⁻¹))) = 1 := by
  have hHad := problem7_15_diagonal_hadamard_op2_eq_one hn a ha
  have hsInf :=
    problem7_15_twoSidedScaledOp2Kappa_sInf_eq_hadamard_op2_of_attaining_scaling
      (diagMatrix a) (diagMatrix (fun i : Fin n => (a i)⁻¹))
      (fun i : Fin n => |a i|⁻¹) (fun i : Fin n => |a i|)
      (fun _ : Fin n => (1 : ℝ)) (fun _ : Fin n => (1 : ℝ))
      (by intro i; exact inv_pos.mpr (abs_pos.mpr (ha i)))
      (by intro i; exact abs_pos.mpr (ha i))
      (by intro i; norm_num)
      (by intro i; norm_num)
      (by intro i; exact inv_mul_cancel₀ (abs_ne_zero.mpr (ha i)))
      (by intro i; norm_num)
      (problem7_15_diagonal_attaining_scaling_eq_hadamard_op2 hn a ha)
  simpa [hHad] using hsInf

/-- Appendix A.7.15 diagonal attainability as a least-value theorem: for a
nonsingular diagonal matrix, one is an actual least value of the positive
two-sided exact operator-2 condition-product set. -/
theorem problem7_15_diagonal_twoSidedScaledOp2Kappa_isLeast_one {n : ℕ}
    (hn : 0 < n) (a : Fin n → ℝ) (ha : ∀ i : Fin n, a i ≠ 0) :
    IsLeast (ch7TwoSidedScaledOp2KappaSet (diagMatrix a)
      (diagMatrix (fun i : Fin n => (a i)⁻¹))) 1 := by
  have hHad := problem7_15_diagonal_hadamard_op2_eq_one hn a ha
  have hisLeast :=
    problem7_15_twoSidedScaledOp2Kappa_isLeast_hadamard_op2_of_attaining_scaling
      (diagMatrix a) (diagMatrix (fun i : Fin n => (a i)⁻¹))
      (fun i : Fin n => |a i|⁻¹) (fun i : Fin n => |a i|)
      (fun _ : Fin n => (1 : ℝ)) (fun _ : Fin n => (1 : ℝ))
      (by intro i; exact inv_pos.mpr (abs_pos.mpr (ha i)))
      (by intro i; exact abs_pos.mpr (ha i))
      (by intro i; norm_num)
      (by intro i; norm_num)
      (by intro i; exact inv_mul_cancel₀ (abs_ne_zero.mpr (ha i)))
      (by intro i; norm_num)
      (problem7_15_diagonal_attaining_scaling_eq_hadamard_op2 hn a ha)
  simpa [hHad] using hisLeast


      calc
        Real.sqrt (n + k : ℝ) *
            householderQRRhsPanelSqrtGrowthCoeff fp (n + k) n ≤
          Real.sqrt (n + k : ℝ) * ((n : ℝ) * gammaTilde) :=
            mul_le_mul_of_nonneg_left hsqrtCoeff_le_n_tilde

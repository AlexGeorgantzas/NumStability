      (lsNormwiseBackwardErrorPhi theta r y) ^ 2 *
        vecNorm2Sq (matMulVec m (lsResidualComplementProjector r) p) := by
  let c : ℝ := ((∑ k : Fin m, p k * r k) + t) / vecNorm2Sq p
  let q : Fin m → ℝ :=
    fun i : Fin m =>
      c * p i - r i - ((1 / vecNorm2Sq p) * p i * t)

    rules out full row rank of the row-side complexified transpose. -/
theorem lsRealRectRowRank_ne_card_of_leftNull {m n : ℕ}
    (A : Fin (m + 1) → Fin n → ℝ) (v : Fin (m + 1) → ℝ)

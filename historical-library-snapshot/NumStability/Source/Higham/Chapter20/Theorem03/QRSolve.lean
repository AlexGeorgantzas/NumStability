    (habs : IsAbsoluteComplexVectorNorm ν)
    (A : Fin m → Fin n → ℝ)
    (DeltaA E : Fin m → Fin n → ℝ) (Deltab f b : Fin m → ℝ)
    (r s : Fin m → ℝ) (x y : Fin n → ℝ) (eps : ℝ)

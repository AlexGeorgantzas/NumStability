  exact
    lsAugmentedEq20_10_relative_bound_of_perturbed_systems_nonsing_gram
      ν hν habs A DeltaA E Deltab f b r s x y eps
      (rectLSGram_det_ne_zero_of_rectMatMulVec_injective A hA)

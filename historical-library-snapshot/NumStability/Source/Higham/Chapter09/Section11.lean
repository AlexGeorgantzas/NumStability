            (show Matrix (Fin n) (Fin n) ℝ from rectMatMul LhatInv ΔL)) *
          ((1 : Matrix (Fin n) (Fin n) ℝ) -
            (show Matrix (Fin n) (Fin n) ℝ from rectMatMul ΔU UhatInv)))

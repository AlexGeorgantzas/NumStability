    (A : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ) :
    Real.sqrt (2 * frobNormSqRect A) ≤ 2 * frobNormRect A := by
  have hsqrt_two_le_two : Real.sqrt (2 : ℝ) ≤ 2 := by

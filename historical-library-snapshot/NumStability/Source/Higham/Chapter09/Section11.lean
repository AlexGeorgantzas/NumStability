theorem higham9_15_normalized_Gtilde_frobNorm_ratio_bound_of_linear_step {n : ℕ}
    (Gtilde X Y : Matrix (Fin n) (Fin n) ℝ)
    (hGlt : opNorm2 Gtilde < 1)
    (hlinear :

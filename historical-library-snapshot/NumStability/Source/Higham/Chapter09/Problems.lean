    higham9_1_lu_unique_of_pivots_ne_zero hLU hLU₀
      (hLU.det_ne_zero_iff_U_diag_ne_zero.mp hdetA)
  constructor
  · intro i j
    rw [hsame.1]
    exact hL₀_nn i j
  · intro i j
    rw [hsame.2]
    exact hU₀_nn i j


  higham9_6_growthFactorEntry_and_noPivotReducedGrowthFactor_le_one_of_totalNonnegative_and_principalBlock_inequalities
    hn A hTN (higham9_6_totalNonnegative_det_pos_of_det_ne_zero hTN hdetA)

/-- **Theorem 9.11 support**, generic max-entry growth-factor lower bound
from a single witnessed `U` entry. -/
theorem growthFactorEntry_ge_of_entry_ge {n : ℕ} (hn : 0 < n)
    (A U : Fin n → Fin n → ℝ) (hA : 0 < maxEntryNorm hn A)
    (i j : Fin n) (c : ℝ)
    (h : c * maxEntryNorm hn A ≤ |U i j|) :
    c ≤ growthFactorEntry hn A U hA := by
  unfold growthFactorEntry
  rw [le_div_iff₀ hA]
  exact le_trans h (entry_le_maxEntryNorm hn U i j)


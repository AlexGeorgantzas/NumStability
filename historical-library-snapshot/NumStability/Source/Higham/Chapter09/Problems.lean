/-- **Higham eq. (9.16) / Foster [435, 1997], Theorems 1 and 3**: the growth
factor of GE with rook pivoting is at most `(3/2)·n^{(3/4)·ln n}`. -/
theorem higham9_16_RookPivotGEUTrace_growthFactorEntry_le_fosterBound
    {n : ℕ} (hn : 0 < n) (A U : Fin n → Fin n → ℝ)
    (hAmax : 0 < maxEntryNorm hn A)
    (htrace : higham9_16_RookPivotGEUTrace n A U) :
    growthFactorEntry hn A U hAmax ≤ higham9_16_rookPivotFosterBound n := by
  rw [higham9_16_rookPivotFosterBound_eq_three_halves_mul_exp_log_sq hn]

  exact
    higham9_5_wilkinson_source_bound_of_entry_growth fp n hn_pos
      A L_hat U_hat b 2 hAmax (by norm_num) hgrowth hL_diag hU_diag
      (higham9_LUFactSpec_to_LUBackwardError_gamma fp n hn hLU)
      hn hn3 hL_bound


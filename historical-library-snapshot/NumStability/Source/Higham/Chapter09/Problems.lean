      0 < maxEntryNorm hn_pos (higham9_2_rowPermutedMatrix A sigma) := by
    simpa [higham9_2_rowPermutedMatrix_maxEntryNorm hn_pos A hLU.perm] using hAmax
  have htrace_growth :

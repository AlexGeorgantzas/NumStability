/-- Higham, 2nd ed., Chapter 11, Theorem 11.8 product-size dependency,
off-diagonal inverse-scale form: if the exact Aasen outer factor satisfies the
source-style inverse cap away from the unit diagonal, then the unscaled
outer-factor norm caps follow. -/
theorem higham11_8_outer_factor_caps_of_AasenSpec_offdiag_inverse_entry_bound
    (n : ℕ) (hn : 1 < n)
    (A L T : Fin n → Fin n → ℝ) (σ : Fin n → Fin n) (γ : ℝ)
    (hγ : 0 ≤ γ)
    (hspec : higham11_8_AasenSpec n A L T σ)
    (hoffdiag : ∀ i j : Fin n, i ≠ j → |L i j| ≤ 1 / (1 + γ)) :
    infNorm L ≤ ((n - 1 : ℕ) : ℝ) ∧
      infNorm (fun r c => L c r) ≤ ((n - 1 : ℕ) : ℝ) :=
  higham11_8_outer_factor_caps_of_AasenSpec_offdiag_entry_bound_le_one
    n hn A L T σ (1 / (1 + γ))
    (by

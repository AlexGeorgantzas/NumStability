theorem higham11_8_one_plus_two_gamma_plus_sq_mul_gamma_le_gamma_3n
    (fp : FPModel) (n : ℕ) (hval : gammaValid fp (3 * n)) :
    (1 + 2 * gamma fp n + (gamma fp n) ^ 2) * gamma fp n ≤
      gamma fp (3 * n) := by

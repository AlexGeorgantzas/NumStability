      (infNorm A) := by
  have hκ_printed : κ ≤ (4 : ℝ) ^ (n - 2) := by
    have hone : (1 : ℝ) ≤ 1 + γ := by linarith
    have hle : κ ≤ (1 + γ) * κ := by
      simpa [one_mul] using mul_le_mul_of_nonneg_right hone hκ_nonneg
    exact hle.trans hκ
  exact
    higham11_8_aasenSourceNormwiseBackwardBound_of_infNorm_T_hat_le_kappa_mul_infNorm
      n ΔA_inf γ15n25 κ T_hat A hγ15 hκ_printed hTcap hbound

/-- Three-entry row support converts max-entry control of an Aasen middle
factor into the corresponding `∞`-norm control with the sharp row-support
loss.  This isolates the tridiagonal support obligation from the scalar
growth-factor algebra. -/
theorem higham11_8_infNorm_le_three_mul_maxEntryNorm_of_rowSupport_card_le_three
    (n : ℕ) (hn : 0 < n) (T : Fin n → Fin n → ℝ)
    (hrows : ∀ i : Fin n, ∃ s : Finset (Fin n),
      s.card ≤ 3 ∧ ∀ j : Fin n, j ∉ s → T i j = 0) :
    infNorm T ≤ (3 : ℝ) * maxEntryNorm hn T := by
  apply infNorm_le_of_row_sum_le
  · intro i
    rcases hrows i with ⟨s, hcard, hzero⟩
    have hsum_subset :
        ∑ j : Fin n, |T i j| = ∑ j ∈ s, |T i j| := by
      exact
        (Finset.sum_subset (Finset.subset_univ s) (fun j _ hjnot => by
          rw [hzero j hjnot, abs_zero])).symm
    calc
      ∑ j : Fin n, |T i j| = ∑ j ∈ s, |T i j| := hsum_subset
      _ ≤ ∑ j ∈ s, maxEntryNorm hn T := by
            apply Finset.sum_le_sum
            intro j _
            exact entry_le_maxEntryNorm hn T i j
      _ = (s.card : ℝ) * maxEntryNorm hn T := by
            simp [Finset.sum_const, nsmul_eq_mul]
      _ ≤ (3 : ℝ) * maxEntryNorm hn T := by
            have hcard_real : (s.card : ℝ) ≤ 3 := by
              exact_mod_cast hcard
            exact mul_le_mul_of_nonneg_right hcard_real (maxEntryNorm_nonneg hn T)
  · exact mul_nonneg (by norm_num : (0 : ℝ) ≤ 3) (maxEntryNorm_nonneg hn T)

/-- A tridiagonal row has at most three possible nonzero entries.  This
packages the local `IsTridiagonal` zero structure into the row-support
certificate used by the sharp Aasen source-norm transport. -/
theorem higham11_8_rowSupport_card_le_three_of_isTridiagonal
    (n : ℕ) (T : Fin n → Fin n → ℝ) (hT : IsTridiagonal n T) :
    ∀ i : Fin n, ∃ s : Finset (Fin n),
      s.card ≤ 3 ∧ ∀ j : Fin n, j ∉ s → T i j = 0 := by
  classical
  intro i
  let pred : Fin n :=
    if hp : 0 < i.val then ⟨i.val - 1, by omega⟩ else i
  let succ : Fin n :=
    if hs : i.val + 1 < n then ⟨i.val + 1, hs⟩ else i
  let s : Finset (Fin n) := insert pred (insert i ({succ} : Finset (Fin n)))
  refine ⟨s, ?_, ?_⟩
  · have hcard_isucc : (insert i ({succ} : Finset (Fin n))).card ≤ 2 := by
      calc
        (insert i ({succ} : Finset (Fin n))).card ≤
            ({succ} : Finset (Fin n)).card + 1 :=
          Finset.card_insert_le i ({succ} : Finset (Fin n))
        _ = 2 := by simp
    calc
      s.card ≤ (insert i ({succ} : Finset (Fin n))).card + 1 :=
        Finset.card_insert_le pred (insert i ({succ} : Finset (Fin n)))
      _ ≤ 2 + 1 := Nat.add_le_add_right hcard_isucc 1
      _ = 3 := by norm_num
  · intro j hjnot
    have hnot_pred : j ≠ pred := by
      intro hji
      exact hjnot (by simp [s, hji])
    have hnot_i : j ≠ i := by
      intro hji
      exact hjnot (by simp [s, hji])
    have hnot_succ : j ≠ succ := by
      intro hji
      exact hjnot (by simp [s, hji])
    apply hT i j
    by_cases hlt : j.val < i.val
    · by_cases hpred_val : j.val + 1 = i.val
      · have hp : 0 < i.val := by omega
        have hpred_eq : pred = ⟨i.val - 1, by omega⟩ := by
          simp [pred, hp]
        have hjpred : j = pred := by
          rw [hpred_eq]
          apply Fin.ext
          change j.val = i.val - 1
          omega
        exact (hnot_pred hjpred).elim
      · right
        omega
    · have hige : i.val ≤ j.val := Nat.le_of_not_gt hlt
      by_cases heq : j.val = i.val
      · have hji : j = i := by
          ext
          omega
        exact (hnot_i hji).elim
      · by_cases hsucc_val : i.val + 1 = j.val
        · have hs : i.val + 1 < n := by omega
          have hsucc_eq : succ = ⟨i.val + 1, hs⟩ := by
            simp [succ, hs]
          have hjsucc : j = succ := by
            rw [hsucc_eq]
            apply Fin.ext
            change j.val = i.val + 1
            simp [hsucc_val]
          exact (hnot_succ hjsucc).elim
        · left
          omega

/-- Tridiagonal structure gives the sharp three-entry conversion from
max-entry control to the `∞` norm for an Aasen middle factor. -/
theorem higham11_8_infNorm_le_three_mul_maxEntryNorm_of_isTridiagonal
    (n : ℕ) (hn : 0 < n) (T : Fin n → Fin n → ℝ)
    (hT : IsTridiagonal n T) :
    infNorm T ≤ (3 : ℝ) * maxEntryNorm hn T :=
  higham11_8_infNorm_le_three_mul_maxEntryNorm_of_rowSupport_card_le_three
    n hn T (higham11_8_rowSupport_card_le_three_of_isTridiagonal n T hT)

/-- Max-entry computed-middle cap transport with explicit norm-conversion
loss: if `‖T_hat‖_max ≤ κ‖A‖_max` and `nκ` fits inside the printed growth
factor, then the existing `‖T_hat‖∞` Aasen bound has the source `‖A‖∞` form. -/
theorem higham11_8_aasenSourceNormwiseBackwardBound_of_maxEntryNorm_T_hat_le_kappa_mul_maxEntryNorm
    (n : ℕ) (hn : 0 < n) (ΔA_inf γ15n25 κ : ℝ)
    (T_hat A : Fin n → Fin n → ℝ)
    (hγ : 0 ≤ γ15n25)
    (hκ : (n : ℝ) * κ ≤ (4 : ℝ) ^ (n - 2))
    (hTcap : maxEntryNorm hn T_hat ≤ κ * maxEntryNorm hn A)
    (hbound :
      higham11_8_aasenNormwiseBackwardBound n ΔA_inf γ15n25
        (infNorm T_hat)) :
    higham11_8_aasenSourceNormwiseBackwardBound n ΔA_inf γ15n25
      (infNorm A) := by
  have hprinted :
      infNorm T_hat ≤ (4 : ℝ) ^ (n - 2) * infNorm A := by
    calc
      infNorm T_hat ≤ (n : ℝ) * maxEntryNorm hn T_hat :=
        infNorm_le_card_mul_maxEntryNorm hn T_hat
      _ ≤ (n : ℝ) * (κ * maxEntryNorm hn A) :=
        mul_le_mul_of_nonneg_left hTcap (Nat.cast_nonneg n)
      _ = ((n : ℝ) * κ) * maxEntryNorm hn A := by ring
      _ ≤ ((4 : ℝ) ^ (n - 2)) * maxEntryNorm hn A :=
        mul_le_mul_of_nonneg_right hκ (maxEntryNorm_nonneg hn A)
      _ ≤ ((4 : ℝ) ^ (n - 2)) * infNorm A :=
        mul_le_mul_of_nonneg_left (maxEntryNorm_le_infNorm hn A)
          (pow_nonneg (by norm_num : (0 : ℝ) ≤ 4) _)
  exact
    higham11_8_aasenSourceNormwiseBackwardBound_of_infNorm_T_hat_le_printed_mul_infNorm
      n ΔA_inf γ15n25 T_hat A hγ hbound hprinted

/-- Max-entry computed-middle transport for a middle factor whose rows have
support size at most three.  The scalar condition `3κ≤4^(n-2)` replaces the
generic dense-matrix loss `nκ≤4^(n-2)`. -/
theorem higham11_8_aasenSourceNormwiseBackwardBound_of_rowSupport_maxEntryNorm_T_hat_le_kappa_mul_maxEntryNorm
    (n : ℕ) (hn : 0 < n) (ΔA_inf γ15n25 κ : ℝ)
    (T_hat A : Fin n → Fin n → ℝ)
    (hrows : ∀ i : Fin n, ∃ s : Finset (Fin n),
      s.card ≤ 3 ∧ ∀ j : Fin n, j ∉ s → T_hat i j = 0)
    (hγ : 0 ≤ γ15n25)
    (hκ : (3 : ℝ) * κ ≤ (4 : ℝ) ^ (n - 2))
    (hTcap : maxEntryNorm hn T_hat ≤ κ * maxEntryNorm hn A)
    (hbound :
      higham11_8_aasenNormwiseBackwardBound n ΔA_inf γ15n25
        (infNorm T_hat)) :
    higham11_8_aasenSourceNormwiseBackwardBound n ΔA_inf γ15n25
      (infNorm A) := by
  have hprinted :
      infNorm T_hat ≤ (4 : ℝ) ^ (n - 2) * infNorm A := by
    calc
      infNorm T_hat ≤ (3 : ℝ) * maxEntryNorm hn T_hat :=
        higham11_8_infNorm_le_three_mul_maxEntryNorm_of_rowSupport_card_le_three
          n hn T_hat hrows
      _ ≤ (3 : ℝ) * (κ * maxEntryNorm hn A) :=
        mul_le_mul_of_nonneg_left hTcap (by norm_num : (0 : ℝ) ≤ 3)
      _ = ((3 : ℝ) * κ) * maxEntryNorm hn A := by ring
      _ ≤ ((4 : ℝ) ^ (n - 2)) * maxEntryNorm hn A :=
        mul_le_mul_of_nonneg_right hκ (maxEntryNorm_nonneg hn A)
      _ ≤ ((4 : ℝ) ^ (n - 2)) * infNorm A :=
        mul_le_mul_of_nonneg_left (maxEntryNorm_le_infNorm hn A)
          (pow_nonneg (by norm_num : (0 : ℝ) ≤ 4) _)
  exact
    higham11_8_aasenSourceNormwiseBackwardBound_of_infNorm_T_hat_le_printed_mul_infNorm
      n ΔA_inf γ15n25 T_hat A hγ hbound hprinted

/-- Tridiagonal max-entry computed-middle transport.  This is the same sharp

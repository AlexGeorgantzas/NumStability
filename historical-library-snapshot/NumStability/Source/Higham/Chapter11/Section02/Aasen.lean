/-- Aasen growth factor `rho_n = max_ij |t_ij| / max_ij |a_ij|`. -/
noncomputable def higham11_8_aasenGrowthFactor
    (Tmax Amax : ℝ) : ℝ :=
  Tmax / Amax

/-- The printed Aasen growth-factor bound `rho_n <= 4^(n-2)`. -/
def higham11_8_aasenGrowthBound (n : ℕ) (ρ_n : ℝ) : Prop :=
  ρ_n ≤ (4 : ℝ) ^ (n - 2)

/-- The printed Aasen growth-factor right-hand side is nonnegative. -/
theorem higham11_8_aasenGrowthBound_rhs_nonneg (n : ℕ) :
    0 ≤ (4 : ℝ) ^ (n - 2) :=
  pow_nonneg (by norm_num) _

/-- The Aasen growth factor is nonnegative when both numerator and source
max-entry scale are nonnegative. -/
theorem higham11_8_aasenGrowthFactor_nonneg (Tmax Amax : ℝ)
    (hT : 0 ≤ Tmax) (hA : 0 ≤ Amax) :
    0 ≤ higham11_8_aasenGrowthFactor Tmax Amax :=
  div_nonneg hT hA

/-- Multiplying the Aasen growth factor by a nonzero source scale recovers the
tridiagonal max-entry scale. -/
theorem higham11_8_aasenGrowthFactor_mul_Amax_eq (Tmax Amax : ℝ)
    (hA : Amax ≠ 0) :
    higham11_8_aasenGrowthFactor Tmax Amax * Amax = Tmax := by
  rw [higham11_8_aasenGrowthFactor, div_mul_cancel₀ _ hA]

/-- A concrete max-entry estimate for `T` gives the printed Aasen growth-bound
predicate after dividing by the positive source scale. -/
theorem higham11_8_aasenGrowthBound_of_Tmax_le_printed_mul_Amax
    (n : ℕ) (Tmax Amax : ℝ) (hA : 0 < Amax)
    (hT : Tmax ≤ (4 : ℝ) ^ (n - 2) * Amax) :
    higham11_8_aasenGrowthBound n
      (higham11_8_aasenGrowthFactor Tmax Amax) := by
  dsimp [higham11_8_aasenGrowthBound, higham11_8_aasenGrowthFactor]
  exact (div_le_iff₀ hA).mpr hT

/-- The printed Aasen growth-bound predicate can be returned to the equivalent
max-entry product form when the source scale is positive. -/
theorem higham11_8_Tmax_le_printed_mul_Amax_of_aasenGrowthBound
    (n : ℕ) (Tmax Amax : ℝ) (hA : 0 < Amax)
    (hbound :
      higham11_8_aasenGrowthBound n
        (higham11_8_aasenGrowthFactor Tmax Amax)) :
    Tmax ≤ (4 : ℝ) ^ (n - 2) * Amax := by
  have hmul :
      higham11_8_aasenGrowthFactor Tmax Amax * Amax ≤
        ((4 : ℝ) ^ (n - 2)) * Amax :=
    mul_le_mul_of_nonneg_right hbound (le_of_lt hA)
  rwa [higham11_8_aasenGrowthFactor_mul_Amax_eq Tmax Amax
    (ne_of_gt hA)] at hmul


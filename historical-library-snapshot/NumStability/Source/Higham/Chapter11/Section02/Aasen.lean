theorem higham11_8_aasenSourceNormwiseBackwardBound_of_isTridiagonal_maxEntryNorm_T_hat_le_kappa_mul_maxEntryNorm
    (n : ℕ) (hn : 0 < n) (ΔA_inf γ15n25 κ : ℝ)

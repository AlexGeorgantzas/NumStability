/-- A relative `T_hat - T` comparison plus a computed-middle source cap
`‖T_hat‖∞ ≤ κ‖A‖∞` feeds the printed Aasen growth-bound predicate whenever
`(1+γ)κ` is within the printed `4^(n-2)` growth factor. -/
theorem higham11_8_aasenGrowthBound_of_relative_T_hat_error_and_infNorm_T_hat_le_kappa_mul_infNorm
    (n : ℕ) (T T_hat A : Fin n → Fin n → ℝ) (γ κ : ℝ)
    (hγ : 0 ≤ γ) (hA : 0 < infNorm A)
    (hκ : (1 + γ) * κ ≤ (4 : ℝ) ^ (n - 2))
    (hThat : ∀ i j : Fin n, |T_hat i j - T i j| ≤ γ * |T_hat i j|)
    (hTcap : infNorm T_hat ≤ κ * infNorm A) :
    higham11_8_aasenGrowthBound n
      (higham11_8_aasenGrowthFactor (infNorm T) (infNorm A)) := by
  have hscale_nonneg : 0 ≤ 1 + γ := by linarith
  have hscaled :
      (1 + γ) * infNorm T_hat ≤
        (4 : ℝ) ^ (n - 2) * infNorm A := by
    calc
      (1 + γ) * infNorm T_hat ≤ (1 + γ) * (κ * infNorm A) :=
        mul_le_mul_of_nonneg_left hTcap hscale_nonneg
      _ = ((1 + γ) * κ) * infNorm A := by ring
      _ ≤ (4 : ℝ) ^ (n - 2) * infNorm A :=
        mul_le_mul_of_nonneg_right hκ (le_of_lt hA)
  exact
    higham11_8_aasenGrowthBound_of_relative_T_hat_error_and_one_plus_infNorm_T_hat_le_printed_mul_infNorm
      n T T_hat A γ hγ hA hThat hscaled


      (2 * γn + γn ^ 2) * f3γ ≤ γ2n * γ12n :=
    mul_le_mul h2 hf3 hf3_nonneg hγ2n
  have hpoly :
      (1 + 2 * γn + γn ^ 2) * f3γ ≤ γ12n + γ2n + γ12n * γ2n := by
    nlinarith
  have h14 :
      γ12n + γ2n + γ12n * γ2n ≤ gamma fp (14 * n) := by
    have hsum :
        gamma fp (12 * n) + gamma fp (2 * n) +

    (T A : Fin n → Fin n → ℝ) :
    0 ≤ higham11_8_aasenGrowthFactor (infNorm T) (infNorm A) :=
  higham11_8_aasenGrowthFactor_nonneg (infNorm T) (infNorm A)
    (infNorm_nonneg T) (infNorm_nonneg A)

/-- A concrete infinity-norm estimate for `T` gives the printed Aasen
growth-bound predicate after dividing by the positive source matrix norm. -/
theorem higham11_8_aasenGrowthBound_of_infNorm_le_printed_mul_infNorm
    (n : ℕ) (T A : Fin n → Fin n → ℝ) (hA : 0 < infNorm A)
    (hT : infNorm T ≤ (4 : ℝ) ^ (n - 2) * infNorm A) :
    higham11_8_aasenGrowthBound n

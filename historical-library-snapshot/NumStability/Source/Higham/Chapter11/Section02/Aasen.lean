  have h2 :
      2 * γn + γn ^ 2 ≤ γ2n := by
    simpa [γn, γ2n] using
      higham11_8_two_gamma_plus_sq_le_gamma_2n fp n h2n
  have h2mul :
      (2 * γn + γn ^ 2) * γn ≤ γ2n * γn :=
    mul_le_mul_of_nonneg_right h2 hγn
  have hpoly :
      (1 + 2 * γn + γn ^ 2) * γn ≤ γ2n + γn + γ2n * γn := by

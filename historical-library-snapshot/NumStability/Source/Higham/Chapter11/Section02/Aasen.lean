theorem higham11_8_aasenGrowthBound_of_relative_T_hat_error_and_one_plus_infNorm_T_hat_le_printed_mul_infNorm
    (n : ℕ) (T T_hat A : Fin n → Fin n → ℝ) (γ : ℝ)
    (hγ : 0 ≤ γ) (hA : 0 < infNorm A)
    (hThat : ∀ i j : Fin n, |T_hat i j - T i j| ≤ γ * |T_hat i j|)

    dsimp [α]
    exact sq_nonneg _
  have hmul : (κLeft * κRight) * κMid ≤ α * 1 :=
    mul_le_mul (by simpa [α] using hprod) hκMid_le_one hκMid hα
  calc
    κLeft * κMid * κRight = (κLeft * κRight) * κMid := by ring
    _ ≤ α * 1 := hmul
    _ = ((n - 1 : ℕ) : ℝ) ^ 2 := by simp [α]


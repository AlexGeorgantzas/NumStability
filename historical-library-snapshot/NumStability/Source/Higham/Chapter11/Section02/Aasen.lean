/-- A relative `T_hat - T` comparison plus a computed-middle source max-entry
cap `‖T_hat‖_max ≤ κ‖A‖_max` feeds the printed Aasen growth-bound predicate
whenever `(1+γ)κ` is within the printed `4^(n-2)` growth factor. -/
theorem higham11_8_aasenGrowthBound_of_relative_T_hat_error_and_maxEntryNorm_T_hat_le_kappa_mul_maxEntryNorm
    (n : ℕ) (hn : 0 < n) (T T_hat A : Fin n → Fin n → ℝ) (γ κ : ℝ)
    (hγ : 0 ≤ γ) (hA : 0 < maxEntryNorm hn A)
    (hκ : (1 + γ) * κ ≤ (4 : ℝ) ^ (n - 2))
    (hThat : ∀ i j : Fin n, |T_hat i j - T i j| ≤ γ * |T_hat i j|)
    (hTcap : maxEntryNorm hn T_hat ≤ κ * maxEntryNorm hn A) :
    higham11_8_aasenGrowthBound n
      (higham11_8_aasenGrowthFactor (maxEntryNorm hn T) (maxEntryNorm hn A)) := by
  have hscale_nonneg : 0 ≤ 1 + γ := by linarith
  have hscaled :
      (1 + γ) * maxEntryNorm hn T_hat ≤
        (4 : ℝ) ^ (n - 2) * maxEntryNorm hn A := by
    calc
      (1 + γ) * maxEntryNorm hn T_hat ≤
          (1 + γ) * (κ * maxEntryNorm hn A) :=
        mul_le_mul_of_nonneg_left hTcap hscale_nonneg
      _ = ((1 + γ) * κ) * maxEntryNorm hn A := by ring
      _ ≤ (4 : ℝ) ^ (n - 2) * maxEntryNorm hn A :=
        mul_le_mul_of_nonneg_right hκ (le_of_lt hA)
  exact
    higham11_8_aasenGrowthBound_of_relative_T_hat_error_and_one_plus_maxEntryNorm_T_hat_le_printed_mul_maxEntryNorm
      n hn T T_hat A γ hγ hA hThat hscaled

/-- Source-norm version of the printed Aasen normwise backward-error bound,
with the growth-factor estimate `‖T_hat‖∞ ≤ 4^(n-2) ‖A‖∞` already folded into
the right-hand side. -/
def higham11_8_aasenSourceNormwiseBackwardBound
    (n : ℕ) (ΔA_inf γ15n25 A_inf : ℝ) : Prop :=
  ΔA_inf ≤
    ((n - 1 : ℕ) : ℝ) ^ 2 * (4 : ℝ) ^ (n - 2) * γ15n25 * A_inf

/-- Transport the local `T_hat`-norm Aasen bound to the source `A` norm once a
computed-middle growth-factor cap is available. -/
theorem higham11_8_aasenSourceNormwiseBackwardBound_of_T_hat_cap
    (n : ℕ) (ΔA_inf γ15n25 T_hat_inf A_inf : ℝ)
    (hγ : 0 ≤ γ15n25)
    (hbound :
      higham11_8_aasenNormwiseBackwardBound n ΔA_inf γ15n25 T_hat_inf)
    (hTcap : T_hat_inf ≤ (4 : ℝ) ^ (n - 2) * A_inf) :
    higham11_8_aasenSourceNormwiseBackwardBound n ΔA_inf γ15n25 A_inf := by
  change
    ΔA_inf ≤ ((n - 1 : ℕ) : ℝ) ^ 2 * γ15n25 * T_hat_inf at hbound
  change
    ΔA_inf ≤
      ((n - 1 : ℕ) : ℝ) ^ 2 * (4 : ℝ) ^ (n - 2) * γ15n25 * A_inf
  have hcoeff_nonneg : 0 ≤ ((n - 1 : ℕ) : ℝ) ^ 2 * γ15n25 :=
    mul_nonneg (sq_nonneg _) hγ
  have hscaled :
      (((n - 1 : ℕ) : ℝ) ^ 2 * γ15n25) * T_hat_inf ≤
        (((n - 1 : ℕ) : ℝ) ^ 2 * γ15n25) *
          ((4 : ℝ) ^ (n - 2) * A_inf) :=
    mul_le_mul_of_nonneg_left hTcap hcoeff_nonneg
  calc
    ΔA_inf ≤ ((n - 1 : ℕ) : ℝ) ^ 2 * γ15n25 * T_hat_inf := hbound
    _ = (((n - 1 : ℕ) : ℝ) ^ 2 * γ15n25) * T_hat_inf := by ring
    _ ≤ (((n - 1 : ℕ) : ℝ) ^ 2 * γ15n25) *
        ((4 : ℝ) ^ (n - 2) * A_inf) := hscaled
    _ = ((n - 1 : ℕ) : ℝ) ^ 2 * (4 : ℝ) ^ (n - 2) *
        γ15n25 * A_inf := by ring

/-- Matrix-shaped source-norm bridge: a proved Aasen normwise bound against
`‖T_hat‖∞` becomes the source `‖A‖∞` form under the printed computed-middle
growth cap. -/
theorem higham11_8_aasenSourceNormwiseBackwardBound_of_infNorm_T_hat_le_printed_mul_infNorm
    (n : ℕ) (ΔA_inf γ15n25 : ℝ) (T_hat A : Fin n → Fin n → ℝ)
    (hγ : 0 ≤ γ15n25)
    (hbound :
      higham11_8_aasenNormwiseBackwardBound n ΔA_inf γ15n25
        (infNorm T_hat))
    (hTcap : infNorm T_hat ≤ (4 : ℝ) ^ (n - 2) * infNorm A) :
    higham11_8_aasenSourceNormwiseBackwardBound n ΔA_inf γ15n25
      (infNorm A) :=
  higham11_8_aasenSourceNormwiseBackwardBound_of_T_hat_cap
    n ΔA_inf γ15n25 (infNorm T_hat) (infNorm A) hγ hbound hTcap

/-- If the computed Aasen middle factor is bounded by `κ‖A‖∞` and `κ` is no
larger than the printed growth factor, then any existing `T_hat`-norm
backward-error bound has the printed source-norm form. -/
theorem higham11_8_aasenSourceNormwiseBackwardBound_of_infNorm_T_hat_le_kappa_mul_infNorm
    (n : ℕ) (ΔA_inf γ15n25 κ : ℝ)
    (T_hat A : Fin n → Fin n → ℝ)
    (hγ : 0 ≤ γ15n25)
    (hκ : κ ≤ (4 : ℝ) ^ (n - 2))
    (hTcap : infNorm T_hat ≤ κ * infNorm A)
    (hbound :
      higham11_8_aasenNormwiseBackwardBound n ΔA_inf γ15n25
        (infNorm T_hat)) :
    higham11_8_aasenSourceNormwiseBackwardBound n ΔA_inf γ15n25
      (infNorm A) := by
  have hprinted :
      infNorm T_hat ≤ (4 : ℝ) ^ (n - 2) * infNorm A :=
    hTcap.trans (mul_le_mul_of_nonneg_right hκ (infNorm_nonneg A))
  exact
    higham11_8_aasenSourceNormwiseBackwardBound_of_infNorm_T_hat_le_printed_mul_infNorm
      n ΔA_inf γ15n25 T_hat A hγ hbound hprinted

/-- Relative-route scalar growth cap: if `(1+γ)κ` is within the printed
Aasen growth factor and `κ` is nonnegative, a computed-middle cap
`‖T_hat‖∞≤κ‖A‖∞` is strong enough for the source-norm transport. -/
theorem higham11_8_aasenSourceNormwiseBackwardBound_of_infNorm_T_hat_le_kappa_mul_infNorm_relative_growth_cap
    (n : ℕ) (ΔA_inf γ15n25 γ κ : ℝ)
    (T_hat A : Fin n → Fin n → ℝ)
    (hγ15 : 0 ≤ γ15n25) (hγ : 0 ≤ γ) (hκ_nonneg : 0 ≤ κ)
    (hκ : (1 + γ) * κ ≤ (4 : ℝ) ^ (n - 2))
    (hTcap : infNorm T_hat ≤ κ * infNorm A)
    (hbound :
      higham11_8_aasenNormwiseBackwardBound n ΔA_inf γ15n25
        (infNorm T_hat)) :

      have hj_lt :=
        (higham11_7_tridiagonalPathLocalBlockIndex_not_exists_iff_lt_prefixSpan
          k step t j).1 hnot
      exact hj_prefix hj_lt
    rcases hj_mem with ⟨a, ha⟩
    rw [← ha]
    exact hlocal t hstep s hst a


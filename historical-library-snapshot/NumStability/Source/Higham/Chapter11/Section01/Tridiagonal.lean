  have hsum :
      (∑ t : Fin k, c t * u * infNorm A) =
        (∑ t : Fin k, c t) * u * infNorm A := by
    simp [Finset.sum_mul, mul_assoc]
  have hΔA2bound : ∀ i j : Fin n, |ΔA2 i j| ≤ C * u * infNorm A := by

/-- Zero-based scheduled branch starts are strictly ordered by path index. -/
theorem higham11_7_tridiagonalPathStartOffsets_lt_of_lt
    (k : ℕ) (step : Fin k → PivotSize) (starts : Fin k → ℕ)

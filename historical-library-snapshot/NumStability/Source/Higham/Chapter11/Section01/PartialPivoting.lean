/-- Source-shaped path package for the local hypotheses used in the Theorem
11.4 source-six/growth-`D̂` product route.  It keeps the path block-diagonal
`D̂` shape, the local growth-scaled `D̂` cap, and source-six branch-local
`|L̂|` row sums together for callers that have already run the concrete pivot
path analysis. -/
def higham11_4_BunchKaufmanPathSourceSixGrowthLDPackage
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (L_hat D_hat : Fin (higham11_4_bunchKaufmanPathPivotSpan k step) →
      Fin (higham11_4_bunchKaufmanPathPivotSpan k step) → ℝ)
    (ρ_n Amax : ℝ) : Prop :=
  higham11_4_BunchKaufmanPathBlockDiagonalD k step D_hat ∧
  higham11_4_BunchKaufmanPathLocalDEntryBound k step D_hat (ρ_n * Amax) ∧
  ∀ t : Fin k,
    ∀ i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)),
      (∑ q : Fin (higham11_4_bunchKaufmanPathPivotSpan k step),
        |L_hat (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i) q|) ≤
          6

/-- The source-six/growth path package is monotone in the growth scale after
multiplying by the source max-entry cap. -/
theorem higham11_4_BunchKaufmanPathSourceSixGrowthLDPackage_mono_Dscale
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (L_hat D_hat : Fin (higham11_4_bunchKaufmanPathPivotSpan k step) →
      Fin (higham11_4_bunchKaufmanPathPivotSpan k step) → ℝ)
    (ρlo ρhi Amax : ℝ)
    (hscale : ρlo * Amax ≤ ρhi * Amax)
    (hpkg :
      higham11_4_BunchKaufmanPathSourceSixGrowthLDPackage
        k step L_hat D_hat ρlo Amax) :
    higham11_4_BunchKaufmanPathSourceSixGrowthLDPackage
      k step L_hat D_hat ρhi Amax := by
  refine ⟨hpkg.1, ?_, hpkg.2.2⟩
  exact
    higham11_4_BunchKaufmanPathLocalDEntryBound_mono
      k step D_hat (ρlo * Amax) (ρhi * Amax) hscale hpkg.2.1

/-- The source-six/growth path package restricts from a nonempty active
Bunch-Kaufman path to its trailing active subpath. -/
theorem higham11_4_BunchKaufmanPathSourceSixGrowthLDPackage_tail
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch)
    (L_hat D_hat : Fin (higham11_4_bunchKaufmanPathPivotSpan (k + 1) step) →
      Fin (higham11_4_bunchKaufmanPathPivotSpan (k + 1) step) → ℝ)
    (ρ_n Amax : ℝ)
    (hpkg :
      higham11_4_BunchKaufmanPathSourceSixGrowthLDPackage
        (k + 1) step L_hat D_hat ρ_n Amax) :
    higham11_4_BunchKaufmanPathSourceSixGrowthLDPackage k
      (fun u : Fin k => step u.succ)
      (higham11_4_bunchKaufmanPathTailMatrix k step L_hat)
      (higham11_4_bunchKaufmanPathTailMatrix k step D_hat) ρ_n Amax := by
  refine ⟨?_, ?_, ?_⟩
  · exact
      higham11_4_BunchKaufmanPathBlockDiagonalD_tail k step D_hat hpkg.1

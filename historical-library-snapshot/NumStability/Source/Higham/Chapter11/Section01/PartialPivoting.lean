    harr_Amax⟩

/-- **Theorem 11.4 / Algorithm 11.2 case-(4) growth bridge**: when the
case-(4) `2 × 2` pivot also carries the concrete source-side row-maximum
dominance `ωr≤ω1`, its pivot block satisfies the hypotheses of the local
`2 × 2` Schur-growth theorem.  The row-maximum side condition is explicit
because it is a pivot-path fact, not a consequence of the branch predicate
alone. -/
theorem higham11_4_bunch_kaufman_case4_twoByTwo_schur_growth_of_row_max_le
    (bij ci1 ci2 cj1 cj2 a11 a1r arr ω1 ωr K : ℝ)
    (hω1 : 0 < ω1) (hωr_le : ωr ≤ ω1)
    (hcase : higham11_2_BunchKaufmanPartialPivotCase
      higham11_1_bunchParlettAlpha a11 arr ω1 ωr BunchKaufmanCase.case4)
    (ha1r : |a1r| = ω1)
    (hK : (1 - higham11_1_bunchParlettAlpha ^ 2) * ω1 * K = 1)
    (hb : |bij| ≤ ω1) (hci1 : |ci1| ≤ ω1) (hci2 : |ci2| ≤ ω1)
    (hcj1 : |cj1| ≤ ω1) (hcj2 : |cj2| ≤ ω1) :
    |higham11_4_twoByTwoSchurEntry bij ci1 ci2 cj1 cj2
        (arr / (a11 * arr - a1r ^ 2)) (-(a1r / (a11 * arr - a1r ^ 2)))
        (-(a1r / (a11 * arr - a1r ^ 2))) (a11 / (a11 * arr - a1r ^ 2))| ≤
      (1 + 2 / (1 - higham11_1_bunchParlettAlpha)) * ω1 := by
  rcases higham11_2_bunch_kaufman_case4_tests
      higham11_1_bunchParlettAlpha a11 arr ω1 ωr hcase with
    ⟨_, ha11_lt, _, harr_lt⟩
  have hα_pos : 0 < higham11_1_bunchParlettAlpha := by
    simpa [higham11_1_bunchParlettAlpha] using bunch_parlett_alpha_pos
  have hα_nonneg : 0 ≤ higham11_1_bunchParlettAlpha := le_of_lt hα_pos
  have hα_lt_one : higham11_1_bunchParlettAlpha < 1 := by
    simpa [higham11_1_bunchParlettAlpha] using bunch_parlett_alpha_lt_one
  have hμ1_nonneg : 0 ≤ higham11_1_bunchParlettAlpha * ω1 :=
    mul_nonneg hα_nonneg (le_of_lt hω1)
  have he11 : |a11| ≤ higham11_1_bunchParlettAlpha * ω1 :=
    le_of_lt ha11_lt
  have he22 : |arr| ≤ higham11_1_bunchParlettAlpha * ω1 := by
    have harr_le : |arr| ≤ higham11_1_bunchParlettAlpha * ωr :=
      le_of_lt harr_lt
    exact harr_le.trans (mul_le_mul_of_nonneg_left hωr_le hα_nonneg)
  have he21 : a1r ^ 2 = ω1 ^ 2 := by
    calc
      a1r ^ 2 = |a1r| ^ 2 := by rw [sq_abs]
      _ = ω1 ^ 2 := by rw [ha1r]
  exact
    higham11_4_twoByTwo_schur_growth_of_block
      bij ci1 ci2 cj1 cj2 a11 arr a1r ω1
      (higham11_1_bunchParlettAlpha * ω1) higham11_1_bunchParlettAlpha K
      hμ1_nonneg hα_nonneg hα_lt_one hω1 he11 he22 he21 le_rfl hK hb hci1 hci2
      hcj1 hcj2

/-- **Theorem 11.4 / Algorithm 11.2 case-(4) multiplier row cap**: under the
same concrete row-maximum dominance needed for the case-(4) `2 × 2` pivot block,
one row of `CE⁻¹` has source row sum at most `6`. -/
theorem higham11_4_bunch_kaufman_case4_twoByTwo_multiplier_row_sum_le_six_of_row_max_le
    (c1 c2 a11 a1r arr ω1 ωr K : ℝ)
    (hω1 : 0 < ω1) (hωr_le : ωr ≤ ω1)
    (hcase : higham11_2_BunchKaufmanPartialPivotCase
      higham11_1_bunchParlettAlpha a11 arr ω1 ωr BunchKaufmanCase.case4)
    (ha1r : |a1r| = ω1)
    (hK : (1 - higham11_1_bunchParlettAlpha ^ 2) * ω1 * K = 1)
    (hc1 : |c1| ≤ ω1) (hc2 : |c2| ≤ ω1) :
    |c1 * (arr / (a11 * arr - a1r ^ 2)) +
        c2 * (-(a1r / (a11 * arr - a1r ^ 2)))| +
      |c1 * (-(a1r / (a11 * arr - a1r ^ 2))) +
        c2 * (a11 / (a11 * arr - a1r ^ 2))| ≤ 6 := by
  rcases higham11_2_bunch_kaufman_case4_tests
      higham11_1_bunchParlettAlpha a11 arr ω1 ωr hcase with
    ⟨_, ha11_lt, _, harr_lt⟩
  have hα_pos : 0 < higham11_1_bunchParlettAlpha := by
    simpa [higham11_1_bunchParlettAlpha] using bunch_parlett_alpha_pos
  have hα_nonneg : 0 ≤ higham11_1_bunchParlettAlpha := le_of_lt hα_pos
  have hα_lt_one : higham11_1_bunchParlettAlpha < 1 := by
    simpa [higham11_1_bunchParlettAlpha] using bunch_parlett_alpha_lt_one
  have hμ1_nonneg : 0 ≤ higham11_1_bunchParlettAlpha * ω1 :=
    mul_nonneg hα_nonneg (le_of_lt hω1)
  have he11 : |a11| ≤ higham11_1_bunchParlettAlpha * ω1 :=
    le_of_lt ha11_lt
  have he22 : |arr| ≤ higham11_1_bunchParlettAlpha * ω1 := by
    have harr_le : |arr| ≤ higham11_1_bunchParlettAlpha * ωr :=
      le_of_lt harr_lt
    exact harr_le.trans (mul_le_mul_of_nonneg_left hωr_le hα_nonneg)
  have he21 : a1r ^ 2 = ω1 ^ 2 := by
    calc
      a1r ^ 2 = |a1r| ^ 2 := by rw [sq_abs]
      _ = ω1 ^ 2 := by rw [ha1r]
  exact
    higham11_4_twoByTwo_multiplier_row_sum_le_six_of_block
      c1 c2 a11 arr a1r ω1 (higham11_1_bunchParlettAlpha * ω1) K
      hμ1_nonneg hω1 he11 he22 he21 le_rfl hK hc1 hc2

/-- **Theorem 11.4 / Algorithm 11.2 case-(4) determinant bridge**: the printed
case-(4) product tests alone give the pivot-block determinant lower bound.
This is the source argument `|a11*arr| ≤ α²ω1²`, with `|a1r| = ω1`; no
row-maximum dominance side condition is needed for nonsingularity. -/
theorem higham11_4_bunch_kaufman_case4_twoByTwo_absdet_lower
    (a11 a1r arr ω1 ωr : ℝ)
    (hcase : higham11_2_BunchKaufmanPartialPivotCase
      higham11_1_bunchParlettAlpha a11 arr ω1 ωr BunchKaufmanCase.case4)
    (ha1r : |a1r| = ω1) :
    (1 - higham11_1_bunchParlettAlpha ^ 2) * ω1 ^ 2 ≤
      |a11 * arr - a1r ^ 2| := by
  rcases higham11_2_bunch_kaufman_case4_tests
      higham11_1_bunchParlettAlpha a11 arr ω1 ωr hcase with
    ⟨_, _, hprod_lt, harr_lt⟩
  have hα_pos : 0 < higham11_1_bunchParlettAlpha := by
    simpa [higham11_1_bunchParlettAlpha] using bunch_parlett_alpha_pos
  have hα_nonneg : 0 ≤ higham11_1_bunchParlettAlpha := le_of_lt hα_pos
  have hprod_abs_le :
      |a11 * arr| ≤ higham11_1_bunchParlettAlpha ^ 2 * ω1 ^ 2 := by
    have harr_le : |arr| ≤ higham11_1_bunchParlettAlpha * ωr :=
      le_of_lt harr_lt
    have hprod_step :
        |a11| * |arr| ≤ |a11| * (higham11_1_bunchParlettAlpha * ωr) :=
      mul_le_mul_of_nonneg_left harr_le (abs_nonneg a11)
    have hprod_scaled :
        higham11_1_bunchParlettAlpha * (|a11| * ωr) ≤
          higham11_1_bunchParlettAlpha *
            (higham11_1_bunchParlettAlpha * ω1 ^ 2) :=
      mul_le_mul_of_nonneg_left (le_of_lt hprod_lt) hα_nonneg
    calc
      |a11 * arr| = |a11| * |arr| := abs_mul a11 arr
      _ ≤ |a11| * (higham11_1_bunchParlettAlpha * ωr) := hprod_step
      _ = higham11_1_bunchParlettAlpha * (|a11| * ωr) := by ring
      _ ≤ higham11_1_bunchParlettAlpha *
            (higham11_1_bunchParlettAlpha * ω1 ^ 2) := hprod_scaled
      _ = higham11_1_bunchParlettAlpha ^ 2 * ω1 ^ 2 := by ring
  have ha1r_sq : a1r ^ 2 = ω1 ^ 2 := by
    calc
      a1r ^ 2 = |a1r| ^ 2 := by rw [sq_abs]
      _ = ω1 ^ 2 := by rw [ha1r]
  have hdecomp : (a1r ^ 2 - a11 * arr) + a11 * arr = a1r ^ 2 := by ring
  have hsum : |a1r ^ 2| ≤ |a1r ^ 2 - a11 * arr| + |a11 * arr| := by
    calc
      |a1r ^ 2| = |(a1r ^ 2 - a11 * arr) + a11 * arr| := by rw [hdecomp]
      _ ≤ |a1r ^ 2 - a11 * arr| + |a11 * arr| := abs_add_le _ _
  have hsq_abs : |a1r ^ 2| = a1r ^ 2 := abs_of_nonneg (sq_nonneg a1r)
  have hlower_basic : a1r ^ 2 - |a11 * arr| ≤
      |a1r ^ 2 - a11 * arr| := by
    rw [hsq_abs] at hsum
    linarith
  have hcoeff_le_basic :
      (1 - higham11_1_bunchParlettAlpha ^ 2) * ω1 ^ 2 ≤
        a1r ^ 2 - |a11 * arr| := by
    rw [ha1r_sq]
    nlinarith [hprod_abs_le]
  calc
    (1 - higham11_1_bunchParlettAlpha ^ 2) * ω1 ^ 2 ≤
        a1r ^ 2 - |a11 * arr| := hcoeff_le_basic
    _ ≤ |a1r ^ 2 - a11 * arr| := hlower_basic
    _ = |a11 * arr - a1r ^ 2| := by rw [abs_sub_comm]

/-- **Theorem 11.4 / Algorithm 11.2 case-(4) nonsingularity bridge**: the
accepted `2 × 2` pivot block is nonsingular by the direct printed determinant
bound. -/
theorem higham11_4_bunch_kaufman_case4_twoByTwo_det_ne_zero
    (a11 a1r arr ω1 ωr : ℝ)
    (hω1 : 0 < ω1)
    (hcase : higham11_2_BunchKaufmanPartialPivotCase
      higham11_1_bunchParlettAlpha a11 arr ω1 ωr BunchKaufmanCase.case4)
    (ha1r : |a1r| = ω1) :
    a11 * arr - a1r ^ 2 ≠ 0 := by
  have hα_nonneg : 0 ≤ higham11_1_bunchParlettAlpha := by
    exact le_of_lt (by simpa [higham11_1_bunchParlettAlpha] using bunch_parlett_alpha_pos)
  have hα_lt_one : higham11_1_bunchParlettAlpha < 1 := by
    simpa [higham11_1_bunchParlettAlpha] using bunch_parlett_alpha_lt_one
  have hα_sq_lt_one : higham11_1_bunchParlettAlpha ^ 2 < 1 := by
    nlinarith [hα_nonneg, hα_lt_one]
  have hωsq_pos : 0 < ω1 ^ 2 := sq_pos_of_ne_zero (ne_of_gt hω1)
  have hscale_pos : 0 < (1 - higham11_1_bunchParlettAlpha ^ 2) * ω1 ^ 2 :=
    mul_pos (by linarith [hα_sq_lt_one]) hωsq_pos
  have hlower :=
    higham11_4_bunch_kaufman_case4_twoByTwo_absdet_lower
      a11 a1r arr ω1 ωr hcase ha1r
  have hdet_abs_pos : 0 < |a11 * arr - a1r ^ 2| :=
    lt_of_lt_of_le hscale_pos hlower
  exact abs_pos.mp hdet_abs_pos

/-- **Theorem 11.4 / Algorithm 11.2 case-(4) scaled inverse-entry bounds**:
the printed case-(4) determinant estimate gives the three scaled inverse
quantities consumed by the source Schur-growth calculation.  These bounds avoid
the stronger complete-pivot-style diagonal entry cap. -/
theorem higham11_4_bunch_kaufman_case4_twoByTwo_inverse_scaled_bounds
    (a11 a1r arr ω1 ωr : ℝ)
    (hω1 : 0 < ω1)
    (hcase : higham11_2_BunchKaufmanPartialPivotCase
      higham11_1_bunchParlettAlpha a11 arr ω1 ωr BunchKaufmanCase.case4)
    (ha1r : |a1r| = ω1) :
    |arr / (a11 * arr - a1r ^ 2)| * ω1 ^ 2 ≤
        higham11_1_bunchParlettAlpha * ωr /
          (1 - higham11_1_bunchParlettAlpha ^ 2) ∧
      |a1r / (a11 * arr - a1r ^ 2)| * (ω1 * ωr) ≤
        ωr / (1 - higham11_1_bunchParlettAlpha ^ 2) ∧
      |a11 / (a11 * arr - a1r ^ 2)| * ωr ^ 2 ≤
        higham11_1_bunchParlettAlpha * ωr /
          (1 - higham11_1_bunchParlettAlpha ^ 2) := by
  rcases higham11_2_bunch_kaufman_case4_tests
      higham11_1_bunchParlettAlpha a11 arr ω1 ωr hcase with
    ⟨_, _, hprod_lt, harr_lt⟩
  have hα_pos : 0 < higham11_1_bunchParlettAlpha := by
    simpa [higham11_1_bunchParlettAlpha] using bunch_parlett_alpha_pos
  have hα_nonneg : 0 ≤ higham11_1_bunchParlettAlpha := le_of_lt hα_pos
  have hα_lt_one : higham11_1_bunchParlettAlpha < 1 := by
    simpa [higham11_1_bunchParlettAlpha] using bunch_parlett_alpha_lt_one
  have hα_sq_lt_one : higham11_1_bunchParlettAlpha ^ 2 < 1 := by
    nlinarith [hα_nonneg, hα_lt_one]
  have hden_pos : 0 < 1 - higham11_1_bunchParlettAlpha ^ 2 := by
    linarith [hα_sq_lt_one]
  have hωsq_pos : 0 < ω1 ^ 2 := sq_pos_of_ne_zero (ne_of_gt hω1)
  have hD_pos : 0 < (1 - higham11_1_bunchParlettAlpha ^ 2) * ω1 ^ 2 :=
    mul_pos hden_pos hωsq_pos
  have hD_nonneg : 0 ≤ (1 - higham11_1_bunchParlettAlpha ^ 2) * ω1 ^ 2 :=
    le_of_lt hD_pos
  have hlower :=
    higham11_4_bunch_kaufman_case4_twoByTwo_absdet_lower
      a11 a1r arr ω1 ωr hcase ha1r
  have hdet_abs_pos : 0 < |a11 * arr - a1r ^ 2| :=
    lt_of_lt_of_le hD_pos hlower
  have hαωr_pos : 0 < higham11_1_bunchParlettAlpha * ωr :=
    lt_of_le_of_lt (abs_nonneg arr) harr_lt
  have hωr_pos : 0 < ωr := by nlinarith [hα_pos, hαωr_pos]
  have hωr_nonneg : 0 ≤ ωr := le_of_lt hωr_pos
  have harr_le : |arr| ≤ higham11_1_bunchParlettAlpha * ωr :=
    le_of_lt harr_lt
  have hprod_le : |a11| * ωr ≤ higham11_1_bunchParlettAlpha * ω1 ^ 2 :=
    le_of_lt hprod_lt
  have hfirst_num_le :
      |arr| * ω1 ^ 2 ≤
        (higham11_1_bunchParlettAlpha * ωr) * ω1 ^ 2 :=
    mul_le_mul_of_nonneg_right harr_le (sq_nonneg ω1)
  have hfirst_num_nonneg :
      0 ≤ (higham11_1_bunchParlettAlpha * ωr) * ω1 ^ 2 :=
    mul_nonneg (mul_nonneg hα_nonneg hωr_nonneg) (sq_nonneg ω1)
  have hfirst_div :
      |arr| * ω1 ^ 2 / |a11 * arr - a1r ^ 2| ≤
        (higham11_1_bunchParlettAlpha * ωr) * ω1 ^ 2 /
          ((1 - higham11_1_bunchParlettAlpha ^ 2) * ω1 ^ 2) :=
    (div_le_div_of_nonneg_right hfirst_num_le (le_of_lt hdet_abs_pos)).trans
      (div_le_div_of_nonneg_left hfirst_num_nonneg hD_pos hlower)
  have hfirst :
      |arr / (a11 * arr - a1r ^ 2)| * ω1 ^ 2 ≤
        higham11_1_bunchParlettAlpha * ωr /
          (1 - higham11_1_bunchParlettAlpha ^ 2) := by
    calc
      |arr / (a11 * arr - a1r ^ 2)| * ω1 ^ 2
          = |arr| * ω1 ^ 2 / |a11 * arr - a1r ^ 2| := by
            rw [abs_div]
            field_simp [ne_of_gt hdet_abs_pos]
      _ ≤ (higham11_1_bunchParlettAlpha * ωr) * ω1 ^ 2 /
          ((1 - higham11_1_bunchParlettAlpha ^ 2) * ω1 ^ 2) := hfirst_div
      _ = higham11_1_bunchParlettAlpha * ωr /
          (1 - higham11_1_bunchParlettAlpha ^ 2) := by
            field_simp [ne_of_gt hden_pos, ne_of_gt hωsq_pos]
  have ha1r_abs : |a1r| = ω1 := ha1r
  have hsecond_num_le : |a1r| * (ω1 * ωr) ≤ ω1 ^ 2 * ωr := by
    rw [ha1r_abs]
    ring_nf
    exact le_rfl
  have hsecond_num_nonneg : 0 ≤ ω1 ^ 2 * ωr :=
    mul_nonneg (sq_nonneg ω1) hωr_nonneg
  have hsecond_div :
      |a1r| * (ω1 * ωr) / |a11 * arr - a1r ^ 2| ≤
        ω1 ^ 2 * ωr /
          ((1 - higham11_1_bunchParlettAlpha ^ 2) * ω1 ^ 2) :=
    (div_le_div_of_nonneg_right hsecond_num_le (le_of_lt hdet_abs_pos)).trans
      (div_le_div_of_nonneg_left hsecond_num_nonneg hD_pos hlower)
  have hsecond :
      |a1r / (a11 * arr - a1r ^ 2)| * (ω1 * ωr) ≤
        ωr / (1 - higham11_1_bunchParlettAlpha ^ 2) := by
    calc
      |a1r / (a11 * arr - a1r ^ 2)| * (ω1 * ωr)
          = |a1r| * (ω1 * ωr) / |a11 * arr - a1r ^ 2| := by
            rw [abs_div]
            field_simp [ne_of_gt hdet_abs_pos]
      _ ≤ ω1 ^ 2 * ωr /
          ((1 - higham11_1_bunchParlettAlpha ^ 2) * ω1 ^ 2) := hsecond_div
      _ = ωr / (1 - higham11_1_bunchParlettAlpha ^ 2) := by
            field_simp [ne_of_gt hden_pos, ne_of_gt hωsq_pos]
  have hthird_num_le :
      |a11| * ωr ^ 2 ≤
        (higham11_1_bunchParlettAlpha * ω1 ^ 2) * ωr := by
    calc
      |a11| * ωr ^ 2 = (|a11| * ωr) * ωr := by ring
      _ ≤ (higham11_1_bunchParlettAlpha * ω1 ^ 2) * ωr :=
        mul_le_mul_of_nonneg_right hprod_le hωr_nonneg
  have hthird_num_nonneg :
      0 ≤ (higham11_1_bunchParlettAlpha * ω1 ^ 2) * ωr :=
    mul_nonneg (mul_nonneg hα_nonneg (sq_nonneg ω1)) hωr_nonneg
  have hthird_div :
      |a11| * ωr ^ 2 / |a11 * arr - a1r ^ 2| ≤
        (higham11_1_bunchParlettAlpha * ω1 ^ 2) * ωr /
          ((1 - higham11_1_bunchParlettAlpha ^ 2) * ω1 ^ 2) :=
    (div_le_div_of_nonneg_right hthird_num_le (le_of_lt hdet_abs_pos)).trans
      (div_le_div_of_nonneg_left hthird_num_nonneg hD_pos hlower)
  have hthird :
      |a11 / (a11 * arr - a1r ^ 2)| * ωr ^ 2 ≤
        higham11_1_bunchParlettAlpha * ωr /
          (1 - higham11_1_bunchParlettAlpha ^ 2) := by
    calc
      |a11 / (a11 * arr - a1r ^ 2)| * ωr ^ 2
          = |a11| * ωr ^ 2 / |a11 * arr - a1r ^ 2| := by
            rw [abs_div]
            field_simp [ne_of_gt hdet_abs_pos]
      _ ≤ (higham11_1_bunchParlettAlpha * ω1 ^ 2) * ωr /
          ((1 - higham11_1_bunchParlettAlpha ^ 2) * ω1 ^ 2) := hthird_div
      _ = higham11_1_bunchParlettAlpha * ωr /
          (1 - higham11_1_bunchParlettAlpha ^ 2) := by
            field_simp [ne_of_gt hden_pos, ne_of_gt hωsq_pos]
  exact ⟨hfirst, hsecond, hthird⟩

/-- **Theorem 11.4 / Algorithm 11.2 case-(4) Schur correction bound**:
the direct scaled inverse-entry estimates for the accepted `2 × 2` pivot bound
one source Schur correction by `2ωr/(1−α)`, without assuming `ωr≤ω1`. -/
theorem higham11_4_bunch_kaufman_case4_twoByTwo_schur_correction_bound
    (ci1 ci2 cj1 cj2 a11 a1r arr ω1 ωr : ℝ)
    (hω1 : 0 < ω1)
    (hcase : higham11_2_BunchKaufmanPartialPivotCase
      higham11_1_bunchParlettAlpha a11 arr ω1 ωr BunchKaufmanCase.case4)
    (ha1r : |a1r| = ω1)
    (hci1 : |ci1| ≤ ω1) (hci2 : |ci2| ≤ ωr)
    (hcj1 : |cj1| ≤ ω1) (hcj2 : |cj2| ≤ ωr) :
    |ci1 * ((arr / (a11 * arr - a1r ^ 2)) * cj1 +
          (-(a1r / (a11 * arr - a1r ^ 2))) * cj2) +
        ci2 * ((-(a1r / (a11 * arr - a1r ^ 2))) * cj1 +
          (a11 / (a11 * arr - a1r ^ 2)) * cj2)| ≤
      2 * ωr / (1 - higham11_1_bunchParlettAlpha) := by
  obtain ⟨hf11_scaled, hf12_scaled, hf22_scaled⟩ :=
    higham11_4_bunch_kaufman_case4_twoByTwo_inverse_scaled_bounds
      a11 a1r arr ω1 ωr hω1 hcase ha1r
  have hα_pos : 0 < higham11_1_bunchParlettAlpha := by
    simpa [higham11_1_bunchParlettAlpha] using bunch_parlett_alpha_pos
  have hα_nonneg : 0 ≤ higham11_1_bunchParlettAlpha := le_of_lt hα_pos
  have hα_lt_one : higham11_1_bunchParlettAlpha < 1 := by
    simpa [higham11_1_bunchParlettAlpha] using bunch_parlett_alpha_lt_one
  have hα_sq_lt_one : higham11_1_bunchParlettAlpha ^ 2 < 1 := by
    nlinarith [hα_nonneg, hα_lt_one]
  have hden_pos : 0 < 1 - higham11_1_bunchParlettAlpha ^ 2 := by
    linarith [hα_sq_lt_one]
  have h1α_pos : 0 < 1 - higham11_1_bunchParlettAlpha := by
    linarith [hα_lt_one]
  have hω1_nonneg : 0 ≤ ω1 := le_of_lt hω1
  have hωr_nonneg : 0 ≤ ωr := by
    exact le_trans (abs_nonneg ci2) hci2
  have hf12_scaled_neg :
      |-(a1r / (a11 * arr - a1r ^ 2))| * (ω1 * ωr) ≤
        ωr / (1 - higham11_1_bunchParlettAlpha ^ 2) := by
    simpa [abs_neg] using hf12_scaled
  have ht1 :
      |ci1 * (arr / (a11 * arr - a1r ^ 2)) * cj1| ≤
        higham11_1_bunchParlettAlpha * ωr /
          (1 - higham11_1_bunchParlettAlpha ^ 2) := by
    have hraw :=
      abs_triple_mul_le ci1 (arr / (a11 * arr - a1r ^ 2)) cj1
        ω1 |arr / (a11 * arr - a1r ^ 2)| ω1
        hω1_nonneg (abs_nonneg _) hci1 le_rfl hcj1
    calc
      |ci1 * (arr / (a11 * arr - a1r ^ 2)) * cj1|
          ≤ ω1 * |arr / (a11 * arr - a1r ^ 2)| * ω1 := hraw
      _ = |arr / (a11 * arr - a1r ^ 2)| * ω1 ^ 2 := by ring
      _ ≤ higham11_1_bunchParlettAlpha * ωr /
          (1 - higham11_1_bunchParlettAlpha ^ 2) := hf11_scaled
  have ht2 :
      |ci1 * (-(a1r / (a11 * arr - a1r ^ 2))) * cj2| ≤
        ωr / (1 - higham11_1_bunchParlettAlpha ^ 2) := by
    have hraw :=
      abs_triple_mul_le ci1 (-(a1r / (a11 * arr - a1r ^ 2))) cj2
        ω1 |-(a1r / (a11 * arr - a1r ^ 2))| ωr
        hω1_nonneg (abs_nonneg _) hci1 le_rfl hcj2
    calc
      |ci1 * (-(a1r / (a11 * arr - a1r ^ 2))) * cj2|
          ≤ ω1 * |-(a1r / (a11 * arr - a1r ^ 2))| * ωr := hraw
      _ = |-(a1r / (a11 * arr - a1r ^ 2))| * (ω1 * ωr) := by ring
      _ ≤ ωr / (1 - higham11_1_bunchParlettAlpha ^ 2) := hf12_scaled_neg
  have ht3 :
      |ci2 * (-(a1r / (a11 * arr - a1r ^ 2))) * cj1| ≤
        ωr / (1 - higham11_1_bunchParlettAlpha ^ 2) := by
    have hraw :=
      abs_triple_mul_le ci2 (-(a1r / (a11 * arr - a1r ^ 2))) cj1
        ωr |-(a1r / (a11 * arr - a1r ^ 2))| ω1
        hωr_nonneg (abs_nonneg _) hci2 le_rfl hcj1
    calc
      |ci2 * (-(a1r / (a11 * arr - a1r ^ 2))) * cj1|
          ≤ ωr * |-(a1r / (a11 * arr - a1r ^ 2))| * ω1 := hraw
      _ = |-(a1r / (a11 * arr - a1r ^ 2))| * (ω1 * ωr) := by ring
      _ ≤ ωr / (1 - higham11_1_bunchParlettAlpha ^ 2) := hf12_scaled_neg
  have ht4 :
      |ci2 * (a11 / (a11 * arr - a1r ^ 2)) * cj2| ≤
        higham11_1_bunchParlettAlpha * ωr /
          (1 - higham11_1_bunchParlettAlpha ^ 2) := by
    have hraw :=
      abs_triple_mul_le ci2 (a11 / (a11 * arr - a1r ^ 2)) cj2
        ωr |a11 / (a11 * arr - a1r ^ 2)| ωr
        hωr_nonneg (abs_nonneg _) hci2 le_rfl hcj2
    calc
      |ci2 * (a11 / (a11 * arr - a1r ^ 2)) * cj2|
          ≤ ωr * |a11 / (a11 * arr - a1r ^ 2)| * ωr := hraw
      _ = |a11 / (a11 * arr - a1r ^ 2)| * ωr ^ 2 := by ring
      _ ≤ higham11_1_bunchParlettAlpha * ωr /
          (1 - higham11_1_bunchParlettAlpha ^ 2) := hf22_scaled
  have hexpand :
      ci1 * ((arr / (a11 * arr - a1r ^ 2)) * cj1 +
            (-(a1r / (a11 * arr - a1r ^ 2))) * cj2) +
          ci2 * ((-(a1r / (a11 * arr - a1r ^ 2))) * cj1 +
            (a11 / (a11 * arr - a1r ^ 2)) * cj2)
        =
      ci1 * (arr / (a11 * arr - a1r ^ 2)) * cj1 +
        ci1 * (-(a1r / (a11 * arr - a1r ^ 2))) * cj2 +
        ci2 * (-(a1r / (a11 * arr - a1r ^ 2))) * cj1 +
        ci2 * (a11 / (a11 * arr - a1r ^ 2)) * cj2 := by
    ring
  have htri :
      |ci1 * (arr / (a11 * arr - a1r ^ 2)) * cj1 +
          ci1 * (-(a1r / (a11 * arr - a1r ^ 2))) * cj2 +
          ci2 * (-(a1r / (a11 * arr - a1r ^ 2))) * cj1 +
          ci2 * (a11 / (a11 * arr - a1r ^ 2)) * cj2|
        ≤
      |ci1 * (arr / (a11 * arr - a1r ^ 2)) * cj1| +
        |ci1 * (-(a1r / (a11 * arr - a1r ^ 2))) * cj2| +
        |ci2 * (-(a1r / (a11 * arr - a1r ^ 2))) * cj1| +
        |ci2 * (a11 / (a11 * arr - a1r ^ 2)) * cj2| := by
    refine le_trans (abs_add_le _ _) ?_
    refine add_le_add (le_trans (abs_add_le _ _) ?_) (le_refl _)
    exact add_le_add (abs_add_le _ _) (le_refl _)
  calc
    |ci1 * ((arr / (a11 * arr - a1r ^ 2)) * cj1 +
          (-(a1r / (a11 * arr - a1r ^ 2))) * cj2) +
        ci2 * ((-(a1r / (a11 * arr - a1r ^ 2))) * cj1 +
          (a11 / (a11 * arr - a1r ^ 2)) * cj2)|
        =
      |ci1 * (arr / (a11 * arr - a1r ^ 2)) * cj1 +
        ci1 * (-(a1r / (a11 * arr - a1r ^ 2))) * cj2 +
        ci2 * (-(a1r / (a11 * arr - a1r ^ 2))) * cj1 +
        ci2 * (a11 / (a11 * arr - a1r ^ 2)) * cj2| := by
          rw [hexpand]
    _ ≤
      |ci1 * (arr / (a11 * arr - a1r ^ 2)) * cj1| +
        |ci1 * (-(a1r / (a11 * arr - a1r ^ 2))) * cj2| +
        |ci2 * (-(a1r / (a11 * arr - a1r ^ 2))) * cj1| +
        |ci2 * (a11 / (a11 * arr - a1r ^ 2)) * cj2| := htri
    _ ≤
      higham11_1_bunchParlettAlpha * ωr /
          (1 - higham11_1_bunchParlettAlpha ^ 2) +
        ωr / (1 - higham11_1_bunchParlettAlpha ^ 2) +
        ωr / (1 - higham11_1_bunchParlettAlpha ^ 2) +
        higham11_1_bunchParlettAlpha * ωr /
          (1 - higham11_1_bunchParlettAlpha ^ 2) := by
          exact add_le_add (add_le_add (add_le_add ht1 ht2) ht3) ht4
    _ = 2 * ωr / (1 - higham11_1_bunchParlettAlpha) := by
          field_simp [ne_of_gt hden_pos, ne_of_gt h1α_pos]
          ring

/-- **Theorem 11.4 / Algorithm 11.2 case-(4) Schur growth bridge**: the
source case-(4) one-step growth estimate follows directly from the printed
case-(4) tests and active-entry bounds, with no `ωr≤ω1` side condition. -/
theorem higham11_4_bunch_kaufman_case4_twoByTwo_schur_growth
    (bij ci1 ci2 cj1 cj2 a11 a1r arr ω1 ωr Amax : ℝ)
    (hω1 : 0 < ω1)
    (hcase : higham11_2_BunchKaufmanPartialPivotCase
      higham11_1_bunchParlettAlpha a11 arr ω1 ωr BunchKaufmanCase.case4)
    (ha1r : |a1r| = ω1)
    (hb : |bij| ≤ Amax)
    (hci1 : |ci1| ≤ ω1) (hci2 : |ci2| ≤ ωr)
    (hcj1 : |cj1| ≤ ω1) (hcj2 : |cj2| ≤ ωr)
    (hωr_Amax : ωr ≤ Amax) :
    |higham11_4_twoByTwoSchurEntry bij ci1 ci2 cj1 cj2
        (arr / (a11 * arr - a1r ^ 2)) (-(a1r / (a11 * arr - a1r ^ 2)))
        (-(a1r / (a11 * arr - a1r ^ 2))) (a11 / (a11 * arr - a1r ^ 2))| ≤
      (1 + 2 / (1 - higham11_1_bunchParlettAlpha)) * Amax := by
  have hα_lt_one : higham11_1_bunchParlettAlpha < 1 := by
    simpa [higham11_1_bunchParlettAlpha] using bunch_parlett_alpha_lt_one
  have h1α_pos : 0 < 1 - higham11_1_bunchParlettAlpha := by
    linarith [hα_lt_one]
  have hcorr :
      |ci1 * ((arr / (a11 * arr - a1r ^ 2)) * cj1 +
            (-(a1r / (a11 * arr - a1r ^ 2))) * cj2) +
          ci2 * ((-(a1r / (a11 * arr - a1r ^ 2))) * cj1 +
            (a11 / (a11 * arr - a1r ^ 2)) * cj2)| ≤
        2 * ωr / (1 - higham11_1_bunchParlettAlpha) :=
    higham11_4_bunch_kaufman_case4_twoByTwo_schur_correction_bound
      ci1 ci2 cj1 cj2 a11 a1r arr ω1 ωr hω1 hcase ha1r hci1 hci2 hcj1 hcj2
  have hcoeff_nonneg :
      0 ≤ 2 / (1 - higham11_1_bunchParlettAlpha) :=
    div_nonneg (by norm_num) (le_of_lt h1α_pos)
  have hcorr_Amax :
      2 * ωr / (1 - higham11_1_bunchParlettAlpha) ≤
        2 * Amax / (1 - higham11_1_bunchParlettAlpha) := by
    calc
      2 * ωr / (1 - higham11_1_bunchParlettAlpha)
          = (2 / (1 - higham11_1_bunchParlettAlpha)) * ωr := by ring
      _ ≤ (2 / (1 - higham11_1_bunchParlettAlpha)) * Amax :=
          mul_le_mul_of_nonneg_left hωr_Amax hcoeff_nonneg
      _ = 2 * Amax / (1 - higham11_1_bunchParlettAlpha) := by ring
  unfold higham11_4_twoByTwoSchurEntry
  have htri :
      |bij -
          (ci1 * ((arr / (a11 * arr - a1r ^ 2)) * cj1 +
              (-(a1r / (a11 * arr - a1r ^ 2))) * cj2) +
            ci2 * ((-(a1r / (a11 * arr - a1r ^ 2))) * cj1 +
              (a11 / (a11 * arr - a1r ^ 2)) * cj2))|
        ≤
      |bij| +
        |ci1 * ((arr / (a11 * arr - a1r ^ 2)) * cj1 +
            (-(a1r / (a11 * arr - a1r ^ 2))) * cj2) +
          ci2 * ((-(a1r / (a11 * arr - a1r ^ 2))) * cj1 +
            (a11 / (a11 * arr - a1r ^ 2)) * cj2)| := by
    set corr :=
      ci1 * ((arr / (a11 * arr - a1r ^ 2)) * cj1 +
          (-(a1r / (a11 * arr - a1r ^ 2))) * cj2) +
        ci2 * ((-(a1r / (a11 * arr - a1r ^ 2))) * cj1 +
          (a11 / (a11 * arr - a1r ^ 2)) * cj2)
    have h := abs_add_le bij (-corr)
    calc
      |bij - corr| = |bij + -corr| := by rw [sub_eq_add_neg]
      _ ≤ |bij| + |-corr| := h
      _ = |bij| + |corr| := by rw [abs_neg]
  calc
    |bij -
        (ci1 * ((arr / (a11 * arr - a1r ^ 2)) * cj1 +
            (-(a1r / (a11 * arr - a1r ^ 2))) * cj2) +
          ci2 * ((-(a1r / (a11 * arr - a1r ^ 2))) * cj1 +
            (a11 / (a11 * arr - a1r ^ 2)) * cj2))|
        ≤
      |bij| +
        |ci1 * ((arr / (a11 * arr - a1r ^ 2)) * cj1 +
            (-(a1r / (a11 * arr - a1r ^ 2))) * cj2) +
          ci2 * ((-(a1r / (a11 * arr - a1r ^ 2))) * cj1 +
            (a11 / (a11 * arr - a1r ^ 2)) * cj2)| := htri
    _ ≤ Amax + 2 * Amax / (1 - higham11_1_bunchParlettAlpha) :=
        add_le_add hb (hcorr.trans hcorr_Amax)
    _ = (1 + 2 / (1 - higham11_1_bunchParlettAlpha)) * Amax := by
        ring

/-- **Theorem 11.4 / Algorithm 11.2 case-(4) source-factor growth bridge**:
the direct `2×2` Schur-growth estimate rewritten using Higham's balancing
identity, so a size-two pivot consumes two `1+α⁻¹` stage-growth steps. -/
theorem higham11_4_bunch_kaufman_case4_twoByTwo_schur_growth_source_factor_sq
    (bij ci1 ci2 cj1 cj2 a11 a1r arr ω1 ωr Amax : ℝ)
    (hω1 : 0 < ω1)
    (hcase : higham11_2_BunchKaufmanPartialPivotCase
      higham11_1_bunchParlettAlpha a11 arr ω1 ωr BunchKaufmanCase.case4)
    (ha1r : |a1r| = ω1)
    (hb : |bij| ≤ Amax)
    (hci1 : |ci1| ≤ ω1) (hci2 : |ci2| ≤ ωr)
    (hcj1 : |cj1| ≤ ω1) (hcj2 : |cj2| ≤ ωr)
    (hωr_Amax : ωr ≤ Amax) :
    |higham11_4_twoByTwoSchurEntry bij ci1 ci2 cj1 cj2
        (arr / (a11 * arr - a1r ^ 2)) (-(a1r / (a11 * arr - a1r ^ 2)))
        (-(a1r / (a11 * arr - a1r ^ 2))) (a11 / (a11 * arr - a1r ^ 2))| ≤
      (1 + higham11_1_bunchParlettAlpha⁻¹) ^ 2 * Amax := by
  calc
    |higham11_4_twoByTwoSchurEntry bij ci1 ci2 cj1 cj2
        (arr / (a11 * arr - a1r ^ 2)) (-(a1r / (a11 * arr - a1r ^ 2)))
        (-(a1r / (a11 * arr - a1r ^ 2))) (a11 / (a11 * arr - a1r ^ 2))|
        ≤ (1 + 2 / (1 - higham11_1_bunchParlettAlpha)) * Amax :=
          higham11_4_bunch_kaufman_case4_twoByTwo_schur_growth
            bij ci1 ci2 cj1 cj2 a11 a1r arr ω1 ωr Amax hω1 hcase ha1r
            hb hci1 hci2 hcj1 hcj2 hωr_Amax
    _ = (1 + higham11_1_bunchParlettAlpha⁻¹) ^ 2 * Amax := by
          rw [← higham11_1_growth_balance]
          ring

/-- **Theorem 11.4 / Algorithm 11.2 case-(4) asymmetric scaled multiplier
row-sum bound**: the direct inverse-entry estimates bound the two components of
`CE⁻¹` in their natural source scales, `ω1` for the column tied to the maximum
entry and `ωr` for the row-maximum column. -/
theorem higham11_4_bunch_kaufman_case4_twoByTwo_multiplier_row_sum_asymmetric_scaled_bound
    (c1 c2 a11 a1r arr ω1 ωr : ℝ)
    (hω1 : 0 < ω1)
    (hcase : higham11_2_BunchKaufmanPartialPivotCase
      higham11_1_bunchParlettAlpha a11 arr ω1 ωr BunchKaufmanCase.case4)
    (ha1r : |a1r| = ω1)
    (hc1 : |c1| ≤ ω1) (hc2 : |c2| ≤ ωr) :
    |c1 * (arr / (a11 * arr - a1r ^ 2)) +
        c2 * (-(a1r / (a11 * arr - a1r ^ 2)))| * ω1 +
      |c1 * (-(a1r / (a11 * arr - a1r ^ 2))) +
        c2 * (a11 / (a11 * arr - a1r ^ 2))| * ωr ≤
      2 * ωr / (1 - higham11_1_bunchParlettAlpha) := by
  obtain ⟨hf11_scaled, hf12_scaled, hf22_scaled⟩ :=
    higham11_4_bunch_kaufman_case4_twoByTwo_inverse_scaled_bounds
      a11 a1r arr ω1 ωr hω1 hcase ha1r
  have hα_pos : 0 < higham11_1_bunchParlettAlpha := by
    simpa [higham11_1_bunchParlettAlpha] using bunch_parlett_alpha_pos
  have hα_nonneg : 0 ≤ higham11_1_bunchParlettAlpha := le_of_lt hα_pos
  have hα_lt_one : higham11_1_bunchParlettAlpha < 1 := by
    simpa [higham11_1_bunchParlettAlpha] using bunch_parlett_alpha_lt_one
  have hα_sq_lt_one : higham11_1_bunchParlettAlpha ^ 2 < 1 := by
    nlinarith [hα_nonneg, hα_lt_one]
  have hden_pos : 0 < 1 - higham11_1_bunchParlettAlpha ^ 2 := by
    linarith [hα_sq_lt_one]
  have h1α_pos : 0 < 1 - higham11_1_bunchParlettAlpha := by
    linarith [hα_lt_one]
  have hω1_nonneg : 0 ≤ ω1 := le_of_lt hω1
  have hωr_nonneg : 0 ≤ ωr := le_trans (abs_nonneg c2) hc2
  have hf12_scaled_neg :
      |-(a1r / (a11 * arr - a1r ^ 2))| * (ω1 * ωr) ≤
        ωr / (1 - higham11_1_bunchParlettAlpha ^ 2) := by
    simpa [abs_neg] using hf12_scaled
  have ht11 :
      |c1 * (arr / (a11 * arr - a1r ^ 2))| * ω1 ≤
        higham11_1_bunchParlettAlpha * ωr /
          (1 - higham11_1_bunchParlettAlpha ^ 2) := by
    have hprod : |c1 * (arr / (a11 * arr - a1r ^ 2))| ≤
        ω1 * |arr / (a11 * arr - a1r ^ 2)| := by
      rw [abs_mul]
      exact mul_le_mul hc1 le_rfl (abs_nonneg _) hω1_nonneg
    calc
      |c1 * (arr / (a11 * arr - a1r ^ 2))| * ω1
          ≤ (ω1 * |arr / (a11 * arr - a1r ^ 2)|) * ω1 :=
            mul_le_mul_of_nonneg_right hprod hω1_nonneg
      _ = |arr / (a11 * arr - a1r ^ 2)| * ω1 ^ 2 := by ring
      _ ≤ higham11_1_bunchParlettAlpha * ωr /
          (1 - higham11_1_bunchParlettAlpha ^ 2) := hf11_scaled
  have ht12 :
      |c2 * (-(a1r / (a11 * arr - a1r ^ 2)))| * ω1 ≤
        ωr / (1 - higham11_1_bunchParlettAlpha ^ 2) := by
    have hprod : |c2 * (-(a1r / (a11 * arr - a1r ^ 2)))| ≤
        ωr * |-(a1r / (a11 * arr - a1r ^ 2))| := by
      rw [abs_mul]
      exact mul_le_mul hc2 le_rfl (abs_nonneg _) hωr_nonneg
    calc
      |c2 * (-(a1r / (a11 * arr - a1r ^ 2)))| * ω1
          ≤ (ωr * |-(a1r / (a11 * arr - a1r ^ 2))|) * ω1 :=
            mul_le_mul_of_nonneg_right hprod hω1_nonneg
      _ = |-(a1r / (a11 * arr - a1r ^ 2))| * (ω1 * ωr) := by ring
      _ ≤ ωr / (1 - higham11_1_bunchParlettAlpha ^ 2) := hf12_scaled_neg
  have ht21 :
      |c1 * (-(a1r / (a11 * arr - a1r ^ 2)))| * ωr ≤
        ωr / (1 - higham11_1_bunchParlettAlpha ^ 2) := by
    have hprod : |c1 * (-(a1r / (a11 * arr - a1r ^ 2)))| ≤
        ω1 * |-(a1r / (a11 * arr - a1r ^ 2))| := by
      rw [abs_mul]
      exact mul_le_mul hc1 le_rfl (abs_nonneg _) hω1_nonneg
    calc
      |c1 * (-(a1r / (a11 * arr - a1r ^ 2)))| * ωr
          ≤ (ω1 * |-(a1r / (a11 * arr - a1r ^ 2))|) * ωr :=
            mul_le_mul_of_nonneg_right hprod hωr_nonneg
      _ = |-(a1r / (a11 * arr - a1r ^ 2))| * (ω1 * ωr) := by ring
      _ ≤ ωr / (1 - higham11_1_bunchParlettAlpha ^ 2) := hf12_scaled_neg
  have ht22 :
      |c2 * (a11 / (a11 * arr - a1r ^ 2))| * ωr ≤
        higham11_1_bunchParlettAlpha * ωr /
          (1 - higham11_1_bunchParlettAlpha ^ 2) := by
    have hprod : |c2 * (a11 / (a11 * arr - a1r ^ 2))| ≤
        ωr * |a11 / (a11 * arr - a1r ^ 2)| := by
      rw [abs_mul]
      exact mul_le_mul hc2 le_rfl (abs_nonneg _) hωr_nonneg
    calc
      |c2 * (a11 / (a11 * arr - a1r ^ 2))| * ωr
          ≤ (ωr * |a11 / (a11 * arr - a1r ^ 2)|) * ωr :=
            mul_le_mul_of_nonneg_right hprod hωr_nonneg
      _ = |a11 / (a11 * arr - a1r ^ 2)| * ωr ^ 2 := by ring
      _ ≤ higham11_1_bunchParlettAlpha * ωr /
          (1 - higham11_1_bunchParlettAlpha ^ 2) := hf22_scaled
  have hcomp1 :
      |c1 * (arr / (a11 * arr - a1r ^ 2)) +
          c2 * (-(a1r / (a11 * arr - a1r ^ 2)))| * ω1 ≤
        higham11_1_bunchParlettAlpha * ωr /
            (1 - higham11_1_bunchParlettAlpha ^ 2) +
          ωr / (1 - higham11_1_bunchParlettAlpha ^ 2) := by
    calc
      |c1 * (arr / (a11 * arr - a1r ^ 2)) +
          c2 * (-(a1r / (a11 * arr - a1r ^ 2)))| * ω1
          ≤ (|c1 * (arr / (a11 * arr - a1r ^ 2))| +
              |c2 * (-(a1r / (a11 * arr - a1r ^ 2)))|) * ω1 :=
            mul_le_mul_of_nonneg_right (abs_add_le _ _) hω1_nonneg
      _ = |c1 * (arr / (a11 * arr - a1r ^ 2))| * ω1 +
          |c2 * (-(a1r / (a11 * arr - a1r ^ 2)))| * ω1 := by ring
      _ ≤ higham11_1_bunchParlettAlpha * ωr /
            (1 - higham11_1_bunchParlettAlpha ^ 2) +
          ωr / (1 - higham11_1_bunchParlettAlpha ^ 2) := add_le_add ht11 ht12
  have hcomp2 :
      |c1 * (-(a1r / (a11 * arr - a1r ^ 2))) +
          c2 * (a11 / (a11 * arr - a1r ^ 2))| * ωr ≤
        ωr / (1 - higham11_1_bunchParlettAlpha ^ 2) +
          higham11_1_bunchParlettAlpha * ωr /
            (1 - higham11_1_bunchParlettAlpha ^ 2) := by
    calc
      |c1 * (-(a1r / (a11 * arr - a1r ^ 2))) +
          c2 * (a11 / (a11 * arr - a1r ^ 2))| * ωr
          ≤ (|c1 * (-(a1r / (a11 * arr - a1r ^ 2)))| +
              |c2 * (a11 / (a11 * arr - a1r ^ 2))|) * ωr :=
            mul_le_mul_of_nonneg_right (abs_add_le _ _) hωr_nonneg
      _ = |c1 * (-(a1r / (a11 * arr - a1r ^ 2)))| * ωr +
          |c2 * (a11 / (a11 * arr - a1r ^ 2))| * ωr := by ring
      _ ≤ ωr / (1 - higham11_1_bunchParlettAlpha ^ 2) +
          higham11_1_bunchParlettAlpha * ωr /
            (1 - higham11_1_bunchParlettAlpha ^ 2) := add_le_add ht21 ht22
  calc
    |c1 * (arr / (a11 * arr - a1r ^ 2)) +
        c2 * (-(a1r / (a11 * arr - a1r ^ 2)))| * ω1 +
      |c1 * (-(a1r / (a11 * arr - a1r ^ 2))) +
        c2 * (a11 / (a11 * arr - a1r ^ 2))| * ωr
        ≤
      (higham11_1_bunchParlettAlpha * ωr /
            (1 - higham11_1_bunchParlettAlpha ^ 2) +
          ωr / (1 - higham11_1_bunchParlettAlpha ^ 2)) +
        (ωr / (1 - higham11_1_bunchParlettAlpha ^ 2) +
          higham11_1_bunchParlettAlpha * ωr /
            (1 - higham11_1_bunchParlettAlpha ^ 2)) := add_le_add hcomp1 hcomp2
    _ ≤
      (higham11_1_bunchParlettAlpha * ωr /
            (1 - higham11_1_bunchParlettAlpha ^ 2) +
          ωr / (1 - higham11_1_bunchParlettAlpha ^ 2)) +
        (ωr / (1 - higham11_1_bunchParlettAlpha ^ 2) +
          higham11_1_bunchParlettAlpha * ωr /
            (1 - higham11_1_bunchParlettAlpha ^ 2)) := le_rfl
    _ = 2 * ωr / (1 - higham11_1_bunchParlettAlpha) := by
          field_simp [ne_of_gt hden_pos, ne_of_gt h1α_pos]
          ring

/-- **Theorem 11.4 / Algorithm 11.2 case-(4) pivot-entry caps**: the printed
case-(4) tests bound the accepted `2 × 2` pivot entries in their natural
`ω1`/`ωr` source scales. -/
theorem higham11_4_bunch_kaufman_case4_twoByTwo_pivot_entry_bounds
    (a11 a1r arr ω1 ωr : ℝ)
    (hω1 : 0 < ω1)
    (hcase : higham11_2_BunchKaufmanPartialPivotCase
      higham11_1_bunchParlettAlpha a11 arr ω1 ωr BunchKaufmanCase.case4)
    (ha1r : |a1r| = ω1) :
    |a11| ≤ ω1 ∧ |a1r| ≤ ω1 ∧ |arr| ≤ ωr := by
  rcases higham11_2_bunch_kaufman_case4_tests
      higham11_1_bunchParlettAlpha a11 arr ω1 ωr hcase with
    ⟨_, ha11_lt, _, harr_lt⟩
  have hα_pos : 0 < higham11_1_bunchParlettAlpha := by
    simpa [higham11_1_bunchParlettAlpha] using bunch_parlett_alpha_pos
  have hα_lt_one : higham11_1_bunchParlettAlpha < 1 := by
    simpa [higham11_1_bunchParlettAlpha] using bunch_parlett_alpha_lt_one
  have hα_le_one : higham11_1_bunchParlettAlpha ≤ 1 := le_of_lt hα_lt_one
  have hω1_nonneg : 0 ≤ ω1 := le_of_lt hω1
  have hωr_pos : 0 < ωr := by
    have hαωr_pos : 0 < higham11_1_bunchParlettAlpha * ωr :=
      lt_of_le_of_lt (abs_nonneg arr) harr_lt
    nlinarith [hα_pos, hαωr_pos]
  have hωr_nonneg : 0 ≤ ωr := le_of_lt hωr_pos
  have ha11_le : |a11| ≤ ω1 := by
    calc
      |a11| ≤ higham11_1_bunchParlettAlpha * ω1 := le_of_lt ha11_lt
      _ ≤ 1 * ω1 := mul_le_mul_of_nonneg_right hα_le_one hω1_nonneg
      _ = ω1 := by ring
  have ha1r_le : |a1r| ≤ ω1 := by
    rw [ha1r]
  have harr_le : |arr| ≤ ωr := by
    calc
      |arr| ≤ higham11_1_bunchParlettAlpha * ωr := le_of_lt harr_lt
      _ ≤ 1 * ωr := mul_le_mul_of_nonneg_right hα_le_one hωr_nonneg
      _ = ωr := by ring
  exact ⟨ha11_le, ha1r_le, harr_le⟩

/-- **Theorem 11.4 / Algorithm 11.2 case-(4) local `D̂` cap**: if the
current stage majorant bounds both source maxima `ω1` and `ωr`, then every
entry of the accepted `2 × 2` pivot block is bounded by that majorant. -/
theorem higham11_4_bunch_kaufman_case4_twoByTwo_pivot_entries_le_Amax
    (a11 a1r arr ω1 ωr Amax : ℝ)
    (hω1 : 0 < ω1)
    (hcase : higham11_2_BunchKaufmanPartialPivotCase
      higham11_1_bunchParlettAlpha a11 arr ω1 ωr BunchKaufmanCase.case4)
    (ha1r : |a1r| = ω1)
    (hω1_Amax : ω1 ≤ Amax) (hωr_Amax : ωr ≤ Amax) :
    |a11| ≤ Amax ∧ |a1r| ≤ Amax ∧ |arr| ≤ Amax := by
  rcases higham11_4_bunch_kaufman_case4_twoByTwo_pivot_entry_bounds
      a11 a1r arr ω1 ωr hω1 hcase ha1r with
    ⟨ha11_le, ha1r_le, harr_le⟩
  exact ⟨ha11_le.trans hω1_Amax, ha1r_le.trans hω1_Amax,
    harr_le.trans hωr_Amax⟩

/-- The symmetric `2 × 2` pivot block used by Algorithm 11.2 case-(4),
written as a concrete `Fin 2` matrix. -/
def higham11_4_twoByTwoPivotBlock (a11 a1r arr : ℝ) :
    Fin 2 → Fin 2 → ℝ :=
  fun i j =>
    if i = 0 then
      if j = 0 then a11 else a1r
    else
      if j = 0 then a1r else arr

/-- **Theorem 11.4 / Algorithm 11.2 case-(4) local pivot-block `D̂` cap**:
the scalar pivot-entry caps bound every entry of the concrete `2 × 2` pivot
block. -/
theorem higham11_4_bunch_kaufman_case4_twoByTwo_pivotBlock_entries_le_Amax
    (a11 a1r arr ω1 ωr Amax : ℝ)
    (hω1 : 0 < ω1)
    (hcase : higham11_2_BunchKaufmanPartialPivotCase
      higham11_1_bunchParlettAlpha a11 arr ω1 ωr BunchKaufmanCase.case4)
    (ha1r : |a1r| = ω1)
    (hω1_Amax : ω1 ≤ Amax) (hωr_Amax : ωr ≤ Amax) :
    ∀ i j : Fin 2, |higham11_4_twoByTwoPivotBlock a11 a1r arr i j| ≤ Amax := by
  rcases higham11_4_bunch_kaufman_case4_twoByTwo_pivot_entries_le_Amax
      a11 a1r arr ω1 ωr Amax hω1 hcase ha1r hω1_Amax hωr_Amax with
    ⟨ha11_le, ha1r_le, harr_le⟩
  intro i j
  fin_cases i <;> fin_cases j <;>
    simp [higham11_4_twoByTwoPivotBlock, ha11_le, ha1r_le, harr_le]

/-- **Theorem 11.4 / Algorithm 11.2 case-(4) local `2 × 2` cap package**.
Under the same concrete row-maximum dominance used by the source-six `CE⁻¹`
row cap, the accepted pivot block also carries the concrete `D̂` entry cap.
This is the case-(4) counterpart of the scalar branch row/`D̂` cap packages
used by the first-stage split route toward the product bound. -/
theorem higham11_4_bunch_kaufman_case4_twoByTwo_row_sum_and_D_cap_of_row_max_le
    (c1 c2 a11 a1r arr ω1 ωr K Amax : ℝ)
    (hω1 : 0 < ω1) (hωr_le : ωr ≤ ω1)
    (hcase : higham11_2_BunchKaufmanPartialPivotCase
      higham11_1_bunchParlettAlpha a11 arr ω1 ωr BunchKaufmanCase.case4)
    (ha1r : |a1r| = ω1)
    (hK : (1 - higham11_1_bunchParlettAlpha ^ 2) * ω1 * K = 1)
    (hc1 : |c1| ≤ ω1) (hc2 : |c2| ≤ ω1)
    (hω1_Amax : ω1 ≤ Amax) (hωr_Amax : ωr ≤ Amax) :
    (|c1 * (arr / (a11 * arr - a1r ^ 2)) +
        c2 * (-(a1r / (a11 * arr - a1r ^ 2)))| +
      |c1 * (-(a1r / (a11 * arr - a1r ^ 2))) +
        c2 * (a11 / (a11 * arr - a1r ^ 2))| ≤ 6) ∧
      (∀ i j : Fin 2, |higham11_4_twoByTwoPivotBlock a11 a1r arr i j| ≤ Amax) := by
  refine ⟨?_, ?_⟩
  · exact
      higham11_4_bunch_kaufman_case4_twoByTwo_multiplier_row_sum_le_six_of_row_max_le
        c1 c2 a11 a1r arr ω1 ωr K hω1 hωr_le hcase ha1r hK hc1 hc2
  · exact
      higham11_4_bunch_kaufman_case4_twoByTwo_pivotBlock_entries_le_Amax
        a11 a1r arr ω1 ωr Amax hω1 hcase ha1r hω1_Amax hωr_Amax

/-- **Theorem 11.4 / Algorithm 11.2 case-(1) local producer package**:
the scalar `a₁₁` branch simultaneously supplies the normalized Schur-growth
step, the source-six multiplier row cap, and the accepted scalar `D̂` cap. -/
theorem higham11_4_bunch_kaufman_case1_local_growth_row_sum_and_D_cap
    (b ci cj a11 arr ω1 ωr c Amax : ℝ) (hω1 : 0 < ω1)
    (hcase : higham11_2_BunchKaufmanPartialPivotCase
      higham11_1_bunchParlettAlpha a11 arr ω1 ωr BunchKaufmanCase.case1)
    (hb : |b| ≤ Amax) (hci : |ci| ≤ ω1) (hcj : |cj| ≤ ω1)
    (hω1_Amax : ω1 ≤ Amax) (hc : |c| ≤ ω1) (ha11_Amax : |a11| ≤ Amax) :
    |b - ci * cj / a11| ≤
        (1 + higham11_1_bunchParlettAlpha⁻¹) * Amax ∧
      |c / a11| ≤ 6 ∧ |a11| ≤ Amax := by
  refine ⟨?_, ?_⟩
  · exact
      higham11_4_bunch_kaufman_case1_schur_growth_source_factor
        b ci cj a11 arr ω1 ωr Amax hω1 hcase hb hci hcj hω1_Amax
  · exact
      higham11_4_bunch_kaufman_case1_scalar_row_sum_and_D_cap
        a11 arr ω1 ωr c Amax hω1 hcase hc ha11_Amax

/-- **Theorem 11.4 / Algorithm 11.2 case-(2) local producer package**:
with the concrete row-maximum side condition, the `a₁₁` branch supplies the
Schur-growth step, source-six multiplier row cap, and local scalar `D̂` cap. -/
theorem higham11_4_bunch_kaufman_case2_local_growth_row_sum_and_D_cap_of_row_max_le
    (b ci cj a11 arr ω1 ωr c Amax : ℝ) (hω1 : 0 < ω1) (hωr_le : ωr ≤ ω1)
    (hcase : higham11_2_BunchKaufmanPartialPivotCase
      higham11_1_bunchParlettAlpha a11 arr ω1 ωr BunchKaufmanCase.case2)
    (hb : |b| ≤ Amax) (hci : |ci| ≤ ω1) (hcj : |cj| ≤ ω1)
    (hω1_Amax : ω1 ≤ Amax) (hc : |c| ≤ ω1) :
    |b - ci * cj / a11| ≤
        (1 + higham11_1_bunchParlettAlpha⁻¹) * Amax ∧
      |c / a11| ≤ 6 ∧ |a11| ≤ Amax := by
  refine ⟨?_, ?_⟩
  · exact
      higham11_4_bunch_kaufman_case2_schur_growth_source_factor
        b ci cj a11 arr ω1 ωr Amax hω1 hcase hb hci hcj
        (hωr_le.trans hω1_Amax)
  · exact
      higham11_4_bunch_kaufman_case2_scalar_row_sum_and_D_cap_of_row_max_le
        a11 arr ω1 ωr c Amax hω1 hωr_le hcase hc hω1_Amax

/-- **Theorem 11.4 / Algorithm 11.2 case-(3) local producer package**:
after the symmetric swap, the accepted `aᵣᵣ` scalar branch supplies the
Schur-growth step, source-six multiplier row cap, and local scalar `D̂` cap. -/
theorem higham11_4_bunch_kaufman_case3_local_growth_row_sum_and_D_cap
    (b ci cj a11 arr ω1 ωr c Amax : ℝ) (hωr : 0 < ωr)
    (hcase : higham11_2_BunchKaufmanPartialPivotCase
      higham11_1_bunchParlettAlpha a11 arr ω1 ωr BunchKaufmanCase.case3)
    (hb : |b| ≤ Amax) (hci : |ci| ≤ ωr) (hcj : |cj| ≤ ωr)
    (hωr_Amax : ωr ≤ Amax) (hc : |c| ≤ ωr) (harr_Amax : |arr| ≤ Amax) :
    |b - ci * cj / arr| ≤
        (1 + higham11_1_bunchParlettAlpha⁻¹) * Amax ∧
      |c / arr| ≤ 6 ∧ |arr| ≤ Amax := by
  refine ⟨?_, ?_⟩
  · exact
      higham11_4_bunch_kaufman_case3_schur_growth_source_factor
        b ci cj a11 arr ω1 ωr Amax hωr hcase hb hci hcj hωr_Amax
  · exact
      higham11_4_bunch_kaufman_case3_scalar_row_sum_and_D_cap
        a11 arr ω1 ωr c Amax hωr hcase hc harr_Amax

/-- **Theorem 11.4 / Algorithm 11.2 case-(4) local producer package**:
under the concrete row-maximum dominance used by the source-six `CE⁻¹` row
cap, the accepted `2 × 2` branch supplies the two-step normalized growth
bound, the source-six multiplier row cap for one multiplier row, and the local
`D̂` pivot-block entry cap. -/
theorem higham11_4_bunch_kaufman_case4_twoByTwo_local_growth_row_sum_and_D_cap_of_row_max_le
    (bij ci1 ci2 cj1 cj2 a11 a1r arr ω1 ωr K Amax : ℝ)
    (hω1 : 0 < ω1) (hωr_le : ωr ≤ ω1)
    (hcase : higham11_2_BunchKaufmanPartialPivotCase
      higham11_1_bunchParlettAlpha a11 arr ω1 ωr BunchKaufmanCase.case4)
    (ha1r : |a1r| = ω1)
    (hK : (1 - higham11_1_bunchParlettAlpha ^ 2) * ω1 * K = 1)
    (hb : |bij| ≤ Amax)
    (hci1 : |ci1| ≤ ω1) (hci2 : |ci2| ≤ ωr)
    (hcj1 : |cj1| ≤ ω1) (hcj2 : |cj2| ≤ ωr)
    (hωr_Amax : ωr ≤ Amax) (hω1_Amax : ω1 ≤ Amax) :
    |higham11_4_twoByTwoSchurEntry bij ci1 ci2 cj1 cj2
        (arr / (a11 * arr - a1r ^ 2)) (-(a1r / (a11 * arr - a1r ^ 2)))
        (-(a1r / (a11 * arr - a1r ^ 2))) (a11 / (a11 * arr - a1r ^ 2))| ≤
        (1 + higham11_1_bunchParlettAlpha⁻¹) ^ 2 * Amax ∧
      (|ci1 * (arr / (a11 * arr - a1r ^ 2)) +
          ci2 * (-(a1r / (a11 * arr - a1r ^ 2)))| +
        |ci1 * (-(a1r / (a11 * arr - a1r ^ 2))) +
          ci2 * (a11 / (a11 * arr - a1r ^ 2))| ≤ 6) ∧
      (∀ i j : Fin 2, |higham11_4_twoByTwoPivotBlock a11 a1r arr i j| ≤ Amax) := by
  refine ⟨?_, ?_⟩
  · exact
      higham11_4_bunch_kaufman_case4_twoByTwo_schur_growth_source_factor_sq
        bij ci1 ci2 cj1 cj2 a11 a1r arr ω1 ωr Amax hω1 hcase ha1r
        hb hci1 hci2 hcj1 hcj2 hωr_Amax
  · exact
      higham11_4_bunch_kaufman_case4_twoByTwo_row_sum_and_D_cap_of_row_max_le
        ci1 ci2 a11 a1r arr ω1 ωr K Amax hω1 hωr_le hcase ha1r hK
        hci1 (hci2.trans hωr_le) hω1_Amax hωr_Amax

/-- **Theorem 11.4 / Algorithm 11.2 case-(4) two-row local producer package**:
under the concrete row-maximum dominance used by the source-six `CE⁻¹` cap,
the accepted `2 × 2` branch supplies the two-step normalized growth bound,
source-six row caps for both multiplier rows participating in the Schur update,
and the local `D̂` pivot-block entry cap. -/
theorem higham11_4_bunch_kaufman_case4_twoByTwo_local_growth_two_row_sums_and_D_cap_of_row_max_le
    (bij ci1 ci2 cj1 cj2 a11 a1r arr ω1 ωr K Amax : ℝ)
    (hω1 : 0 < ω1) (hωr_le : ωr ≤ ω1)
    (hcase : higham11_2_BunchKaufmanPartialPivotCase
      higham11_1_bunchParlettAlpha a11 arr ω1 ωr BunchKaufmanCase.case4)
    (ha1r : |a1r| = ω1)
    (hK : (1 - higham11_1_bunchParlettAlpha ^ 2) * ω1 * K = 1)
    (hb : |bij| ≤ Amax)
    (hci1 : |ci1| ≤ ω1) (hci2 : |ci2| ≤ ωr)
    (hcj1 : |cj1| ≤ ω1) (hcj2 : |cj2| ≤ ωr)
    (hωr_Amax : ωr ≤ Amax) (hω1_Amax : ω1 ≤ Amax) :
    |higham11_4_twoByTwoSchurEntry bij ci1 ci2 cj1 cj2
        (arr / (a11 * arr - a1r ^ 2)) (-(a1r / (a11 * arr - a1r ^ 2)))
        (-(a1r / (a11 * arr - a1r ^ 2))) (a11 / (a11 * arr - a1r ^ 2))| ≤
        (1 + higham11_1_bunchParlettAlpha⁻¹) ^ 2 * Amax ∧
      (|ci1 * (arr / (a11 * arr - a1r ^ 2)) +
          ci2 * (-(a1r / (a11 * arr - a1r ^ 2)))| +
        |ci1 * (-(a1r / (a11 * arr - a1r ^ 2))) +
          ci2 * (a11 / (a11 * arr - a1r ^ 2))| ≤ 6) ∧
      (|cj1 * (arr / (a11 * arr - a1r ^ 2)) +
          cj2 * (-(a1r / (a11 * arr - a1r ^ 2)))| +
        |cj1 * (-(a1r / (a11 * arr - a1r ^ 2))) +
          cj2 * (a11 / (a11 * arr - a1r ^ 2))| ≤ 6) ∧
      (∀ i j : Fin 2, |higham11_4_twoByTwoPivotBlock a11 a1r arr i j| ≤ Amax) := by
  rcases
      higham11_4_bunch_kaufman_case4_twoByTwo_local_growth_row_sum_and_D_cap_of_row_max_le
        bij ci1 ci2 cj1 cj2 a11 a1r arr ω1 ωr K Amax hω1 hωr_le
        hcase ha1r hK hb hci1 hci2 hcj1 hcj2 hωr_Amax hω1_Amax with
    ⟨hgrowth, hrow_i, hD⟩
  refine ⟨hgrowth, ?_⟩
  refine ⟨hrow_i, ?_⟩
  refine ⟨?_, hD⟩
  exact
    higham11_4_bunch_kaufman_case4_twoByTwo_multiplier_row_sum_le_six_of_row_max_le
      cj1 cj2 a11 a1r arr ω1 ωr K hω1 hωr_le hcase ha1r hK
      hcj1 (hcj2.trans hωr_le)

/-- **Theorem 11.4 / Algorithm 11.2 case-(4) natural-scale local producer
package**: the accepted `2 × 2` branch supplies the two-step normalized
Schur-growth bound, the weighted source-scale `CE⁻¹` row bound, and the local
`D̂` pivot-block entry cap without requiring the extra `ωr ≤ ω1` row-maximum
relaxation used by the source-six row-sum form. -/
theorem higham11_4_bunch_kaufman_case4_twoByTwo_local_growth_weighted_row_sum_and_D_cap
    (bij ci1 ci2 cj1 cj2 a11 a1r arr ω1 ωr Amax : ℝ)
    (hω1 : 0 < ω1)
    (hcase : higham11_2_BunchKaufmanPartialPivotCase
      higham11_1_bunchParlettAlpha a11 arr ω1 ωr BunchKaufmanCase.case4)
    (ha1r : |a1r| = ω1)
    (hb : |bij| ≤ Amax)
    (hci1 : |ci1| ≤ ω1) (hci2 : |ci2| ≤ ωr)
    (hcj1 : |cj1| ≤ ω1) (hcj2 : |cj2| ≤ ωr)
    (hωr_Amax : ωr ≤ Amax) (hω1_Amax : ω1 ≤ Amax) :
    |higham11_4_twoByTwoSchurEntry bij ci1 ci2 cj1 cj2
        (arr / (a11 * arr - a1r ^ 2)) (-(a1r / (a11 * arr - a1r ^ 2)))
        (-(a1r / (a11 * arr - a1r ^ 2))) (a11 / (a11 * arr - a1r ^ 2))| ≤
        (1 + higham11_1_bunchParlettAlpha⁻¹) ^ 2 * Amax ∧
      (|ci1 * (arr / (a11 * arr - a1r ^ 2)) +
          ci2 * (-(a1r / (a11 * arr - a1r ^ 2)))| * ω1 +
        |ci1 * (-(a1r / (a11 * arr - a1r ^ 2))) +
          ci2 * (a11 / (a11 * arr - a1r ^ 2))| * ωr ≤
          2 * ωr / (1 - higham11_1_bunchParlettAlpha)) ∧
      (∀ i j : Fin 2, |higham11_4_twoByTwoPivotBlock a11 a1r arr i j| ≤ Amax) := by
  refine ⟨?_, ?_⟩
  · exact
      higham11_4_bunch_kaufman_case4_twoByTwo_schur_growth_source_factor_sq
        bij ci1 ci2 cj1 cj2 a11 a1r arr ω1 ωr Amax hω1 hcase ha1r
        hb hci1 hci2 hcj1 hcj2 hωr_Amax
  · refine ⟨?_, ?_⟩
    · exact
        higham11_4_bunch_kaufman_case4_twoByTwo_multiplier_row_sum_asymmetric_scaled_bound
          ci1 ci2 a11 a1r arr ω1 ωr hω1 hcase ha1r hci1 hci2
    · exact
        higham11_4_bunch_kaufman_case4_twoByTwo_pivotBlock_entries_le_Amax
          a11 a1r arr ω1 ωr Amax hω1 hcase ha1r hω1_Amax hωr_Amax

/-- **Theorem 11.4 / Algorithm 11.2 cases-(1)/(2) local producer dispatch**:
the two branches that accept the leading scalar pivot `a₁₁` share the same
growth, source-six row-cap, and scalar `D̂` cap package.  Case-(2) still
consumes the explicit row-maximum side condition used by its multiplier lower
bound. -/
theorem higham11_4_bunch_kaufman_case1_or_case2_local_growth_row_sum_and_D_cap_of_row_max_le
    (b ci cj a11 arr ω1 ωr c Amax : ℝ) (hω1 : 0 < ω1) (hωr_le : ωr ≤ ω1)
    (hcase :
      higham11_2_BunchKaufmanPartialPivotCase
        higham11_1_bunchParlettAlpha a11 arr ω1 ωr BunchKaufmanCase.case1 ∨
      higham11_2_BunchKaufmanPartialPivotCase
        higham11_1_bunchParlettAlpha a11 arr ω1 ωr BunchKaufmanCase.case2)
    (hb : |b| ≤ Amax) (hci : |ci| ≤ ω1) (hcj : |cj| ≤ ω1)
    (hω1_Amax : ω1 ≤ Amax) (hc : |c| ≤ ω1) (ha11_Amax : |a11| ≤ Amax) :
    |b - ci * cj / a11| ≤
        (1 + higham11_1_bunchParlettAlpha⁻¹) * Amax ∧
      |c / a11| ≤ 6 ∧ |a11| ≤ Amax := by
  refine ⟨?_, ?_⟩
  · exact
      higham11_4_bunch_kaufman_case1_or_case2_schur_growth_source_factor_of_row_max_le
        b ci cj a11 arr ω1 ωr Amax hω1 hωr_le hcase hb hci hcj hω1_Amax
  · exact
      higham11_4_bunch_kaufman_case1_or_case2_scalar_row_sum_and_D_cap_of_row_max_le
        a11 arr ω1 ωr c Amax hω1 hωr_le hcase hc hω1_Amax ha11_Amax

/-- **Theorem 11.4 / Algorithm 11.2 case-(4) determinant bridge**: with the
same explicit row-maximum dominance needed by the local case-(4) `2 × 2`
bridges, the accepted pivot block has the standard determinant lower bound. -/
theorem higham11_4_bunch_kaufman_case4_twoByTwo_absdet_lower_of_row_max_le
    (a11 a1r arr ω1 ωr : ℝ)
    (hω1 : 0 < ω1) (hωr_le : ωr ≤ ω1)
    (hcase : higham11_2_BunchKaufmanPartialPivotCase
      higham11_1_bunchParlettAlpha a11 arr ω1 ωr BunchKaufmanCase.case4)
    (ha1r : |a1r| = ω1) :
    (1 - higham11_1_bunchParlettAlpha ^ 2) * ω1 ^ 2 ≤
      |a11 * arr - a1r ^ 2| := by
  rcases higham11_2_bunch_kaufman_case4_tests
      higham11_1_bunchParlettAlpha a11 arr ω1 ωr hcase with
    ⟨_, ha11_lt, _, harr_lt⟩
  have hα_pos : 0 < higham11_1_bunchParlettAlpha := by
    simpa [higham11_1_bunchParlettAlpha] using bunch_parlett_alpha_pos
  have hα_nonneg : 0 ≤ higham11_1_bunchParlettAlpha := le_of_lt hα_pos
  have hα_lt_one : higham11_1_bunchParlettAlpha < 1 := by
    simpa [higham11_1_bunchParlettAlpha] using bunch_parlett_alpha_lt_one
  have hμ1_nonneg : 0 ≤ higham11_1_bunchParlettAlpha * ω1 :=
    mul_nonneg hα_nonneg (le_of_lt hω1)
  have he11 : |a11| ≤ higham11_1_bunchParlettAlpha * ω1 :=
    le_of_lt ha11_lt
  have he22 : |arr| ≤ higham11_1_bunchParlettAlpha * ω1 := by
    have harr_le : |arr| ≤ higham11_1_bunchParlettAlpha * ωr :=
      le_of_lt harr_lt
    exact harr_le.trans (mul_le_mul_of_nonneg_left hωr_le hα_nonneg)
  have he21 : a1r ^ 2 = ω1 ^ 2 := by
    calc
      a1r ^ 2 = |a1r| ^ 2 := by rw [sq_abs]
      _ = ω1 ^ 2 := by rw [ha1r]
  exact
    higham11_4_twoByTwo_absdet_lower
      a11 arr a1r ω1 (higham11_1_bunchParlettAlpha * ω1)
      higham11_1_bunchParlettAlpha hμ1_nonneg hα_nonneg hα_lt_one
      he11 he22 he21 le_rfl

/-- **Theorem 11.4 / Algorithm 11.2 case-(4) nonsingularity bridge**: the
case-(4) pivot block is nonsingular once the concrete pivot path supplies the
row-maximum dominance used in the determinant bound. -/
theorem higham11_4_bunch_kaufman_case4_twoByTwo_det_ne_zero_of_row_max_le
    (a11 a1r arr ω1 ωr : ℝ)
    (hω1 : 0 < ω1) (hωr_le : ωr ≤ ω1)
    (hcase : higham11_2_BunchKaufmanPartialPivotCase
      higham11_1_bunchParlettAlpha a11 arr ω1 ωr BunchKaufmanCase.case4)
    (ha1r : |a1r| = ω1) :
    a11 * arr - a1r ^ 2 ≠ 0 := by
  have hα_nonneg : 0 ≤ higham11_1_bunchParlettAlpha := by
    exact le_of_lt (by simpa [higham11_1_bunchParlettAlpha] using bunch_parlett_alpha_pos)
  have hα_lt_one : higham11_1_bunchParlettAlpha < 1 := by
    simpa [higham11_1_bunchParlettAlpha] using bunch_parlett_alpha_lt_one
  have hα_sq_lt_one : higham11_1_bunchParlettAlpha ^ 2 < 1 := by
    nlinarith [hα_nonneg, hα_lt_one]
  have hωsq_pos : 0 < ω1 ^ 2 := sq_pos_of_ne_zero (ne_of_gt hω1)
  have hscale_pos : 0 < (1 - higham11_1_bunchParlettAlpha ^ 2) * ω1 ^ 2 :=
    mul_pos (by linarith [hα_sq_lt_one]) hωsq_pos
  have hlower :=
    higham11_4_bunch_kaufman_case4_twoByTwo_absdet_lower_of_row_max_le
      a11 a1r arr ω1 ωr hω1 hωr_le hcase ha1r
  have hdet_abs_pos : 0 < |a11 * arr - a1r ^ 2| :=
    lt_of_lt_of_le hscale_pos hlower
  exact abs_pos.mp hdet_abs_pos

/-- Active Bunch-Kaufman branch labels for the finite pivot paths used in the
Theorem 11.4 aggregation.  The `noAction` Algorithm 11.2 outcome is terminal
and is therefore excluded from a path of consumed pivot blocks. -/
inductive higham11_4_BunchKaufmanActiveBranch where
  | case1
  | case2
  | case3
  | case4
  deriving DecidableEq, Repr

/-- Embed an active branch label back into the Algorithm 11.2 case labels. -/
def higham11_4_bunchKaufmanActiveBranch_toCase :
    higham11_4_BunchKaufmanActiveBranch → BunchKaufmanCase
  | higham11_4_BunchKaufmanActiveBranch.case1 => BunchKaufmanCase.case1
  | higham11_4_BunchKaufmanActiveBranch.case2 => BunchKaufmanCase.case2
  | higham11_4_BunchKaufmanActiveBranch.case3 => BunchKaufmanCase.case3
  | higham11_4_BunchKaufmanActiveBranch.case4 => BunchKaufmanCase.case4

/-- Pivot size consumed by an active Bunch-Kaufman branch. -/
def higham11_4_bunchKaufmanActiveBranch_pivotSize :
    higham11_4_BunchKaufmanActiveBranch → PivotSize
  | higham11_4_BunchKaufmanActiveBranch.case1 => PivotSize.one
  | higham11_4_BunchKaufmanActiveBranch.case2 => PivotSize.one
  | higham11_4_BunchKaufmanActiveBranch.case3 => PivotSize.one
  | higham11_4_BunchKaufmanActiveBranch.case4 => PivotSize.two

/-- Number of rows/columns consumed by an active Bunch-Kaufman branch. -/
def higham11_4_bunchKaufmanBranchSupportOffset :
    higham11_4_BunchKaufmanActiveBranch → ℕ
  | higham11_4_BunchKaufmanActiveBranch.case1 => 1
  | higham11_4_BunchKaufmanActiveBranch.case2 => 1
  | higham11_4_BunchKaufmanActiveBranch.case3 => 1
  | higham11_4_BunchKaufmanActiveBranch.case4 => 2

/-- Every active Bunch-Kaufman branch consumes at least one pivot index. -/
theorem higham11_4_bunchKaufmanBranchSupportOffset_pos
    (s : higham11_4_BunchKaufmanActiveBranch) :
    0 < higham11_4_bunchKaufmanBranchSupportOffset s := by
  cases s <;> simp [higham11_4_bunchKaufmanBranchSupportOffset]

/-- Every active Bunch-Kaufman branch consumes at most two pivot indices. -/
theorem higham11_4_bunchKaufmanBranchSupportOffset_le_two
    (s : higham11_4_BunchKaufmanActiveBranch) :
    higham11_4_bunchKaufmanBranchSupportOffset s ≤ 2 := by
  cases s <;> simp [higham11_4_bunchKaufmanBranchSupportOffset]

/-- Active branch embedding never yields the terminal no-action case. -/
theorem higham11_4_bunchKaufmanActiveBranch_toCase_ne_noAction
    (s : higham11_4_BunchKaufmanActiveBranch) :
    higham11_4_bunchKaufmanActiveBranch_toCase s ≠ BunchKaufmanCase.noAction := by
  cases s <;> simp [higham11_4_bunchKaufmanActiveBranch_toCase]

/-- Total rows/columns consumed by a finite active Bunch-Kaufman pivot path. -/
def higham11_4_bunchKaufmanPathPivotSpan (k : ℕ)
    (step : Fin k → higham11_4_BunchKaufmanActiveBranch) : ℕ :=
  ∑ t : Fin k, higham11_4_bunchKaufmanBranchSupportOffset (step t)

/-- The empty Bunch-Kaufman pivot path consumes no rows/columns. -/
theorem higham11_4_bunchKaufmanPathPivotSpan_zero
    (step : Fin 0 → higham11_4_BunchKaufmanActiveBranch) :
    higham11_4_bunchKaufmanPathPivotSpan 0 step = 0 := by
  simp [higham11_4_bunchKaufmanPathPivotSpan]

/-- Cons decomposition of the total consumed Bunch-Kaufman pivot span. -/
theorem higham11_4_bunchKaufmanPathPivotSpan_cons
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch) :
    higham11_4_bunchKaufmanPathPivotSpan (k + 1) step =
      higham11_4_bunchKaufmanBranchSupportOffset (step 0) +
        higham11_4_bunchKaufmanPathPivotSpan k
          (fun t : Fin k => step t.succ) := by
  simp [higham11_4_bunchKaufmanPathPivotSpan, Fin.sum_univ_succ]

/-- Any nonempty active Bunch-Kaufman pivot path consumes at least one
row/column. -/
theorem higham11_4_bunchKaufmanPathPivotSpan_pos
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) (hk : 0 < k) :
    0 < higham11_4_bunchKaufmanPathPivotSpan k step := by
  cases k with
  | zero =>
      omega
  | succ k =>
      rw [higham11_4_bunchKaufmanPathPivotSpan_cons]
      exact Nat.add_pos_left
        (higham11_4_bunchKaufmanBranchSupportOffset_pos (step 0)) _

/-- A length-`k` active Bunch-Kaufman pivot path consumes at least `k`
rows/columns. -/
theorem higham11_4_bunchKaufmanPathPivotSpan_ge_length
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) :
    k ≤ higham11_4_bunchKaufmanPathPivotSpan k step := by
  induction k with
  | zero =>
      simp [higham11_4_bunchKaufmanPathPivotSpan]
  | succ k ih =>
      rw [higham11_4_bunchKaufmanPathPivotSpan_cons]
      have hstep : 1 ≤ higham11_4_bunchKaufmanBranchSupportOffset (step 0) :=
        higham11_4_bunchKaufmanBranchSupportOffset_pos (step 0)
      have htail := ih (fun t : Fin k => step t.succ)
      omega

/-- A length-`k` active Bunch-Kaufman pivot path consumes at most `2k`
rows/columns. -/
theorem higham11_4_bunchKaufmanPathPivotSpan_le_two_mul
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) :
    higham11_4_bunchKaufmanPathPivotSpan k step ≤ 2 * k := by
  induction k with
  | zero =>
      simp [higham11_4_bunchKaufmanPathPivotSpan]
  | succ k ih =>
      rw [higham11_4_bunchKaufmanPathPivotSpan_cons]
      have hstep := higham11_4_bunchKaufmanBranchSupportOffset_le_two (step 0)
      have htail := ih (fun t : Fin k => step t.succ)
      omega

/-- Prefix span consumed before a branch of an active Bunch-Kaufman pivot path. -/
def higham11_4_bunchKaufmanPathPrefixSpan (k : ℕ)
    (step : Fin k → higham11_4_BunchKaufmanActiveBranch) (t : Fin k) : ℕ :=
  ∑ r : Fin k,
    if r.val < t.val then
      higham11_4_bunchKaufmanBranchSupportOffset (step r)
    else 0

/-- The first active Bunch-Kaufman branch has zero prefix span. -/
theorem higham11_4_bunchKaufmanPathPrefixSpan_zero
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch) :
    higham11_4_bunchKaufmanPathPrefixSpan (k + 1) step 0 = 0 := by
  simp [higham11_4_bunchKaufmanPathPrefixSpan]

/-- Prefix span after the head splits into the head branch span plus the tail
prefix. -/
theorem higham11_4_bunchKaufmanPathPrefixSpan_succ
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch)
    (t : Fin k) :
    higham11_4_bunchKaufmanPathPrefixSpan (k + 1) step t.succ =
      higham11_4_bunchKaufmanBranchSupportOffset (step 0) +
        higham11_4_bunchKaufmanPathPrefixSpan k
          (fun r : Fin k => step r.succ) t := by
  rw [higham11_4_bunchKaufmanPathPrefixSpan, Fin.sum_univ_succ]
  simp [higham11_4_bunchKaufmanPathPrefixSpan, Fin.val_succ]

/-- Start offsets for a finite active Bunch-Kaufman pivot path, relative to an
ambient base offset. -/
def higham11_4_BunchKaufmanPathStartOffsetsFrom
    (base k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (starts : Fin k → ℕ) : Prop :=
  (∀ hk : 0 < k, starts ⟨0, hk⟩ = base) ∧
  ∀ t : Fin k, ∀ hnext : t.val + 1 < k,
    starts ⟨t.val + 1, hnext⟩ =
      starts t + higham11_4_bunchKaufmanBranchSupportOffset (step t)

/-- Start offsets for an active Bunch-Kaufman pivot path beginning at row and
column zero. -/
abbrev higham11_4_BunchKaufmanPathStartOffsets
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (starts : Fin k → ℕ) : Prop :=
  higham11_4_BunchKaufmanPathStartOffsetsFrom 0 k step starts

/-- The head offset of a Bunch-Kaufman path schedule is its supplied base
offset. -/
theorem higham11_4_bunchKaufmanPathStartOffsetsFrom_head
    (base k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (starts : Fin k → ℕ)
    (hstarts : higham11_4_BunchKaufmanPathStartOffsetsFrom base k step starts)
    (hk : 0 < k) :
    starts ⟨0, hk⟩ = base :=
  hstarts.1 hk

/-- Successor offsets advance by the local pivot span of the current branch. -/
theorem higham11_4_bunchKaufmanPathStartOffsetsFrom_succ
    (base k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (starts : Fin k → ℕ)
    (hstarts : higham11_4_BunchKaufmanPathStartOffsetsFrom base k step starts)
    (t : Fin k) (hnext : t.val + 1 < k) :
    starts ⟨t.val + 1, hnext⟩ =
      starts t + higham11_4_bunchKaufmanBranchSupportOffset (step t) :=
  hstarts.2 t hnext

/-- Successor starts strictly increase along any scheduled active
Bunch-Kaufman pivot path. -/
theorem higham11_4_bunchKaufmanPathStartOffsetsFrom_succ_lt
    (base k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (starts : Fin k → ℕ)
    (hstarts : higham11_4_BunchKaufmanPathStartOffsetsFrom base k step starts)
    (t : Fin k) (hnext : t.val + 1 < k) :
    starts t < starts ⟨t.val + 1, hnext⟩ := by
  rw [higham11_4_bunchKaufmanPathStartOffsetsFrom_succ
    base k step starts hstarts t hnext]
  exact Nat.lt_add_of_pos_right
    (higham11_4_bunchKaufmanBranchSupportOffset_pos (step t))

/-- Cons constructor for active Bunch-Kaufman path start schedules. -/
theorem higham11_4_bunchKaufmanPathStartOffsetsFrom_cons
    (base k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch)
    (starts : Fin (k + 1) → ℕ)
    (hhead : starts 0 = base)
    (htail : higham11_4_BunchKaufmanPathStartOffsetsFrom
      (base + higham11_4_bunchKaufmanBranchSupportOffset (step 0)) k
      (fun t : Fin k => step t.succ) (fun t : Fin k => starts t.succ)) :
    higham11_4_BunchKaufmanPathStartOffsetsFrom base (k + 1) step starts := by
  refine ⟨?_, ?_⟩
  · intro hk
    simpa using hhead
  · intro t hnext
    cases t using Fin.cases with
    | zero =>
        have hk : 0 < k := by omega
        have htail_head :=
          higham11_4_bunchKaufmanPathStartOffsetsFrom_head
            (base + higham11_4_bunchKaufmanBranchSupportOffset (step 0)) k
            (fun t : Fin k => step t.succ) (fun t : Fin k => starts t.succ)
            htail hk
        simpa [hhead, add_comm, add_left_comm, add_assoc] using htail_head
    | succ t =>
        have hnext' : t.val + 2 < k + 1 := by
          simpa [Fin.val_succ, Nat.add_assoc] using hnext
        have hnext_tail : t.val + 1 < k := by omega
        have htail_succ :=
          higham11_4_bunchKaufmanPathStartOffsetsFrom_succ
            (base + higham11_4_bunchKaufmanBranchSupportOffset (step 0)) k
            (fun t : Fin k => step t.succ) (fun t : Fin k => starts t.succ)
            htail t hnext_tail
        simpa using htail_succ

/-- Tail projection for active Bunch-Kaufman path start schedules. -/
theorem higham11_4_bunchKaufmanPathStartOffsetsFrom_tail
    (base k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch)
    (starts : Fin (k + 1) → ℕ)
    (hstarts : higham11_4_BunchKaufmanPathStartOffsetsFrom base (k + 1)
      step starts) :
    higham11_4_BunchKaufmanPathStartOffsetsFrom
      (base + higham11_4_bunchKaufmanBranchSupportOffset (step 0)) k
      (fun t : Fin k => step t.succ) (fun t : Fin k => starts t.succ) := by
  refine ⟨?_, ?_⟩
  · intro hk
    have hhead :=
      higham11_4_bunchKaufmanPathStartOffsetsFrom_head
        base (k + 1) step starts hstarts (by omega)
    have hzero : starts (0 : Fin (k + 1)) = base := by
      simpa using hhead
    have hnext0 : (0 : Fin (k + 1)).val + 1 < k + 1 := by
      simpa using Nat.succ_lt_succ hk
    have hsucc :=
      higham11_4_bunchKaufmanPathStartOffsetsFrom_succ
        base (k + 1) step starts hstarts (0 : Fin (k + 1)) hnext0
    simpa [hzero, add_comm, add_left_comm, add_assoc] using hsucc
  · intro t hnext
    have hnext_full : t.succ.val + 1 < k + 1 := by
      rw [Fin.val_succ]
      omega
    have hsucc :=
      higham11_4_bunchKaufmanPathStartOffsetsFrom_succ
        base (k + 1) step starts hstarts t.succ hnext_full
    simpa [Fin.val_succ, Nat.add_assoc] using hsucc

/-- A nonempty base-offset start schedule is equivalent to its head offset and
scheduled tail. -/
theorem higham11_4_bunchKaufmanPathStartOffsetsFrom_iff_head_tail
    (base k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch)
    (starts : Fin (k + 1) → ℕ) :
    higham11_4_BunchKaufmanPathStartOffsetsFrom base (k + 1) step starts ↔
      starts 0 = base ∧
        higham11_4_BunchKaufmanPathStartOffsetsFrom
          (base + higham11_4_bunchKaufmanBranchSupportOffset (step 0)) k
          (fun t : Fin k => step t.succ)
          (fun t : Fin k => starts t.succ) := by
  constructor
  · intro hstarts
    exact
      ⟨higham11_4_bunchKaufmanPathStartOffsetsFrom_head
          base (k + 1) step starts hstarts (by omega),
        higham11_4_bunchKaufmanPathStartOffsetsFrom_tail
          base k step starts hstarts⟩
  · intro h
    exact
      higham11_4_bunchKaufmanPathStartOffsetsFrom_cons
        base k step starts h.1 h.2

/-- Every finite active Bunch-Kaufman branch path has a base-offset start
schedule. -/
theorem higham11_4_bunchKaufmanPathStartOffsetsFrom_exists
    (base k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) :
    ∃ starts : Fin k → ℕ,
      higham11_4_BunchKaufmanPathStartOffsetsFrom base k step starts := by
  induction k generalizing base with
  | zero =>
      refine ⟨fun t => Fin.elim0 t, ?_⟩
      refine ⟨?_, ?_⟩
      · intro hk
        omega
      · intro t
        exact Fin.elim0 t
  | succ k ih =>
      obtain ⟨tailStarts, htail⟩ := ih
        (base + higham11_4_bunchKaufmanBranchSupportOffset (step 0))
        (fun t : Fin k => step t.succ)
      let starts : Fin (k + 1) → ℕ := fun t => Fin.cases base tailStarts t
      refine ⟨starts, ?_⟩
      exact
        higham11_4_bunchKaufmanPathStartOffsetsFrom_cons
          base k step starts (by simp [starts]) (by simpa [starts] using htail)

/-- The base-offset start schedule for a finite active Bunch-Kaufman pivot path
is unique. -/
theorem higham11_4_bunchKaufmanPathStartOffsetsFrom_unique
    (base k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (starts₁ starts₂ : Fin k → ℕ)
    (hstarts₁ : higham11_4_BunchKaufmanPathStartOffsetsFrom base k step starts₁)
    (hstarts₂ : higham11_4_BunchKaufmanPathStartOffsetsFrom base k step starts₂) :
    starts₁ = starts₂ := by
  induction k generalizing base with
  | zero =>
      funext t
      exact Fin.elim0 t
  | succ k ih =>
      funext t
      cases t using Fin.cases with
      | zero =>
          have hhead₁ :=
            higham11_4_bunchKaufmanPathStartOffsetsFrom_head
              base (k + 1) step starts₁ hstarts₁ (by omega)
          have hhead₂ :=
            higham11_4_bunchKaufmanPathStartOffsetsFrom_head
              base (k + 1) step starts₂ hstarts₂ (by omega)
          have hzero₁ : starts₁ (0 : Fin (k + 1)) = base := by
            simpa using hhead₁
          have hzero₂ : starts₂ (0 : Fin (k + 1)) = base := by
            simpa using hhead₂
          rw [hzero₁, hzero₂]
      | succ t =>
          have htail₁ :=
            higham11_4_bunchKaufmanPathStartOffsetsFrom_tail
              base k step starts₁ hstarts₁
          have htail₂ :=
            higham11_4_bunchKaufmanPathStartOffsetsFrom_tail
              base k step starts₂ hstarts₂
          have htail_eq :=
            ih (base + higham11_4_bunchKaufmanBranchSupportOffset (step 0))
              (fun t : Fin k => step t.succ)
              (fun t : Fin k => starts₁ t.succ)
              (fun t : Fin k => starts₂ t.succ) htail₁ htail₂
          exact congrFun htail_eq t

/-- Every finite active Bunch-Kaufman pivot path has a unique base-offset start
schedule. -/
theorem higham11_4_bunchKaufmanPathStartOffsetsFrom_exists_unique
    (base k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) :
    ∃! starts : Fin k → ℕ,
      higham11_4_BunchKaufmanPathStartOffsetsFrom base k step starts := by
  obtain ⟨starts, hstarts⟩ :=
    higham11_4_bunchKaufmanPathStartOffsetsFrom_exists base k step
  refine ⟨starts, hstarts, ?_⟩
  intro starts' hstarts'
  exact
    higham11_4_bunchKaufmanPathStartOffsetsFrom_unique
      base k step starts' starts hstarts' hstarts

/-- Scheduled starts equal the base plus the prefix span consumed by earlier
branches. -/
theorem higham11_4_bunchKaufmanPathStartOffsetsFrom_eq_base_add_prefixSpan
    (base k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (starts : Fin k → ℕ)
    (hstarts : higham11_4_BunchKaufmanPathStartOffsetsFrom base k step starts)
    (t : Fin k) :
    starts t = base + higham11_4_bunchKaufmanPathPrefixSpan k step t := by
  induction k generalizing base with
  | zero =>
      exact Fin.elim0 t
  | succ k ih =>
      cases t using Fin.cases with
      | zero =>
          have hhead :=
            higham11_4_bunchKaufmanPathStartOffsetsFrom_head
              base (k + 1) step starts hstarts (by omega)
          simpa [higham11_4_bunchKaufmanPathPrefixSpan] using hhead
      | succ t =>
          have htail :=
            higham11_4_bunchKaufmanPathStartOffsetsFrom_tail
              base k step starts hstarts
          have htail_eq := ih
            (base + higham11_4_bunchKaufmanBranchSupportOffset (step 0))
            (fun r : Fin k => step r.succ)
            (fun r : Fin k => starts r.succ) htail t
          rw [htail_eq]
          simp [higham11_4_bunchKaufmanPathPrefixSpan_succ, add_assoc]

/-- The explicit prefix-span starts form the canonical base-offset schedule. -/
theorem higham11_4_bunchKaufmanPathStartOffsetsFrom_base_add_prefixSpan
    (base k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) :
    higham11_4_BunchKaufmanPathStartOffsetsFrom base k step
      (fun t => base + higham11_4_bunchKaufmanPathPrefixSpan k step t) := by
  obtain ⟨starts, hstarts⟩ :=
    higham11_4_bunchKaufmanPathStartOffsetsFrom_exists base k step
  have hstarts_eq :
      starts = fun t : Fin k =>
        base + higham11_4_bunchKaufmanPathPrefixSpan k step t := by
    funext t
    exact
      higham11_4_bunchKaufmanPathStartOffsetsFrom_eq_base_add_prefixSpan
        base k step starts hstarts t
  simpa [hstarts_eq] using hstarts

/-- Every start offset in a base-offset active Bunch-Kaufman path is at or
after the base. -/
theorem higham11_4_bunchKaufmanPathStartOffsetsFrom_base_le
    (base k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (starts : Fin k → ℕ)
    (hstarts : higham11_4_BunchKaufmanPathStartOffsetsFrom base k step starts)
    (t : Fin k) :
    base ≤ starts t := by
  induction k generalizing base with
  | zero =>
      exact Fin.elim0 t
  | succ k ih =>
      cases t using Fin.cases with
      | zero =>
          have hhead :=
            higham11_4_bunchKaufmanPathStartOffsetsFrom_head
              base (k + 1) step starts hstarts (by omega)
          have hzero : starts (0 : Fin (k + 1)) = base := by
            simpa using hhead
          simp [hzero]
      | succ t =>
          have htail :=
            higham11_4_bunchKaufmanPathStartOffsetsFrom_tail
              base k step starts hstarts
          have htail_ge := ih
            (base + higham11_4_bunchKaufmanBranchSupportOffset (step 0))
            (fun t : Fin k => step t.succ) (fun t : Fin k => starts t.succ)
            htail t
          exact Nat.le_trans (Nat.le_add_right base _) htail_ge

/-- Every scheduled start offset lies strictly before the end of the full
base-offset Bunch-Kaufman path span. -/
theorem higham11_4_bunchKaufmanPathStartOffsetsFrom_lt_base_add_pivotSpan
    (base k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (starts : Fin k → ℕ)
    (hstarts : higham11_4_BunchKaufmanPathStartOffsetsFrom base k step starts)
    (t : Fin k) :
    starts t < base + higham11_4_bunchKaufmanPathPivotSpan k step := by
  induction k generalizing base with
  | zero =>
      exact Fin.elim0 t
  | succ k ih =>
      cases t using Fin.cases with
      | zero =>
          have hhead :=
            higham11_4_bunchKaufmanPathStartOffsetsFrom_head
              base (k + 1) step starts hstarts (by omega)
          have hzero : starts (0 : Fin (k + 1)) = base := by
            simpa using hhead
          have hspan_pos :
              0 < higham11_4_bunchKaufmanPathPivotSpan (k + 1) step :=
            higham11_4_bunchKaufmanPathPivotSpan_pos (k + 1) step (by omega)
          rw [hzero]
          exact Nat.lt_add_of_pos_right hspan_pos
      | succ t =>
          have htail :=
            higham11_4_bunchKaufmanPathStartOffsetsFrom_tail
              base k step starts hstarts
          have htail_lt := ih
            (base + higham11_4_bunchKaufmanBranchSupportOffset (step 0))
            (fun t : Fin k => step t.succ) (fun t : Fin k => starts t.succ)
            htail t
          rw [higham11_4_bunchKaufmanPathPivotSpan_cons]
          simpa [Nat.add_assoc, add_comm, add_left_comm, add_assoc] using
            htail_lt

/-- The local branch block beginning at any scheduled start fits inside the
full base-offset active Bunch-Kaufman path span. -/
theorem higham11_4_bunchKaufmanPathStartOffsetsFrom_branch_end_le_base_add_pivotSpan
    (base k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (starts : Fin k → ℕ)
    (hstarts : higham11_4_BunchKaufmanPathStartOffsetsFrom base k step starts)
    (t : Fin k) :
    starts t + higham11_4_bunchKaufmanBranchSupportOffset (step t) ≤
      base + higham11_4_bunchKaufmanPathPivotSpan k step := by
  induction k generalizing base with
  | zero =>
      exact Fin.elim0 t
  | succ k ih =>
      cases t using Fin.cases with
      | zero =>
          have hhead :=
            higham11_4_bunchKaufmanPathStartOffsetsFrom_head
              base (k + 1) step starts hstarts (by omega)
          have hzero : starts (0 : Fin (k + 1)) = base := by
            simpa using hhead
          rw [hzero, higham11_4_bunchKaufmanPathPivotSpan_cons]
          omega
      | succ t =>
          have htail :=
            higham11_4_bunchKaufmanPathStartOffsetsFrom_tail
              base k step starts hstarts
          have htail_le := ih
            (base + higham11_4_bunchKaufmanBranchSupportOffset (step 0))
            (fun t : Fin k => step t.succ) (fun t : Fin k => starts t.succ)
            htail t
          rw [higham11_4_bunchKaufmanPathPivotSpan_cons]
          simpa [Nat.add_assoc, add_comm, add_left_comm, add_assoc] using
            htail_le

/-- Earlier branches end no later than any later branch's start in a scheduled
active Bunch-Kaufman path. -/
theorem higham11_4_bunchKaufmanPathStartOffsetsFrom_branch_end_le_of_lt
    (base k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (starts : Fin k → ℕ)
    (hstarts : higham11_4_BunchKaufmanPathStartOffsetsFrom base k step starts)
    {t u : Fin k} (htu : t.val < u.val) :
    starts t + higham11_4_bunchKaufmanBranchSupportOffset (step t) ≤
      starts u := by
  induction k generalizing base with
  | zero =>
      exact Fin.elim0 t
  | succ k ih =>
      cases t using Fin.cases with
      | zero =>
          cases u using Fin.cases with
          | zero =>
              omega
          | succ u =>
              have htail :=
                higham11_4_bunchKaufmanPathStartOffsetsFrom_tail
                  base k step starts hstarts
              have htail_base_le :=
                higham11_4_bunchKaufmanPathStartOffsetsFrom_base_le
                  (base + higham11_4_bunchKaufmanBranchSupportOffset (step 0))
                  k (fun t : Fin k => step t.succ)
                  (fun t : Fin k => starts t.succ) htail u
              have hhead :=
                higham11_4_bunchKaufmanPathStartOffsetsFrom_head
                  base (k + 1) step starts hstarts (by omega)
              have hzero : starts (0 : Fin (k + 1)) = base := by
                simpa using hhead
              simpa [hzero, add_comm, add_left_comm, add_assoc] using
                htail_base_le
      | succ t =>
          cases u using Fin.cases with
          | zero =>
              simp [Fin.val_succ] at htu
          | succ u =>
              have htail :=
                higham11_4_bunchKaufmanPathStartOffsetsFrom_tail
                  base k step starts hstarts
              have htu_tail : t.val < u.val := by
                simpa [Fin.val_succ] using htu
              exact
                ih (base + higham11_4_bunchKaufmanBranchSupportOffset (step 0))
                  (fun t : Fin k => step t.succ)
                  (fun t : Fin k => starts t.succ) htail htu_tail

/-- Start offsets are strictly ordered along a scheduled active
Bunch-Kaufman path. -/
theorem higham11_4_bunchKaufmanPathStartOffsetsFrom_lt_of_lt
    (base k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (starts : Fin k → ℕ)
    (hstarts : higham11_4_BunchKaufmanPathStartOffsetsFrom base k step starts)
    {t u : Fin k} (htu : t.val < u.val) :
    starts t < starts u := by
  have hend :=
    higham11_4_bunchKaufmanPathStartOffsetsFrom_branch_end_le_of_lt
      base k step starts hstarts htu
  exact Nat.lt_of_lt_of_le
    (Nat.lt_add_of_pos_right
      (higham11_4_bunchKaufmanBranchSupportOffset_pos (step t))) hend

/-- Start offsets are monotone with respect to path index in a scheduled
active Bunch-Kaufman path. -/
theorem higham11_4_bunchKaufmanPathStartOffsetsFrom_le_of_le
    (base k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (starts : Fin k → ℕ)
    (hstarts : higham11_4_BunchKaufmanPathStartOffsetsFrom base k step starts)
    {t u : Fin k} (htu : t.val ≤ u.val) :
    starts t ≤ starts u := by
  by_cases hEq : t = u
  · subst u
    exact le_rfl
  · have hval_ne : t.val ≠ u.val := by
      intro hval
      exact hEq (Fin.ext hval)
    have hlt : t.val < u.val := lt_of_le_of_ne htu hval_ne
    exact
      (higham11_4_bunchKaufmanPathStartOffsetsFrom_lt_of_lt
        base k step starts hstarts hlt).le

/-- Branch endpoints are monotone with respect to path index in a scheduled
active Bunch-Kaufman path. -/
theorem higham11_4_bunchKaufmanPathStartOffsetsFrom_branch_end_le_branch_end_of_le
    (base k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (starts : Fin k → ℕ)
    (hstarts : higham11_4_BunchKaufmanPathStartOffsetsFrom base k step starts)
    {t u : Fin k} (htu : t.val ≤ u.val) :
    starts t + higham11_4_bunchKaufmanBranchSupportOffset (step t) ≤
      starts u + higham11_4_bunchKaufmanBranchSupportOffset (step u) := by
  by_cases hEq : t = u
  · subst u
    exact le_rfl
  · have hval_ne : t.val ≠ u.val := by
      intro hval
      exact hEq (Fin.ext hval)
    have hlt : t.val < u.val := lt_of_le_of_ne htu hval_ne
    have hend :=
      higham11_4_bunchKaufmanPathStartOffsetsFrom_branch_end_le_of_lt
        base k step starts hstarts hlt
    exact Nat.le_trans hend (Nat.le_add_right (starts u) _)

/-- The end of the last branch in a nonempty scheduled active
Bunch-Kaufman path is exactly the base plus the total pivot span. -/
theorem higham11_4_bunchKaufmanPathStartOffsetsFrom_last_branch_end_eq
    (base k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch)
    (starts : Fin (k + 1) → ℕ)
    (hstarts : higham11_4_BunchKaufmanPathStartOffsetsFrom base (k + 1)
      step starts) :
    starts (Fin.last k) +
        higham11_4_bunchKaufmanBranchSupportOffset (step (Fin.last k)) =
      base + higham11_4_bunchKaufmanPathPivotSpan (k + 1) step := by
  induction k generalizing base with
  | zero =>
      have hhead :=
        higham11_4_bunchKaufmanPathStartOffsetsFrom_head
          base 1 step starts hstarts (by omega)
      have hzero : starts (0 : Fin 1) = base := by
        simpa using hhead
      simp [Fin.last, hzero, higham11_4_bunchKaufmanPathPivotSpan_cons,
        higham11_4_bunchKaufmanPathPivotSpan_zero]
  | succ k ih =>
      have htail :=
        higham11_4_bunchKaufmanPathStartOffsetsFrom_tail
          base (k + 1) step starts hstarts
      have htail_last := ih
        (base + higham11_4_bunchKaufmanBranchSupportOffset (step 0))
        (fun t : Fin (k + 1) => step t.succ)
        (fun t : Fin (k + 1) => starts t.succ) htail
      rw [higham11_4_bunchKaufmanPathPivotSpan_cons]
      simpa [Fin.last, Nat.add_assoc, add_comm, add_left_comm, add_assoc] using
        htail_last

/-- A zero-based active Bunch-Kaufman path schedule starts at offset `0`. -/
theorem higham11_4_bunchKaufmanPathStartOffsets_head
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (starts : Fin k → ℕ)
    (hstarts : higham11_4_BunchKaufmanPathStartOffsets k step starts)
    (hk : 0 < k) :
    starts ⟨0, hk⟩ = 0 :=
  hstarts.1 hk

/-- A zero-based active Bunch-Kaufman path schedule advances by each branch's
pivot span. -/
theorem higham11_4_bunchKaufmanPathStartOffsets_succ
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (starts : Fin k → ℕ)
    (hstarts : higham11_4_BunchKaufmanPathStartOffsets k step starts)
    (t : Fin k) (hnext : t.val + 1 < k) :
    starts ⟨t.val + 1, hnext⟩ =
      starts t + higham11_4_bunchKaufmanBranchSupportOffset (step t) :=
  hstarts.2 t hnext

/-- Successor starts strictly increase along any zero-based scheduled active
Bunch-Kaufman path. -/
theorem higham11_4_bunchKaufmanPathStartOffsets_succ_lt
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (starts : Fin k → ℕ)
    (hstarts : higham11_4_BunchKaufmanPathStartOffsets k step starts)
    (t : Fin k) (hnext : t.val + 1 < k) :
    starts t < starts ⟨t.val + 1, hnext⟩ :=
  higham11_4_bunchKaufmanPathStartOffsetsFrom_succ_lt
    0 k step starts hstarts t hnext

/-- Tail projection for zero-based active Bunch-Kaufman path schedules. -/
theorem higham11_4_bunchKaufmanPathStartOffsets_tail
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch)
    (starts : Fin (k + 1) → ℕ)
    (hstarts : higham11_4_BunchKaufmanPathStartOffsets (k + 1) step starts) :
    higham11_4_BunchKaufmanPathStartOffsetsFrom
      (higham11_4_bunchKaufmanBranchSupportOffset (step 0)) k
      (fun t : Fin k => step t.succ) (fun t : Fin k => starts t.succ) := by
  simpa [higham11_4_BunchKaufmanPathStartOffsets, zero_add] using
    higham11_4_bunchKaufmanPathStartOffsetsFrom_tail 0 k step starts hstarts

/-- A nonempty zero-based start schedule is equivalent to its zero head and
scheduled tail. -/
theorem higham11_4_bunchKaufmanPathStartOffsets_iff_head_tail
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch)

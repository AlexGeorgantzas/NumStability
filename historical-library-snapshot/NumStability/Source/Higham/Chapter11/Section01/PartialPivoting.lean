/-- Block-diagonal path `D̂` matrices inherit a global entry cap from the local
pivot-block caps. -/
theorem higham11_4_bunchKaufmanPath_D_entry_bound_of_local_caps
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (D : Fin (higham11_4_bunchKaufmanPathPivotSpan k step) →
      Fin (higham11_4_bunchKaufmanPathPivotSpan k step) → ℝ)
    (Dmax : ℝ) (hDmax : 0 ≤ Dmax)
    (hblock : higham11_4_BunchKaufmanPathBlockDiagonalD k step D)
    (hlocal : higham11_4_BunchKaufmanPathLocalDEntryBound k step D Dmax) :
    ∀ a b : Fin (higham11_4_bunchKaufmanPathPivotSpan k step),
      |D a b| ≤ Dmax := by
  intro a b
  by_cases hsame :
      higham11_4_BunchKaufmanPathSameBranchPivotPair k step a b
  · rcases hsame with ⟨t, ⟨i, hi⟩, ⟨j, hj⟩⟩
    have hcap := hlocal t i j
    rw [← hi, ← hj]
    exact hcap
  · have hz := hblock a b hsame
    rw [hz]
    simpa using hDmax


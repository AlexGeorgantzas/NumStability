    higham11_4_BunchKaufmanPathBranchwiseSourceSixGrowthCaps
      k step L D Dmax :=
  ⟨fun t hcase => ⟨hDscalar t hcase, hLscalar t hcase⟩,
    fun t hcase => ⟨hDtwo t hcase, hLtwo t hcase⟩⟩

/-- Theorem 11.4 path case-dispatch adapter: per-active-branch local
source-six/growth caps assemble the named branchwise package.  This is the
case-labelled form used by concrete Bunch-Kaufman pivot-path producers before
the scalar branches are merged into the generic non-case-(4) interface. -/
theorem higham11_4_BunchKaufmanPathBranchwiseSourceSixGrowthCaps_of_active_branch_case_caps
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (L D : Fin (higham11_4_bunchKaufmanPathPivotSpan k step) →
      Fin (higham11_4_bunchKaufmanPathPivotSpan k step) → ℝ)
    (Dmax : ℝ)
    (hcase1 :
      ∀ t : Fin k,
        step t = higham11_4_BunchKaufmanActiveBranch.case1 →
          |D (higham11_4_bunchKaufmanPathLeadingPivotIndex k step t)
              (higham11_4_bunchKaufmanPathLeadingPivotIndex k step t)| ≤
            Dmax ∧
          (∑ q : Fin (higham11_4_bunchKaufmanPathPivotSpan k step),
            |L (higham11_4_bunchKaufmanPathLeadingPivotIndex k step t) q|) ≤ 6)
    (hcase2 :
      ∀ t : Fin k,
        step t = higham11_4_BunchKaufmanActiveBranch.case2 →
          |D (higham11_4_bunchKaufmanPathLeadingPivotIndex k step t)
              (higham11_4_bunchKaufmanPathLeadingPivotIndex k step t)| ≤
            Dmax ∧
          (∑ q : Fin (higham11_4_bunchKaufmanPathPivotSpan k step),
            |L (higham11_4_bunchKaufmanPathLeadingPivotIndex k step t) q|) ≤ 6)
    (hcase3 :
      ∀ t : Fin k,
        step t = higham11_4_BunchKaufmanActiveBranch.case3 →
          |D (higham11_4_bunchKaufmanPathLeadingPivotIndex k step t)
              (higham11_4_bunchKaufmanPathLeadingPivotIndex k step t)| ≤
            Dmax ∧
          (∑ q : Fin (higham11_4_bunchKaufmanPathPivotSpan k step),
            |L (higham11_4_bunchKaufmanPathLeadingPivotIndex k step t) q|) ≤ 6)
    (hcase4 :
      ∀ t : Fin k,
        step t = higham11_4_BunchKaufmanActiveBranch.case4 →
          (∀ i j : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)),
            |D (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i)
                (higham11_4_bunchKaufmanPathLocalPivotIndex k step t j)| ≤
              Dmax) ∧
          (∀ i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)),
            (∑ q : Fin (higham11_4_bunchKaufmanPathPivotSpan k step),
              |L (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i) q|) ≤ 6)) :
    higham11_4_BunchKaufmanPathBranchwiseSourceSixGrowthCaps
      k step L D Dmax := by
  refine ⟨?_, ?_⟩
  · intro t hscalar
    cases hstep : step t with
    | case1 =>
        exact hcase1 t hstep
    | case2 =>
        exact hcase2 t hstep
    | case3 =>
        exact hcase3 t hstep
    | case4 =>
        exact (hscalar hstep).elim
  · intro t hcase
    exact hcase4 t hcase

/-- Path-local `D̂` entry bounds and source-six local `L̂` row sums assemble
the named branchwise source-six/growth cap predicate. -/
theorem higham11_4_BunchKaufmanPathBranchwiseSourceSixGrowthCaps_of_local_D_entry_and_L_row_sum_bounds
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)

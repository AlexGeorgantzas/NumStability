            Dmax)
    (hDtwo :
      ∀ t : Fin k,
        step t = higham11_4_BunchKaufmanActiveBranch.case4 →
          ∀ i j : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)),
            |D (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i)
                (higham11_4_bunchKaufmanPathLocalPivotIndex k step t j)| ≤
              Dmax)
    (hLscalar :
      ∀ t : Fin k,
        step t ≠ higham11_4_BunchKaufmanActiveBranch.case4 →
          (∑ q : Fin (higham11_4_bunchKaufmanPathPivotSpan k step),

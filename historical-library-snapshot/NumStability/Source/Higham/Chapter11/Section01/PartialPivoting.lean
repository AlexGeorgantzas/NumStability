    (ρ_n Amax recB : ℝ) (hρ : 0 ≤ ρ_n) (hAmax : 0 ≤ Amax)
    (hrecB : 0 ≤ recB)
    (hrec_budget :
      recB ≤
        36 * (higham11_4_bunchKaufmanPathPivotSpan k
          (fun u : Fin k => step u.succ) : ℝ) * ρ_n * Amax)
    (hpkg :
      higham11_4_BunchKaufmanPathSourceSixGrowthLDPackage
        (k + 1) step L_hat D_hat ρ_n Amax) :
    ∀ i j : Fin (higham11_4_bunchKaufmanPathPivotSpan (k + 1) step),
      higham11_4_bunchKaufmanProductEntry
        (higham11_4_bunchKaufmanPathPivotSpan (k + 1) step) L_hat D_hat i j ≤
        36 * (higham11_4_bunchKaufmanPathPivotSpan (k + 1) step : ℝ) * ρ_n * Amax := by
  let s := higham11_4_bunchKaufmanBranchSupportOffset (step 0)
  let n := higham11_4_bunchKaufmanPathPivotSpan (k + 1) step
  have hs_pos : 0 < s := by
    dsimp [s]
    exact higham11_4_bunchKaufmanBranchSupportOffset_pos (step 0)
  have hs_le : s ≤ n := by
    dsimp [s, n]
    rw [higham11_4_bunchKaufmanPathPivotSpan_cons]
    exact Nat.le_add_right _ _
  have hsub :
      n - s = higham11_4_bunchKaufmanPathPivotSpan k
        (fun u : Fin k => step u.succ) := by
    dsimp [n, s]
    rw [higham11_4_bunchKaufmanPathPivotSpan_cons]
    omega
  have hrec_budget' :
      recB ≤ 36 * ((n - s : ℕ) : ℝ) * ρ_n * Amax := by
    have hsub_cast :
        ((n - s : ℕ) : ℝ) =
          (higham11_4_bunchKaufmanPathPivotSpan k
            (fun u : Fin k => step u.succ) : ℝ) := by
      exact_mod_cast hsub
    simpa [hsub_cast] using hrec_budget
  rcases
      higham11_4_first_stage_recursive_product_split_of_path_source_six_growth_LD_package
        k step L_hat D_hat ρ_n Amax recB hρ hAmax hrecB hpkg with
    ⟨hfirst, htrail⟩
  exact
    higham11_4_product_entries_of_first_stage_recursive_bounds
      n s hs_pos hs_le L_hat D_hat ρ_n Amax (36 * ρ_n * Amax) recB
      hρ hAmax le_rfl hrec_budget' hfirst htrail


    (hentry :
      ∀ t : Fin k,
        ∀ i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)),
          ∀ q : Fin (higham11_4_bunchKaufmanPathPivotSpan k step),
            |L (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i) q| ≤
              Lcap)
    (hbudget :
      (higham11_4_bunchKaufmanPathPivotSpan k step : ℝ) * Lcap ≤ Lrow) :
    higham11_4_BunchKaufmanPathLocalLRowSumBound k step L (fun _ => Lrow) :=
  higham11_4_BunchKaufmanPathLocalLRowSumBound_of_local_entry_bounds
    k step L (fun _ => Lcap) (fun _ => Lrow) hentry (fun _ _ => hbudget)

/-- Source-six specialization of the path-local entry-to-row-sum bridge. -/
theorem higham11_4_BunchKaufmanPathLocalLRowSumBound_of_source_six_entry_bound
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (L : Fin (higham11_4_bunchKaufmanPathPivotSpan k step) →

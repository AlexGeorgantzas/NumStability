  have hpref_t :=
    higham11_4_bunchKaufmanPathStartOffsets_eq_prefixSpan
      k step starts hstarts t
  have hpref_u :=
    higham11_4_bunchKaufmanPathStartOffsets_eq_prefixSpan
      k step starts hstarts u
  have hle :=
    higham11_4_bunchKaufmanPathStartOffsets_branch_end_le_of_lt
      k step starts hstarts htu

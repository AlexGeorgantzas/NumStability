    higham11_4_bunchKaufmanPathPrefixSpan (k + 1) step (Fin.last k) +
        higham11_4_bunchKaufmanBranchSupportOffset (step (Fin.last k)) =
      higham11_4_bunchKaufmanPathPivotSpan (k + 1) step := by
  obtain ⟨starts, hstarts⟩ :=
    higham11_4_bunchKaufmanPathStartOffsets_exists (k + 1) step
  have hprefix :=
    higham11_4_bunchKaufmanPathStartOffsets_eq_prefixSpan
      (k + 1) step starts hstarts (Fin.last k)
  have hlast :=
    higham11_4_bunchKaufmanPathStartOffsets_last_branch_end_eq
      k step starts hstarts
  rw [hprefix] at hlast
  simpa using hlast

/-- Every explicit prefix span lies strictly before the full path span. -/

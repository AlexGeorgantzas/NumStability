/-- Earlier explicit prefix branch blocks end no later than any later branch's
prefix start. -/
theorem higham11_4_bunchKaufmanPathPrefixSpan_branch_end_le_of_lt
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) {t u : Fin k}
    (htu : t.val < u.val) :
    higham11_4_bunchKaufmanPathPrefixSpan k step t +

      higham11_4_bunchKaufmanPathPivotSpan (k + 1) step := by
  simpa [higham11_4_BunchKaufmanPathStartOffsets] using
    higham11_4_bunchKaufmanPathStartOffsetsFrom_last_branch_end_eq

/-- Eq. 17.2: local rounding error bound. -/
def LocalErrorBound (n : ℕ) (M N : Fin n → Fin n → ℝ)
    (b : Fin n → ℝ) (x_hat : ℕ → (Fin n → ℝ))
    (ξ : ℕ → (Fin n → ℝ)) (cn_u : ℝ) : Prop :=
  ∀ k i, |ξ k i| ≤ cn_u * (∑ j : Fin n, |M i j| * |x_hat (k + 1) j| +
                              ∑ j : Fin n, |N i j| * |x_hat k j| + |b i|)













































































































































































































































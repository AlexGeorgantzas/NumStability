    (hX : forall i j, lyapunovOp n A X i j = C i j)
    (hBudget :
      IsSylvesterComputedResidualBudget n n A
        (fun i j => -matTranspose A i j) C Xhat Rhat Ru)
    (hPinvAbs_le : forall p q,

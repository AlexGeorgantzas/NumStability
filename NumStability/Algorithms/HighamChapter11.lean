        ∑ k₁ : Fin n, ∑ k₂ : Fin n,
          L_hat i k₁ * D_hat k₁ k₂ * L_hat j k₂ =
        A (σ i) (σ j) + ΔA1 i j) := by
  obtain ⟨ΔA1, ΔA2, hΔA1, hΔA2, hLD⟩ :=
    higham11_3_block_ldlt_backward_error_interface_of_BlockLDLTBackwardError
      n A L_hat D_hat σ ε hε hbe

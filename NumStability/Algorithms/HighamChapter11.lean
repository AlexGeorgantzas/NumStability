          p t i ≠ q t i)
    (hentry :
      ∀ t : Fin k,
        ∀ i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)),
          |L (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i) (p t i)| +

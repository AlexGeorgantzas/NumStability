    (hDlocal : higham11_4_BunchKaufmanPathLocalDEntryBound k step D Dmax)
    (p q : ∀ t : Fin k,
      Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)) →
        Fin (higham11_4_bunchKaufmanPathPivotSpan k step))
    (hpq :
      ∀ t : Fin k,
        ∀ i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)),
          p t i ≠ q t i)
    (hentry :
      ∀ t : Fin k,
        ∀ i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)),
          |L (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i) (p t i)| +
            |L (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i) (q t i)| ≤
              6)
    (hzero :
      ∀ t : Fin k,
        ∀ i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)),
          ∀ s : Fin (higham11_4_bunchKaufmanPathPivotSpan k step),

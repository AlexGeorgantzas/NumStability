      ∀ t : Fin k,
        ∀ i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t.succ)),
          (∑ q : Fin (higham11_4_bunchKaufmanPathPivotSpan (k + 1) step),
            |L (higham11_4_bunchKaufmanPathLocalPivotIndex (k + 1) step t.succ i) q|) ≤ 6) :
    higham11_4_BunchKaufmanPathLocalLRowSumBound (k + 1) step L (fun _ => 6) := by
  intro t i
  cases t using Fin.cases with
  | zero =>
      exact hhead i
  | succ t =>
      exact htail t i


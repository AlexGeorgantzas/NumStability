    (∑ k₁ : Fin n, ∑ k₂ : Fin n,
      L_hat i k₁ * D_hat k₁ k₂ * L_hat j k₂) - A i j
  let ΔA2 : Fin n → Fin n → ℝ := fun _ _ => 0
  refine ⟨L_hat, D_hat, ΔA1, ΔA2, ?_, ?_, ?_⟩
  · intro i j
    exact hLD i j
  · intro i j
    simpa [ΔA2] using
      higham11_3_fl_storedAllOneByOneBound_nonneg fp hval n A i j
  · intro i j
    simp [ΔA1]


/-- Max-entry computed-middle cap transport with explicit norm-conversion
loss: if `‖T_hat‖_max ≤ κ‖A‖_max` and `nκ` fits inside the printed growth
factor, then the existing `‖T_hat‖∞` Aasen bound has the source `‖A‖∞` form. -/
theorem higham11_8_aasenSourceNormwiseBackwardBound_of_maxEntryNorm_T_hat_le_kappa_mul_maxEntryNorm
    (n : ℕ) (hn : 0 < n) (ΔA_inf γ15n25 κ : ℝ)
    (T_hat A : Fin n → Fin n → ℝ)
    (hγ : 0 ≤ γ15n25)
    (hκ : (n : ℝ) * κ ≤ (4 : ℝ) ^ (n - 2))
    (hTcap : maxEntryNorm hn T_hat ≤ κ * maxEntryNorm hn A)
    (hbound :
      higham11_8_aasenNormwiseBackwardBound n ΔA_inf γ15n25
        (infNorm T_hat)) :
    higham11_8_aasenSourceNormwiseBackwardBound n ΔA_inf γ15n25
      (infNorm A) := by
  have hprinted :
      infNorm T_hat ≤ (4 : ℝ) ^ (n - 2) * infNorm A := by
    calc
      infNorm T_hat ≤ (n : ℝ) * maxEntryNorm hn T_hat :=
        infNorm_le_card_mul_maxEntryNorm hn T_hat
      _ ≤ (n : ℝ) * (κ * maxEntryNorm hn A) :=
        mul_le_mul_of_nonneg_left hTcap (Nat.cast_nonneg n)
      _ = ((n : ℝ) * κ) * maxEntryNorm hn A := by ring
      _ ≤ ((4 : ℝ) ^ (n - 2)) * maxEntryNorm hn A :=
        mul_le_mul_of_nonneg_right hκ (maxEntryNorm_nonneg hn A)
      _ ≤ ((4 : ℝ) ^ (n - 2)) * infNorm A :=
        mul_le_mul_of_nonneg_left (maxEntryNorm_le_infNorm hn A)
          (pow_nonneg (by norm_num : (0 : ℝ) ≤ 4) _)
  exact
    higham11_8_aasenSourceNormwiseBackwardBound_of_infNorm_T_hat_le_printed_mul_infNorm
      n ΔA_inf γ15n25 T_hat A hγ hbound hprinted


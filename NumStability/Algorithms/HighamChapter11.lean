/-- Local `D̂` caps over a path can be supplied branchwise: scalar active
branches only need the leading diagonal cap, while accepted `2 × 2` branches
need the full local pivot-block cap. -/
theorem higham11_4_BunchKaufmanPathLocalDEntryBound_of_scalar_and_twoByTwo_local_caps
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (D : Fin (higham11_4_bunchKaufmanPathPivotSpan k step) →
      Fin (higham11_4_bunchKaufmanPathPivotSpan k step) → ℝ)
    (Dmax : ℝ)
    (hscalar :
      ∀ t : Fin k,
        step t ≠ higham11_4_BunchKaufmanActiveBranch.case4 →
          |D (higham11_4_bunchKaufmanPathLeadingPivotIndex k step t)
              (higham11_4_bunchKaufmanPathLeadingPivotIndex k step t)| ≤ Dmax)
    (htwo :
      ∀ t : Fin k,
        step t = higham11_4_BunchKaufmanActiveBranch.case4 →
          ∀ i j : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)),
            |D (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i)
                (higham11_4_bunchKaufmanPathLocalPivotIndex k step t j)| ≤ Dmax) :
    higham11_4_BunchKaufmanPathLocalDEntryBound k step D Dmax := by
  intro t i j
  by_cases hcase : step t = higham11_4_BunchKaufmanActiveBranch.case4
  · exact htwo t hcase i j
  · have hi :
        i = higham11_4_bunchKaufmanBranchLeadingLocalIndex (step t) :=
      higham11_4_bunchKaufmanBranchLocalIndex_eq_leading_of_not_case4
        (step t) hcase i
    have hj :
        j = higham11_4_bunchKaufmanBranchLeadingLocalIndex (step t) :=
      higham11_4_bunchKaufmanBranchLocalIndex_eq_leading_of_not_case4
        (step t) hcase j
    subst hi
    subst hj
    exact hscalar t hcase


/-- `σ := id` specialization of
`higham11_8_AasenSpec_identity_exact_recurrences_of_H_eq_T_subdiagonal_ne_zero`. -/
theorem higham11_8_AasenSpec_id_exact_recurrences_of_H_eq_T_subdiagonal_ne_zero
    (n : ℕ) (A L H T : Fin n → Fin n → ℝ)
    (hspec : higham11_8_AasenSpec n A L T (fun i => i))
    (hH_eq : ∀ i j : Fin n, H i j = higham11_10_aasenH n T L i j)
    (hTnz : ∀ i next : Fin n, next.val = i.val + 1 → T next i ≠ 0) :
    higham11_12_aasenDiagonalEquation n A L H ∧
      higham11_13_aasenSubdiagonalEquation n A L H ∧
      higham11_14_aasenNextColumnEquation n A L H := by
  exact higham11_8_AasenSpec_identity_exact_recurrences_of_H_eq_T_subdiagonal_ne_zero
    n A L H T (fun i : Fin n => i) hspec (by intro i; rfl) hH_eq hTnz

/-- **Equation (11.11), first diagonal recovery**.  For `H = T Lᵀ` in an
`AasenSpec`, the first diagonal `H` entry is the first tridiagonal diagonal
entry of `T`. -/
theorem higham11_11_AasenSpec_identity_aasenH_diagonal_eq_T_of_zero
    (n : ℕ) (A L T : Fin n → Fin n → ℝ) (σ : Fin n → Fin n)
    (hspec : higham11_8_AasenSpec n A L T σ)
    (i : Fin n) (hi0 : i.val = 0) :
    higham11_10_aasenH n T L i i = T i i := by
  unfold higham11_10_aasenH
  rw [Finset.sum_eq_single i]
  · simp [hspec.L_diag i]
  · intro k _ hki
    have hlt : i.val < k.val := by
      have hk_ne : k.val ≠ i.val := by
        intro hk
        exact hki (Fin.ext hk)
      omega
    rw [hspec.L_upper_zero i k hlt, mul_zero]
  · intro hi
    exact absurd (Finset.mem_univ i) hi

/-- **Equation (11.11), successor diagonal recovery**.  For `H = T Lᵀ` in an
`AasenSpec`, the diagonal relation after the first column is
`H i i = T i i + T i prev * L i prev` when `i = prev+1`. -/
theorem higham11_11_AasenSpec_identity_aasenH_diagonal_eq_T_add_prev
    (n : ℕ) (A L T : Fin n → Fin n → ℝ) (σ : Fin n → Fin n)
    (hspec : higham11_8_AasenSpec n A L T σ)
    (prev i : Fin n) (hi : i.val = prev.val + 1) :
    higham11_10_aasenH n T L i i = T i i + T i prev * L i prev := by
  unfold higham11_10_aasenH
  let f : Fin n → ℝ := fun k => T i k * L i k
  change (∑ k : Fin n, f k) = T i i + T i prev * L i prev
  have hprev_ne_i : prev ≠ i := by
    intro h
    have hv : prev.val = i.val := congrArg Fin.val h
    omega
  have hsplit :=
    (Finset.add_sum_erase Finset.univ f (Finset.mem_univ i)).symm
  rw [hsplit]
  have hsum_prev : (∑ k ∈ Finset.univ.erase i, f k) = f prev := by
    rw [Finset.sum_eq_single prev]
    · intro k hk hkp
      have hk_ne_i : k ≠ i := Finset.ne_of_mem_erase hk
      by_cases hlt_prev : k.val < prev.val
      · have hTzero : T i k = 0 :=
          hspec.T_tridiag.2 i k (Or.inr (by omega))
        simp [f, hTzero]
      · have hLzero : L i k = 0 := by
          apply hspec.L_upper_zero
          have hkp_val : k.val ≠ prev.val := by
            intro hv
            exact hkp (Fin.ext hv)
          have hki_val : k.val ≠ i.val := by
            intro hv
            exact hk_ne_i (Fin.ext hv)
          omega
        simp [f, hLzero]
    · intro hnot
      exfalso
      exact hnot (by simp [hprev_ne_i])
  rw [hsum_prev]
  simp [f, hspec.L_diag i]

/-- **Equation (11.11), floating-point diagonal recovery**.  This is the local
two-operation scalar path used after (11.12)--(11.13): first form
`fl(β * ℓ)`, then subtract it from the computed `H` diagonal entry. -/
noncomputable def higham11_11_fl_aasenDiagonalTRecover
    (fp : FPModel) (h beta ell : ℝ) : ℝ :=
  fp.fl_sub h (fp.fl_mul beta ell)

/-- **Equation (11.11), floating-point diagonal recovery model**.  The rounded
scalar recovery `fl(h - fl(βℓ))` exposes the multiplication and subtraction
relative-error witnesses separately. -/
theorem higham11_11_fl_aasenDiagonalTRecover_rel_error
    (fp : FPModel) (h beta ell : ℝ) :
    ∃ δm δs : ℝ,
      |δm| ≤ fp.u ∧
      |δs| ≤ fp.u ∧
      higham11_11_fl_aasenDiagonalTRecover fp h beta ell =
        (h - (beta * ell) * (1 + δm)) * (1 + δs) := by
  obtain ⟨δm, hδm, hmul⟩ := fp.model_mul beta ell
  obtain ⟨δs, hδs, hsub⟩ := fp.model_sub h (fp.fl_mul beta ell)
  refine ⟨δm, δs, hδm, hδs, ?_⟩
  rw [higham11_11_fl_aasenDiagonalTRecover, hsub, hmul]

/-- **Equation (11.11), scalar diagonal recovery error budget**.  The rounded
two-operation recovery `fl(h_hat - fl(beta_hat*ell_hat))` differs from the
exact scalar recovery `h - beta*ell` by the input `h` error, the product-input
errors, and the two local rounding terms. -/
theorem higham11_11_fl_aasenDiagonalTRecover_abs_error_bound
    (fp : FPModel) (h_hat h beta_hat beta ell_hat ell : ℝ) :
    ∃ δm δs : ℝ,
      |δm| ≤ fp.u ∧
      |δs| ≤ fp.u ∧
      |higham11_11_fl_aasenDiagonalTRecover fp h_hat beta_hat ell_hat -
          (h - beta * ell)| ≤
        |h_hat - h| +
            (|beta_hat - beta| * |ell| + |beta_hat| * |ell_hat - ell|) +
          fp.u * |beta_hat * ell_hat| +
          fp.u * |h_hat - (beta_hat * ell_hat) * (1 + δm)| := by
  obtain ⟨δm, δs, hδm, hδs, hfl⟩ :=
    higham11_11_fl_aasenDiagonalTRecover_rel_error fp h_hat beta_hat ell_hat
  let inner : ℝ := h_hat - (beta_hat * ell_hat) * (1 + δm)
  refine ⟨δm, δs, hδm, hδs, ?_⟩
  rw [hfl]
  let a : ℝ := h_hat - h
  let b : ℝ := beta_hat * ell_hat - beta * ell
  let c : ℝ := (beta_hat * ell_hat) * δm
  let d : ℝ := inner * δs
  have hdecomp :
      inner * (1 + δs) - (h - beta * ell) = a - b - c + d := by
    dsimp [inner, a, b, c, d]
    ring
  have htri : |a - b - c + d| ≤ |a| + |b| + |c| + |d| := by
    have hab : |a - b| ≤ |a| + |b| := by
      simpa [sub_eq_add_neg, abs_neg] using abs_add_le a (-b)
    have habc : |a - b - c| ≤ |a - b| + |c| := by
      simpa [sub_eq_add_neg, abs_neg] using abs_add_le (a - b) (-c)
    have habc' : |a - b - c| ≤ |a| + |b| + |c| := by linarith
    have habcd : |a - b - c + d| ≤ |a - b - c| + |d| :=
      abs_add_le (a - b - c) d
    linarith
  have hprod :
      |beta_hat * ell_hat - beta * ell| ≤
        |beta_hat - beta| * |ell| + |beta_hat| * |ell_hat - ell| := by
    have hsplit :
        beta_hat * ell_hat - beta * ell =
          (beta_hat - beta) * ell + beta_hat * (ell_hat - ell) := by ring
    calc
      |beta_hat * ell_hat - beta * ell|
          = |(beta_hat - beta) * ell + beta_hat * (ell_hat - ell)| := by
              rw [hsplit]
      _ ≤ |(beta_hat - beta) * ell| + |beta_hat * (ell_hat - ell)| :=
          abs_add_le _ _
      _ = |beta_hat - beta| * |ell| + |beta_hat| * |ell_hat - ell| := by
          rw [abs_mul, abs_mul]
  have hc : |(beta_hat * ell_hat) * δm| ≤ fp.u * |beta_hat * ell_hat| := by
    calc
      |(beta_hat * ell_hat) * δm|
          = |beta_hat * ell_hat| * |δm| := abs_mul _ _
      _ ≤ |beta_hat * ell_hat| * fp.u :=
          mul_le_mul_of_nonneg_left hδm (abs_nonneg _)
      _ = fp.u * |beta_hat * ell_hat| := by ring
  have hd : |inner * δs| ≤ fp.u * |inner| := by
    calc
      |inner * δs| = |inner| * |δs| := abs_mul _ _
      _ ≤ |inner| * fp.u := mul_le_mul_of_nonneg_left hδs (abs_nonneg _)
      _ = fp.u * |inner| := by ring
  have hbase :
      |inner * (1 + δs) - (h - beta * ell)| ≤ |a| + |b| + |c| + |d| := by
    rw [hdecomp]
    exact htri
  have hfinal :
      |inner * (1 + δs) - (h - beta * ell)| ≤
        |h_hat - h| +
            (|beta_hat - beta| * |ell| + |beta_hat| * |ell_hat - ell|) +
          fp.u * |beta_hat * ell_hat| + fp.u * |inner| := by
    dsimp [a, b, c, d] at hbase
    linarith
  simpa [inner] using hfinal

/-- **Equation (11.11), computed tridiagonal recovery structure**.  This
predicate records the storage rules that recover the computed tridiagonal
middle factor from the computed intermediate Hessenberg entries: the first
diagonal is copied, later diagonals use the rounded scalar recovery
`fl(h - fl(βℓ))`, subdiagonal `T_hat` entries are copied from `H_hat`, the
superdiagonal is mirrored, and all farther entries are zero. -/
def higham11_11_fl_aasenComputedTRecoveries (n : ℕ)
    (fp : FPModel) (H_hat L_hat T_hat : Fin n → Fin n → ℝ) : Prop :=
  (∀ i : Fin n, i.val = 0 → T_hat i i = H_hat i i) ∧
  (∀ prev i : Fin n, i.val = prev.val + 1 →
    T_hat i i =
      higham11_11_fl_aasenDiagonalTRecover fp
        (H_hat i i) (T_hat i prev) (L_hat i prev)) ∧
  (∀ i next : Fin n, next.val = i.val + 1 →
    T_hat next i = H_hat next i) ∧
  (∀ i next : Fin n, next.val = i.val + 1 →
    T_hat i next = H_hat next i) ∧
  (∀ i j : Fin n, i.val + 1 < j.val ∨ j.val + 1 < i.val → T_hat i j = 0)

/-- The computed-`T` recovery storage rules force tridiagonal sparsity. -/
theorem higham11_11_fl_aasenComputedTRecoveries_tridiagonal
    (n : ℕ) (fp : FPModel) (H_hat L_hat T_hat : Fin n → Fin n → ℝ)
    (hcomp : higham11_11_fl_aasenComputedTRecoveries n fp H_hat L_hat T_hat) :
    IsTridiagonal n T_hat := by
  rcases hcomp with ⟨_, _, _, _, hoff⟩
  exact hoff

/-- The copied subdiagonal/superdiagonal storage rules make the recovered
computed middle factor symmetric. -/
theorem higham11_11_fl_aasenComputedTRecoveries_symmetric
    (n : ℕ) (fp : FPModel) (H_hat L_hat T_hat : Fin n → Fin n → ℝ)
    (hcomp : higham11_11_fl_aasenComputedTRecoveries n fp H_hat L_hat T_hat) :
    ∀ i j : Fin n, T_hat i j = T_hat j i := by
  rcases hcomp with ⟨_, _, hsub, hsuper, hoff⟩
  intro i j
  by_cases hij : i = j
  · subst j
    rfl
  · by_cases hlt : i.val < j.val
    · by_cases hsucc : j.val = i.val + 1
      · calc
          T_hat i j = H_hat j i := hsuper i j hsucc
          _ = T_hat j i := (hsub i j hsucc).symm
      · have hfar : i.val + 1 < j.val := by omega
        rw [hoff i j (Or.inl hfar), hoff j i (Or.inr hfar)]
    · have hval_ne : i.val ≠ j.val := by
        intro hval
        exact hij (Fin.ext hval)
      have hgt : j.val < i.val := by omega
      by_cases hsucc : i.val = j.val + 1
      · calc
          T_hat i j = H_hat i j := hsub j i hsucc
          _ = T_hat j i := (hsuper j i hsucc).symm
      · have hfar : j.val + 1 < i.val := by omega
        rw [hoff i j (Or.inr hfar), hoff j i (Or.inl hfar)]

/-- The computed-`T` recovery storage rules produce a symmetric tridiagonal
middle factor.  This is a structural result only; the relative perturbation
bound for `T_hat` is a separate obligation. -/
theorem higham11_11_fl_aasenComputedTRecoveries_symTridiagonal
    (n : ℕ) (fp : FPModel) (H_hat L_hat T_hat : Fin n → Fin n → ℝ)
    (hcomp : higham11_11_fl_aasenComputedTRecoveries n fp H_hat L_hat T_hat) :
    higham11_8_IsSymTridiagonal n T_hat := by
  constructor
  · exact higham11_11_fl_aasenComputedTRecoveries_symmetric
      n fp H_hat L_hat T_hat hcomp
  · exact higham11_11_fl_aasenComputedTRecoveries_tridiagonal
      n fp H_hat L_hat T_hat hcomp

/-- Local diagonal/subdiagonal recovery budgets for the computed `H_hat`
entries imply the global componentwise `T_hat - T` budget.  The diagonal
budget is stated directly for the recovered diagonal entries, while the
subdiagonal and superdiagonal budgets are stated on the corresponding
`H_hat next i` entry copied into `T_hat`. -/
theorem higham11_11_fl_aasenComputedTRecoveries_abs_error_of_local_bounds
    (n : ℕ) (fp : FPModel)
    (A L H T H_hat L_hat T_hat BT : Fin n → Fin n → ℝ)
    (σ : Fin n → Fin n)
    (hspec : higham11_8_AasenSpec n A L T σ)
    (hH_eq : ∀ i j : Fin n, H i j = higham11_10_aasenH n T L i j)
    (hcomp : higham11_11_fl_aasenComputedTRecoveries n fp H_hat L_hat T_hat)
    (hdiag : ∀ i : Fin n, |T_hat i i - T i i| ≤ BT i i)
    (hsub_lower : ∀ i next : Fin n, next.val = i.val + 1 →
      |H_hat next i - H next i| ≤ BT next i)
    (hsub_upper : ∀ i next : Fin n, next.val = i.val + 1 →
      |H_hat next i - H next i| ≤ BT i next)
    (hfar_nonneg : ∀ i j : Fin n,
      i.val + 1 < j.val ∨ j.val + 1 < i.val → 0 ≤ BT i j) :
    ∀ i j : Fin n, |T_hat i j - T i j| ≤ BT i j := by
  rcases hcomp with ⟨_, _, hcopy_sub, hcopy_super, hoff⟩
  have hHsub :
      ∀ i next : Fin n, next.val = i.val + 1 → H next i = T next i :=
    higham11_8_AasenSpec_identity_H_subdiagonal_eq_T_of_H_eq
      n A L H T σ hspec hH_eq
  intro i j
  by_cases hij : i = j
  · subst j
    exact hdiag i
  · by_cases hlt : i.val < j.val
    · by_cases hsucc : j.val = i.val + 1
      · have hrewrite :
            |T_hat i j - T i j| = |H_hat j i - H j i| := by
          rw [hcopy_super i j hsucc, hspec.T_tridiag.1 i j, ← hHsub i j hsucc]
        rw [hrewrite]
        exact hsub_upper i j hsucc
      · have hfar : i.val + 1 < j.val := by omega
        have hThat_zero : T_hat i j = 0 := hoff i j (Or.inl hfar)
        have hT_zero : T i j = 0 := hspec.T_tridiag.2 i j (Or.inl hfar)
        rw [hThat_zero, hT_zero]
        simpa using hfar_nonneg i j (Or.inl hfar)
    · have hval_ne : i.val ≠ j.val := by
        intro hval
        exact hij (Fin.ext hval)
      have hgt : j.val < i.val := by omega
      by_cases hsucc : i.val = j.val + 1
      · have hrewrite :
            |T_hat i j - T i j| = |H_hat i j - H i j| := by
          rw [hcopy_sub j i hsucc, ← hHsub j i hsucc]
        rw [hrewrite]
        exact hsub_lower j i hsucc
      · have hfar : j.val + 1 < i.val := by omega
        have hThat_zero : T_hat i j = 0 := hoff i j (Or.inr hfar)
        have hT_zero : T i j = 0 := hspec.T_tridiag.2 i j (Or.inr hfar)
        rw [hThat_zero, hT_zero]
        simpa using hfar_nonneg i j (Or.inr hfar)

/-- Source-shaped relative version of
`higham11_11_fl_aasenComputedTRecoveries_abs_error_of_local_bounds`: local
relative bounds on the recovered diagonal entries and copied `H_hat`
subdiagonal entries give the global relative middle-factor comparison
`|T_hat-T| ≤ γ |T_hat|`. -/
theorem higham11_11_fl_aasenComputedTRecoveries_relative_error_of_local_bounds
    (n : ℕ) (fp : FPModel)
    (A L H T H_hat L_hat T_hat : Fin n → Fin n → ℝ)
    (σ : Fin n → Fin n) (γ : ℝ) (hγ : 0 ≤ γ)
    (hspec : higham11_8_AasenSpec n A L T σ)
    (hH_eq : ∀ i j : Fin n, H i j = higham11_10_aasenH n T L i j)
    (hcomp : higham11_11_fl_aasenComputedTRecoveries n fp H_hat L_hat T_hat)
    (hdiag : ∀ i : Fin n, |T_hat i i - T i i| ≤ γ * |T_hat i i|)
    (hsub_lower : ∀ i next : Fin n, next.val = i.val + 1 →
      |H_hat next i - H next i| ≤ γ * |T_hat next i|)
    (hsub_upper : ∀ i next : Fin n, next.val = i.val + 1 →
      |H_hat next i - H next i| ≤ γ * |T_hat i next|) :
    ∀ i j : Fin n, |T_hat i j - T i j| ≤ γ * |T_hat i j| := by
  exact
    higham11_11_fl_aasenComputedTRecoveries_abs_error_of_local_bounds
      n fp A L H T H_hat L_hat T_hat (fun i j => γ * |T_hat i j|)
      σ hspec hH_eq hcomp hdiag hsub_lower hsub_upper
      (fun i j _ => mul_nonneg hγ (abs_nonneg _))

/-- Source-length floating-point dot product for the prefix sum in Aasen's
diagonal recurrence (11.12).  The vector has length `i.val`, matching the
source prefix `j = 0, ..., i-1`. -/
noncomputable def higham11_12_fl_aasenDiagonalSourcePrefixDot (n : ℕ)
    (fp : FPModel) (L H : Fin n → Fin n → ℝ) (i : Fin n) : ℝ :=
  fl_dotProduct fp i.val
    (fun j : Fin i.val => L i ⟨j.val, Nat.lt_trans j.isLt i.isLt⟩)
    (fun j : Fin i.val => H ⟨j.val, Nat.lt_trans j.isLt i.isLt⟩ i)

/-- **Equation (11.12) source-prefix formation error**.  The rounded dot
product over the source-length prefix `j = 0, ..., i-1` has a `gamma_i`-style
additive residual and reindexes to the masked `j < i` Aasen sum. -/
theorem higham11_12_fl_aasen_diagonal_source_prefix_dot_abs_error (n : ℕ)
    (fp : FPModel) (L H : Fin n → Fin n → ℝ) (i : Fin n)
    (hval : gammaValid fp i.val) :
    ∃ Δ : ℝ,
      |Δ| ≤ gamma fp i.val *
        ∑ j : Fin i.val,
          |L i ⟨j.val, Nat.lt_trans j.isLt i.isLt⟩| *
            |H ⟨j.val, Nat.lt_trans j.isLt i.isLt⟩ i| ∧
      higham11_12_fl_aasenDiagonalSourcePrefixDot n fp L H i =
        (∑ j : Fin n, if j.val < i.val then L i j * H j i else 0) + Δ := by
  let x : Fin i.val → ℝ :=
    fun j => L i ⟨j.val, Nat.lt_trans j.isLt i.isLt⟩
  let y : Fin i.val → ℝ :=
    fun j => H ⟨j.val, Nat.lt_trans j.isLt i.isLt⟩ i
  have hbound := dotProduct_error_bound fp i.val x y hval
  have hprefix :
      (∑ j : Fin i.val, x j * y j) =
        ∑ j : Fin i.val,
          L i ⟨j.val, Nat.lt_trans j.isLt i.isLt⟩ *
            H ⟨j.val, Nat.lt_trans j.isLt i.isLt⟩ i := by
    apply Finset.sum_congr rfl
    intro j _
    simp [x, y]
  have hmasked :=
    finMaskedPrefixSum_eq_finSum i (fun j : Fin n => L i j * H j i)
  have hsum :
      (∑ j : Fin i.val, x j * y j) =
        ∑ j : Fin n, if j.val < i.val then L i j * H j i else 0 := by
    calc
      (∑ j : Fin i.val, x j * y j)
          = ∑ j : Fin i.val,
              L i ⟨j.val, Nat.lt_trans j.isLt i.isLt⟩ *
                H ⟨j.val, Nat.lt_trans j.isLt i.isLt⟩ i := hprefix
      _ = (∑ j : Fin n, if j.val < i.val then L i j * H j i else 0) :=
        hmasked.symm
  refine
    ⟨higham11_12_fl_aasenDiagonalSourcePrefixDot n fp L H i -
        (∑ j : Fin n, if j.val < i.val then L i j * H j i else 0), ?_, ?_⟩
  · simpa [higham11_12_fl_aasenDiagonalSourcePrefixDot, x, y, hsum] using hbound
  · ring

/-- Rounded scalar value for the computed diagonal middle entry in Aasen's
recurrence (11.12), after forming the source-prefix dot product. -/
noncomputable def higham11_12_fl_aasenDiagonalH (n : ℕ)
    (fp : FPModel) (A L H : Fin n → Fin n → ℝ) (i : Fin n) : ℝ :=
  fp.fl_sub (A i i) (higham11_12_fl_aasenDiagonalSourcePrefixDot n fp L H i)

/-- **Equation (11.12) formed-prefix diagonal update**, relative-error form.
Under the exact Aasen diagonal recurrence, the rounded diagonal update equals
`(H i i - Δs) * (1 + δ)`, where `Δs` is the source-prefix dot residual and
`δ` is the final rounded subtraction residual. -/
theorem higham11_12_fl_aasen_diagonal_formed_sum_rel_error_of_exact_recurrence
    (n : ℕ) (fp : FPModel) (A L H : Fin n → Fin n → ℝ)
    (hrec : higham11_12_aasenDiagonalEquation n A L H)
    (i : Fin n) (hvalSum : gammaValid fp i.val) :
    let Bsum : ℝ :=
      gamma fp i.val *
        ∑ j : Fin i.val,
          |L i ⟨j.val, Nat.lt_trans j.isLt i.isLt⟩| *
            |H ⟨j.val, Nat.lt_trans j.isLt i.isLt⟩ i|
    ∃ Δs δ : ℝ,
      |Δs| ≤ Bsum ∧
      |δ| ≤ fp.u ∧
      higham11_12_fl_aasenDiagonalH n fp A L H i =
        (H i i - Δs) * (1 + δ) := by
  let Bsum : ℝ :=
    gamma fp i.val *
      ∑ j : Fin i.val,
        |L i ⟨j.val, Nat.lt_trans j.isLt i.isLt⟩| *
          |H ⟨j.val, Nat.lt_trans j.isLt i.isLt⟩ i|
  obtain ⟨Δs, hΔs, hsumfl⟩ :=
    higham11_12_fl_aasen_diagonal_source_prefix_dot_abs_error n fp L H i hvalSum
  obtain ⟨δ, hδ, hfl⟩ :=
    fp.model_sub (A i i) (higham11_12_fl_aasenDiagonalSourcePrefixDot n fp L H i)
  refine ⟨Δs, δ, ?_, hδ, ?_⟩
  · simpa [Bsum] using hΔs
  · have harg :
        A i i - higham11_12_fl_aasenDiagonalSourcePrefixDot n fp L H i =
          H i i - Δs := by
      rw [hsumfl, hrec i]
      ring
    rw [higham11_12_fl_aasenDiagonalH, hfl, harg]

/-- **Equation (11.12) formed-prefix diagonal update**, additive-error form.
This keeps the prefix-dot residual and the final subtraction residual separate,
which is the local computed-`H` ingredient used before (11.11) recovers the
corresponding tridiagonal `T` entry. -/
theorem higham11_12_fl_aasen_diagonal_formed_sum_abs_error_of_exact_recurrence
    (n : ℕ) (fp : FPModel) (A L H : Fin n → Fin n → ℝ)
    (hrec : higham11_12_aasenDiagonalEquation n A L H)
    (i : Fin n) (hvalSum : gammaValid fp i.val) :
    let Bsum : ℝ :=
      gamma fp i.val *
        ∑ j : Fin i.val,
          |L i ⟨j.val, Nat.lt_trans j.isLt i.isLt⟩| *
            |H ⟨j.val, Nat.lt_trans j.isLt i.isLt⟩ i|
    ∃ Δs Δu : ℝ,
      |Δs| ≤ Bsum ∧
      |Δu| ≤ fp.u * |H i i - Δs| ∧
      higham11_12_fl_aasenDiagonalH n fp A L H i = H i i - Δs + Δu := by
  obtain ⟨Δs, δ, hΔs, hδ, hfl⟩ :=
    higham11_12_fl_aasen_diagonal_formed_sum_rel_error_of_exact_recurrence
      n fp A L H hrec i hvalSum
  refine ⟨Δs, (H i i - Δs) * δ, hΔs, ?_, ?_⟩
  · calc
      |(H i i - Δs) * δ|
          = |H i i - Δs| * |δ| := abs_mul _ _
      _ ≤ |H i i - Δs| * fp.u :=
          mul_le_mul_of_nonneg_left hδ (abs_nonneg _)
      _ = fp.u * |H i i - Δs| := by ring
  · rw [hfl]
    ring

/-- Source-length floating-point dot product for the prefix sum in Aasen's
subdiagonal recurrence (11.13).  When `next = i+1`, the vector has length
`next.val`, matching the source prefix `j = 0, ..., i`. -/
noncomputable def higham11_13_fl_aasenSubdiagonalSourcePrefixDot (n : ℕ)
    (fp : FPModel) (L H : Fin n → Fin n → ℝ)
    (i next : Fin n) : ℝ :=
  fl_dotProduct fp next.val
    (fun j : Fin next.val => L next ⟨j.val, Nat.lt_trans j.isLt next.isLt⟩)
    (fun j : Fin next.val => H ⟨j.val, Nat.lt_trans j.isLt next.isLt⟩ i)

/-- **Equation (11.13) source-prefix formation error**.  The rounded dot
product over the source-length prefix `j = 0, ..., i` has a
`gamma_{i+1}`-style additive residual and reindexes to the masked `j <= i`
Aasen sum. -/
theorem higham11_13_fl_aasen_subdiagonal_source_prefix_dot_abs_error (n : ℕ)
    (fp : FPModel) (L H : Fin n → Fin n → ℝ) (i next : Fin n)
    (hnext : next.val = i.val + 1) (hval : gammaValid fp next.val) :
    ∃ Δ : ℝ,
      |Δ| ≤ gamma fp next.val *
        ∑ j : Fin next.val,
          |L next ⟨j.val, Nat.lt_trans j.isLt next.isLt⟩| *
            |H ⟨j.val, Nat.lt_trans j.isLt next.isLt⟩ i| ∧
      higham11_13_fl_aasenSubdiagonalSourcePrefixDot n fp L H i next =
        (∑ j : Fin n, if j.val ≤ i.val then L next j * H j i else 0) + Δ := by
  let x : Fin next.val → ℝ :=
    fun j => L next ⟨j.val, Nat.lt_trans j.isLt next.isLt⟩

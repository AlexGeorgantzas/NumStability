/-- Branch-local entry caps for `|L̂|` imply the path-local row-sum predicate,
with row-dependent entry and row-sum budgets.  This is the local path analogue
of the global entry-to-row-sum bridge used by the Theorem 11.4 product route. -/
theorem higham11_4_BunchKaufmanPathLocalLRowSumBound_of_local_entry_bounds
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (L : Fin (higham11_4_bunchKaufmanPathPivotSpan k step) →
      Fin (higham11_4_bunchKaufmanPathPivotSpan k step) → ℝ)
    (Lcap Lrow : Fin (higham11_4_bunchKaufmanPathPivotSpan k step) → ℝ)
    (hentry :
      ∀ t : Fin k,
        ∀ i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)),
          ∀ q : Fin (higham11_4_bunchKaufmanPathPivotSpan k step),
            |L (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i) q| ≤
              Lcap (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i))
    (hbudget :
      ∀ t : Fin k,
        ∀ i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)),
          (higham11_4_bunchKaufmanPathPivotSpan k step : ℝ) *
              Lcap (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i) ≤
            Lrow (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i)) :
    higham11_4_BunchKaufmanPathLocalLRowSumBound k step L Lrow := by
  intro t i
  calc
    (∑ q : Fin (higham11_4_bunchKaufmanPathPivotSpan k step),
        |L (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i) q|)
        ≤ ∑ _q : Fin (higham11_4_bunchKaufmanPathPivotSpan k step),
            Lcap (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i) := by
          exact Finset.sum_le_sum (fun q _ => hentry t i q)
    _ = (higham11_4_bunchKaufmanPathPivotSpan k step : ℝ) *
          Lcap (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i) := by
        simp
    _ ≤ Lrow (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i) :=
        hbudget t i

/-- Uniform branch-local entry caps for `|L̂|` imply a uniform path-local
row-sum predicate. -/
theorem higham11_4_BunchKaufmanPathLocalLRowSumBound_of_uniform_entry_bound

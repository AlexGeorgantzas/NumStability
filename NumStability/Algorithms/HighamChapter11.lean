/-- If `u` is the immediate successor of `t` in an active Bunch-Kaufman pivot
path, then the end of branch `t` is exactly the prefix of branch `u`. -/
theorem higham11_4_bunchKaufmanPathPrefixSpan_branch_end_eq_of_succ
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) {t u : Fin k}
    (htu : t.val + 1 = u.val) :
    higham11_4_bunchKaufmanPathPrefixSpan k step t +
        higham11_4_bunchKaufmanBranchSupportOffset (step t) =
      higham11_4_bunchKaufmanPathPrefixSpan k step u := by
  obtain ⟨starts, hstarts⟩ :=
    higham11_4_bunchKaufmanPathStartOffsets_exists k step
  have hnext : t.val + 1 < k := by
    rw [htu]
    exact u.isLt
  have hsucc :=
    higham11_4_bunchKaufmanPathStartOffsets_succ k step starts hstarts t hnext
  have hidx : (⟨t.val + 1, hnext⟩ : Fin k) = u := by
    apply Fin.ext
    simp [htu]
  rw [hidx] at hsucc
  have hpref_t :=
    higham11_4_bunchKaufmanPathStartOffsets_eq_prefixSpan
      k step starts hstarts t
  have hpref_u :=
    higham11_4_bunchKaufmanPathStartOffsets_eq_prefixSpan
      k step starts hstarts u
  rw [hpref_t, hpref_u] at hsucc
  exact hsucc.symm

/-- Explicit prefix spans are strictly ordered by path index. -/
theorem higham11_4_bunchKaufmanPathPrefixSpan_lt_of_lt
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) {t u : Fin k}
    (htu : t.val < u.val) :
    higham11_4_bunchKaufmanPathPrefixSpan k step t <
      higham11_4_bunchKaufmanPathPrefixSpan k step u := by
  obtain ⟨starts, hstarts⟩ :=
    higham11_4_bunchKaufmanPathStartOffsets_exists k step
  have hpref_t :=
    higham11_4_bunchKaufmanPathStartOffsets_eq_prefixSpan
      k step starts hstarts t
  have hpref_u :=
    higham11_4_bunchKaufmanPathStartOffsets_eq_prefixSpan
      k step starts hstarts u
  have hlt :=
    higham11_4_bunchKaufmanPathStartOffsets_lt_of_lt
      k step starts hstarts htu
  simpa [hpref_t, hpref_u] using hlt

/-- Explicit prefix spans are monotone by path index. -/
theorem higham11_4_bunchKaufmanPathPrefixSpan_le_of_le
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) {t u : Fin k}
    (htu : t.val ≤ u.val) :
    higham11_4_bunchKaufmanPathPrefixSpan k step t ≤
      higham11_4_bunchKaufmanPathPrefixSpan k step u := by
  obtain ⟨starts, hstarts⟩ :=
    higham11_4_bunchKaufmanPathStartOffsets_exists k step
  have hpref_t :=
    higham11_4_bunchKaufmanPathStartOffsets_eq_prefixSpan
      k step starts hstarts t
  have hpref_u :=
    higham11_4_bunchKaufmanPathStartOffsets_eq_prefixSpan
      k step starts hstarts u
  have hle :=
    higham11_4_bunchKaufmanPathStartOffsets_le_of_le
      k step starts hstarts htu
  simpa [hpref_t, hpref_u] using hle

/-- Explicit prefix branch endpoints are monotone by path index. -/
theorem higham11_4_bunchKaufmanPathPrefixSpan_branch_end_le_branch_end_of_le
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) {t u : Fin k}
    (htu : t.val ≤ u.val) :
    higham11_4_bunchKaufmanPathPrefixSpan k step t +
        higham11_4_bunchKaufmanBranchSupportOffset (step t) ≤
      higham11_4_bunchKaufmanPathPrefixSpan k step u +
        higham11_4_bunchKaufmanBranchSupportOffset (step u) := by
  obtain ⟨starts, hstarts⟩ :=
    higham11_4_bunchKaufmanPathStartOffsets_exists k step
  have hpref_t :=
    higham11_4_bunchKaufmanPathStartOffsets_eq_prefixSpan
      k step starts hstarts t
  have hpref_u :=
    higham11_4_bunchKaufmanPathStartOffsets_eq_prefixSpan
      k step starts hstarts u
  have hle :=
    higham11_4_bunchKaufmanPathStartOffsets_branch_end_le_branch_end_of_le
      k step starts hstarts htu
  simpa [hpref_t, hpref_u] using hle

/-- Earlier explicit prefix branch endpoints are strictly before later branch
endpoints in an active Bunch-Kaufman pivot path. -/
theorem higham11_4_bunchKaufmanPathPrefixSpan_branch_end_lt_branch_end_of_lt
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) {t u : Fin k}
    (htu : t.val < u.val) :
    higham11_4_bunchKaufmanPathPrefixSpan k step t +
        higham11_4_bunchKaufmanBranchSupportOffset (step t) <
      higham11_4_bunchKaufmanPathPrefixSpan k step u +
        higham11_4_bunchKaufmanBranchSupportOffset (step u) := by
  have hle :=
    higham11_4_bunchKaufmanPathPrefixSpan_branch_end_le_of_lt
      k step htu
  have hpos := higham11_4_bunchKaufmanBranchSupportOffset_pos (step u)
  omega

/-- A branch-local pivot slot lies inside the total consumed span of an active
Bunch-Kaufman pivot path. -/
theorem higham11_4_bunchKaufmanPath_local_index_lt_pivotSpan
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) (t : Fin k)
    (i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t))) :
    higham11_4_bunchKaufmanPathPrefixSpan k step t + i.val <
      higham11_4_bunchKaufmanPathPivotSpan k step := by
  have hend :=
    higham11_4_bunchKaufmanPathPrefixSpan_branch_end_le_pivotSpan
      k step t
  have hi := i.isLt
  omega

/-- Embed a branch-local pivot slot as an index into the full consumed active
Bunch-Kaufman path span. -/
def higham11_4_bunchKaufmanPathLocalPivotIndex
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) (t : Fin k)
    (i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t))) :
    Fin (higham11_4_bunchKaufmanPathPivotSpan k step) :=
  ⟨higham11_4_bunchKaufmanPathPrefixSpan k step t + i.val,
    higham11_4_bunchKaufmanPath_local_index_lt_pivotSpan k step t i⟩

@[simp] theorem higham11_4_bunchKaufmanPathLocalPivotIndex_val
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) (t : Fin k)
    (i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t))) :
    (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i).val =
      higham11_4_bunchKaufmanPathPrefixSpan k step t + i.val :=
  rfl

/-- Local slot embedding is injective within each active path branch. -/
theorem higham11_4_bunchKaufmanPathLocalPivotIndex_injective
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) (t : Fin k) :
    Function.Injective
      (fun i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)) =>
        higham11_4_bunchKaufmanPathLocalPivotIndex k step t i) := by
  intro i j hij
  apply Fin.ext
  have hval :
      (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i).val =
        (higham11_4_bunchKaufmanPathLocalPivotIndex k step t j).val :=
    congrArg Fin.val hij
  have hsum :
      higham11_4_bunchKaufmanPathPrefixSpan k step t + i.val =
        higham11_4_bunchKaufmanPathPrefixSpan k step t + j.val := by
    simpa using hval
  omega

/-- The embedded branch-local pivot index starts at or after the branch prefix. -/
theorem higham11_4_bunchKaufmanPathLocalPivotIndex_prefix_le
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) (t : Fin k)
    (i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t))) :
    higham11_4_bunchKaufmanPathPrefixSpan k step t ≤
      (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i).val := by
  simp [higham11_4_bunchKaufmanPathLocalPivotIndex]

/-- The embedded branch-local pivot index is strictly before the branch end. -/
theorem higham11_4_bunchKaufmanPathLocalPivotIndex_lt_branch_end
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) (t : Fin k)
    (i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t))) :
    (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i).val <
      higham11_4_bunchKaufmanPathPrefixSpan k step t +
        higham11_4_bunchKaufmanBranchSupportOffset (step t) := by
  simp [higham11_4_bunchKaufmanPathLocalPivotIndex]

/-- The embedded local pivot index is exactly in its branch interval. -/
theorem higham11_4_bunchKaufmanPathLocalPivotIndex_branch_interval
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) (t : Fin k)
    (i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t))) :
    higham11_4_bunchKaufmanPathPrefixSpan k step t ≤
        (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i).val ∧
      (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i).val <
        higham11_4_bunchKaufmanPathPrefixSpan k step t +
          higham11_4_bunchKaufmanBranchSupportOffset (step t) := by
  exact
    ⟨higham11_4_bunchKaufmanPathLocalPivotIndex_prefix_le k step t i,
      higham11_4_bunchKaufmanPathLocalPivotIndex_lt_branch_end k step t i⟩

/-- The range of the branch-local pivot-slot embedding is exactly the branch's
half-open interval inside the full consumed path span. -/
theorem higham11_4_bunchKaufmanPathLocalPivotIndex_mem_range_iff
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) (t : Fin k)
    (j : Fin (higham11_4_bunchKaufmanPathPivotSpan k step)) :
    (∃ i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)),
      higham11_4_bunchKaufmanPathLocalPivotIndex k step t i = j) ↔
      higham11_4_bunchKaufmanPathPrefixSpan k step t ≤ j.val ∧
        j.val <
          higham11_4_bunchKaufmanPathPrefixSpan k step t +
            higham11_4_bunchKaufmanBranchSupportOffset (step t) := by
  constructor
  · rintro ⟨i, hi⟩
    have hval :
        higham11_4_bunchKaufmanPathPrefixSpan k step t + i.val = j.val := by
      simpa using congrArg Fin.val hi
    constructor <;> omega
  · rintro ⟨hjlo, hjhi⟩
    let i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)) :=
      ⟨j.val - higham11_4_bunchKaufmanPathPrefixSpan k step t, by
        omega⟩
    refine ⟨i, ?_⟩
    apply Fin.ext
    simp [i, higham11_4_bunchKaufmanPathLocalPivotIndex]
    omega

/-- A full path index has no local preimage in a branch exactly when it lies
before the branch prefix or at/after the branch end. -/
theorem higham11_4_bunchKaufmanPathLocalPivotIndex_not_exists_iff_lt_prefixSpan_or_branch_end_le
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) (t : Fin k)
    (j : Fin (higham11_4_bunchKaufmanPathPivotSpan k step)) :
    (¬ ∃ i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)),
      higham11_4_bunchKaufmanPathLocalPivotIndex k step t i = j) ↔
      j.val < higham11_4_bunchKaufmanPathPrefixSpan k step t ∨
        higham11_4_bunchKaufmanPathPrefixSpan k step t +
          higham11_4_bunchKaufmanBranchSupportOffset (step t) ≤ j.val := by
  rw [higham11_4_bunchKaufmanPathLocalPivotIndex_mem_range_iff]
  constructor
  · intro hnot
    by_cases hjlo : higham11_4_bunchKaufmanPathPrefixSpan k step t ≤ j.val
    · right
      exact le_of_not_gt (fun hjhi => hnot ⟨hjlo, hjhi⟩)
    · left
      exact Nat.lt_of_not_ge hjlo
  · intro haway hin
    rcases haway with hlt | hge
    · exact (not_lt_of_ge hin.1) hlt
    · exact (not_lt_of_ge hge) hin.2

/-- A full path index strictly before a branch prefix has no local preimage in
that branch. -/
theorem higham11_4_bunchKaufmanPathLocalPivotIndex_not_exists_of_lt_prefixSpan
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) (t : Fin k)
    (j : Fin (higham11_4_bunchKaufmanPathPivotSpan k step))
    (hj : j.val < higham11_4_bunchKaufmanPathPrefixSpan k step t) :
    ¬ ∃ i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)),
      higham11_4_bunchKaufmanPathLocalPivotIndex k step t i = j :=
  (higham11_4_bunchKaufmanPathLocalPivotIndex_not_exists_iff_lt_prefixSpan_or_branch_end_le
    k step t j).2 (Or.inl hj)

/-- A full path index at or after a branch end has no local preimage in that
branch. -/
theorem higham11_4_bunchKaufmanPathLocalPivotIndex_not_exists_of_branch_end_le
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) (t : Fin k)
    (j : Fin (higham11_4_bunchKaufmanPathPivotSpan k step))
    (hj :
      higham11_4_bunchKaufmanPathPrefixSpan k step t +
        higham11_4_bunchKaufmanBranchSupportOffset (step t) ≤ j.val) :
    ¬ ∃ i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)),
      higham11_4_bunchKaufmanPathLocalPivotIndex k step t i = j :=
  (higham11_4_bunchKaufmanPathLocalPivotIndex_not_exists_iff_lt_prefixSpan_or_branch_end_le
    k step t j).2 (Or.inr hj)

/-- Every consumed global pivot-path index is represented by some branch-local
pivot slot. -/
theorem higham11_4_bunchKaufmanPathLocalPivotIndex_exists_of_global_index
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (j : Fin (higham11_4_bunchKaufmanPathPivotSpan k step)) :
    ∃ t : Fin k, ∃ i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)),
      higham11_4_bunchKaufmanPathLocalPivotIndex k step t i = j := by
  induction k with
  | zero =>
      have hj := j.isLt
      simp [higham11_4_bunchKaufmanPathPivotSpan_zero] at hj
  | succ k ih =>
      let tailStep : Fin k → higham11_4_BunchKaufmanActiveBranch :=
        fun t => step t.succ
      have hspan_cons :
          higham11_4_bunchKaufmanPathPivotSpan (k + 1) step =
            higham11_4_bunchKaufmanBranchSupportOffset (step 0) +
              higham11_4_bunchKaufmanPathPivotSpan k tailStep := by
        simpa [tailStep] using
          higham11_4_bunchKaufmanPathPivotSpan_cons k step
      by_cases hjhead :
          j.val < higham11_4_bunchKaufmanBranchSupportOffset (step 0)
      · let i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step 0)) :=
          ⟨j.val, hjhead⟩
        refine ⟨0, i, ?_⟩
        apply Fin.ext
        simp [i, higham11_4_bunchKaufmanPathLocalPivotIndex,
          higham11_4_bunchKaufmanPathPrefixSpan_zero]
      · have hjlo :
            higham11_4_bunchKaufmanBranchSupportOffset (step 0) ≤ j.val :=
          Nat.le_of_not_gt hjhead
        let jtail : Fin (higham11_4_bunchKaufmanPathPivotSpan k tailStep) :=
          ⟨j.val - higham11_4_bunchKaufmanBranchSupportOffset (step 0), by
            have hjhi := j.isLt
            omega⟩
        have hjval :
            j.val =
              higham11_4_bunchKaufmanBranchSupportOffset (step 0) +
                jtail.val := by
          dsimp [jtail]
          omega
        rcases ih tailStep jtail with ⟨t, i, hi⟩
        refine ⟨t.succ, i, ?_⟩
        apply Fin.ext
        have hi_val :
            (higham11_4_bunchKaufmanPathLocalPivotIndex k tailStep t i).val =
              jtail.val :=
          congrArg Fin.val hi
        simp [higham11_4_bunchKaufmanPathLocalPivotIndex,
          higham11_4_bunchKaufmanPathPrefixSpan_succ, tailStep] at hi_val ⊢
        omega

/-- The leading local pivot slot of any active branch. -/
def higham11_4_bunchKaufmanBranchLeadingLocalIndex
    (s : higham11_4_BunchKaufmanActiveBranch) :
    Fin (higham11_4_bunchKaufmanBranchSupportOffset s) :=
  ⟨0, higham11_4_bunchKaufmanBranchSupportOffset_pos s⟩

@[simp] theorem higham11_4_bunchKaufmanBranchLeadingLocalIndex_val
    (s : higham11_4_BunchKaufmanActiveBranch) :
    (higham11_4_bunchKaufmanBranchLeadingLocalIndex s).val = 0 :=
  rfl

/-- In a scalar active Bunch-Kaufman branch, every branch-local pivot slot is
the leading slot. -/
theorem higham11_4_bunchKaufmanBranchLocalIndex_eq_leading_of_not_case4
    (s : higham11_4_BunchKaufmanActiveBranch)
    (hs : s ≠ higham11_4_BunchKaufmanActiveBranch.case4)
    (i : Fin (higham11_4_bunchKaufmanBranchSupportOffset s)) :
    i = higham11_4_bunchKaufmanBranchLeadingLocalIndex s := by
  cases s
  · fin_cases i
    rfl
  · fin_cases i
    rfl
  · fin_cases i
    rfl
  · exact (hs rfl).elim

/-- The final local pivot slot of an active branch.  For scalar branches this is
the leading slot; for the case-(4) 2 by 2 branch it is the second slot. -/
def higham11_4_bunchKaufmanBranchLastLocalIndex
    (s : higham11_4_BunchKaufmanActiveBranch) :
    Fin (higham11_4_bunchKaufmanBranchSupportOffset s) :=
  ⟨higham11_4_bunchKaufmanBranchSupportOffset s - 1, by
    have hpos := higham11_4_bunchKaufmanBranchSupportOffset_pos s
    omega⟩

@[simp] theorem higham11_4_bunchKaufmanBranchLastLocalIndex_val
    (s : higham11_4_BunchKaufmanActiveBranch) :
    (higham11_4_bunchKaufmanBranchLastLocalIndex s).val =
      higham11_4_bunchKaufmanBranchSupportOffset s - 1 :=
  rfl

/-- The leading global pivot index for a branch in an active path. -/
def higham11_4_bunchKaufmanPathLeadingPivotIndex
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) (t : Fin k) :
    Fin (higham11_4_bunchKaufmanPathPivotSpan k step) :=
  higham11_4_bunchKaufmanPathLocalPivotIndex k step t
    (higham11_4_bunchKaufmanBranchLeadingLocalIndex (step t))

@[simp] theorem higham11_4_bunchKaufmanPathLeadingPivotIndex_val
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) (t : Fin k) :
    (higham11_4_bunchKaufmanPathLeadingPivotIndex k step t).val =
      higham11_4_bunchKaufmanPathPrefixSpan k step t := by
  simp [higham11_4_bunchKaufmanPathLeadingPivotIndex]

/-- The final global pivot index for a branch in an active path. -/
def higham11_4_bunchKaufmanPathLastPivotIndex
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) (t : Fin k) :
    Fin (higham11_4_bunchKaufmanPathPivotSpan k step) :=
  higham11_4_bunchKaufmanPathLocalPivotIndex k step t
    (higham11_4_bunchKaufmanBranchLastLocalIndex (step t))

@[simp] theorem higham11_4_bunchKaufmanPathLastPivotIndex_val
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) (t : Fin k) :
    (higham11_4_bunchKaufmanPathLastPivotIndex k step t).val =
      higham11_4_bunchKaufmanPathPrefixSpan k step t +
        (higham11_4_bunchKaufmanBranchSupportOffset (step t) - 1) := by
  simp [higham11_4_bunchKaufmanPathLastPivotIndex]

/-- The successor of a branch's final global pivot index is its branch end. -/
theorem higham11_4_bunchKaufmanPathLastPivotIndex_succ_val_eq_branch_end
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) (t : Fin k) :
    (higham11_4_bunchKaufmanPathLastPivotIndex k step t).val + 1 =
      higham11_4_bunchKaufmanPathPrefixSpan k step t +
        higham11_4_bunchKaufmanBranchSupportOffset (step t) := by
  have hpos := higham11_4_bunchKaufmanBranchSupportOffset_pos (step t)
  simp [higham11_4_bunchKaufmanPathLastPivotIndex,
    higham11_4_bunchKaufmanPathLocalPivotIndex,
    higham11_4_bunchKaufmanBranchLastLocalIndex]
  omega

/-- In a nonempty active Bunch-Kaufman pivot path, a head branch-local slot
embeds at the same numeric index in the full path. -/
theorem higham11_4_bunchKaufmanPathLocalPivotIndex_zero_val
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch)
    (i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step 0))) :
    (higham11_4_bunchKaufmanPathLocalPivotIndex (k + 1) step 0 i).val = i.val := by
  simp [higham11_4_bunchKaufmanPathLocalPivotIndex,
    higham11_4_bunchKaufmanPathPrefixSpan_zero]

/-- The leading pivot of the head branch is the first consumed path index. -/
theorem higham11_4_bunchKaufmanPathLeadingPivotIndex_zero_val
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch) :
    (higham11_4_bunchKaufmanPathLeadingPivotIndex (k + 1) step 0).val = 0 := by
  simpa [higham11_4_bunchKaufmanPathLeadingPivotIndex] using
    higham11_4_bunchKaufmanPathLocalPivotIndex_zero_val k step
      (higham11_4_bunchKaufmanBranchLeadingLocalIndex (step 0))

/-- The final pivot of the head branch is one less than the head branch span. -/
theorem higham11_4_bunchKaufmanPathLastPivotIndex_zero_val
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch) :
    (higham11_4_bunchKaufmanPathLastPivotIndex (k + 1) step 0).val =
      higham11_4_bunchKaufmanBranchSupportOffset (step 0) - 1 := by
  simpa [higham11_4_bunchKaufmanPathLastPivotIndex] using
    higham11_4_bunchKaufmanPathLocalPivotIndex_zero_val k step
      (higham11_4_bunchKaufmanBranchLastLocalIndex (step 0))

/-- Tail branch-local embedding agrees with the original path embedding after
adding the head branch span. -/
theorem higham11_4_bunchKaufmanPathLocalPivotIndex_succ_val
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch)
    (t : Fin k)
    (i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t.succ))) :
    let tailStep : Fin k → higham11_4_BunchKaufmanActiveBranch := fun u => step u.succ
    (higham11_4_bunchKaufmanPathLocalPivotIndex (k + 1) step t.succ i).val =
      higham11_4_bunchKaufmanBranchSupportOffset (step 0) +
        (higham11_4_bunchKaufmanPathLocalPivotIndex k tailStep t i).val := by
  dsimp
  simp [higham11_4_bunchKaufmanPathPrefixSpan_succ]
  omega

/-- Tail leading-pivot embedding agrees with the original path embedding after
adding the head branch span. -/
theorem higham11_4_bunchKaufmanPathLeadingPivotIndex_succ_val
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch)
    (t : Fin k) :
    let tailStep : Fin k → higham11_4_BunchKaufmanActiveBranch := fun u => step u.succ
    (higham11_4_bunchKaufmanPathLeadingPivotIndex (k + 1) step t.succ).val =
      higham11_4_bunchKaufmanBranchSupportOffset (step 0) +
        (higham11_4_bunchKaufmanPathLeadingPivotIndex k tailStep t).val := by
  simpa [higham11_4_bunchKaufmanPathLeadingPivotIndex] using
    higham11_4_bunchKaufmanPathLocalPivotIndex_succ_val k step t
      (higham11_4_bunchKaufmanBranchLeadingLocalIndex (step t.succ))

/-- Tail final-pivot embedding agrees with the original path embedding after
adding the head branch span. -/
theorem higham11_4_bunchKaufmanPathLastPivotIndex_succ_val
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch)
    (t : Fin k) :
    let tailStep : Fin k → higham11_4_BunchKaufmanActiveBranch := fun u => step u.succ
    (higham11_4_bunchKaufmanPathLastPivotIndex (k + 1) step t.succ).val =
      higham11_4_bunchKaufmanBranchSupportOffset (step 0) +
        (higham11_4_bunchKaufmanPathLastPivotIndex k tailStep t).val := by
  simpa [higham11_4_bunchKaufmanPathLastPivotIndex] using
    higham11_4_bunchKaufmanPathLocalPivotIndex_succ_val k step t
      (higham11_4_bunchKaufmanBranchLastLocalIndex (step t.succ))

/-- Embed an index of the trailing active Bunch-Kaufman path into the original
nonempty path by shifting past the head branch. -/
def higham11_4_bunchKaufmanPathTailIndex
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch)
    (a : Fin (higham11_4_bunchKaufmanPathPivotSpan k (fun u : Fin k => step u.succ))) :
    Fin (higham11_4_bunchKaufmanPathPivotSpan (k + 1) step) :=
  ⟨higham11_4_bunchKaufmanBranchSupportOffset (step 0) + a.val, by
    rw [higham11_4_bunchKaufmanPathPivotSpan_cons]
    exact Nat.add_lt_add_left a.isLt _⟩

@[simp] theorem higham11_4_bunchKaufmanPathTailIndex_val
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch)
    (a : Fin (higham11_4_bunchKaufmanPathPivotSpan k (fun u : Fin k => step u.succ))) :
    (higham11_4_bunchKaufmanPathTailIndex k step a).val =
      higham11_4_bunchKaufmanBranchSupportOffset (step 0) + a.val :=
  rfl

/-- Tail-index embedding is injective. -/
theorem higham11_4_bunchKaufmanPathTailIndex_injective
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch) :
    Function.Injective (higham11_4_bunchKaufmanPathTailIndex k step) := by
  intro a b hab
  apply Fin.ext
  have hval := congrArg Fin.val hab
  dsimp [higham11_4_bunchKaufmanPathTailIndex] at hval
  omega

/-- Tail-index embedding agrees with branch-local embedding for every trailing
branch. -/
theorem higham11_4_bunchKaufmanPathTailIndex_localPivotIndex
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch)
    (t : Fin k)
    (i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t.succ))) :
    higham11_4_bunchKaufmanPathTailIndex k step
        (higham11_4_bunchKaufmanPathLocalPivotIndex k (fun u : Fin k => step u.succ) t i) =
      higham11_4_bunchKaufmanPathLocalPivotIndex (k + 1) step t.succ i := by
  apply Fin.ext
  simpa [higham11_4_bunchKaufmanPathTailIndex] using
    (higham11_4_bunchKaufmanPathLocalPivotIndex_succ_val k step t i).symm

/-- Tail-index embedding agrees with leading-pivot embedding for every trailing
branch. -/
theorem higham11_4_bunchKaufmanPathTailIndex_leadingPivotIndex
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch)
    (t : Fin k) :
    higham11_4_bunchKaufmanPathTailIndex k step
        (higham11_4_bunchKaufmanPathLeadingPivotIndex k (fun u : Fin k => step u.succ) t) =
      higham11_4_bunchKaufmanPathLeadingPivotIndex (k + 1) step t.succ := by
  apply Fin.ext
  simpa [higham11_4_bunchKaufmanPathTailIndex] using
    (higham11_4_bunchKaufmanPathLeadingPivotIndex_succ_val k step t).symm

/-- Tail-index embedding agrees with final-pivot embedding for every trailing
branch. -/
theorem higham11_4_bunchKaufmanPathTailIndex_lastPivotIndex
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch)
    (t : Fin k) :
    higham11_4_bunchKaufmanPathTailIndex k step
        (higham11_4_bunchKaufmanPathLastPivotIndex k (fun u : Fin k => step u.succ) t) =
      higham11_4_bunchKaufmanPathLastPivotIndex (k + 1) step t.succ := by
  apply Fin.ext
  simpa [higham11_4_bunchKaufmanPathTailIndex] using
    (higham11_4_bunchKaufmanPathLastPivotIndex_succ_val k step t).symm

/-- Every local pivot slot in an earlier active branch is strictly before every
local pivot slot in a later active branch. -/
theorem higham11_4_bunchKaufmanPathLocalPivotIndex_lt_of_branch_lt
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    {t u : Fin k} (htu : t.val < u.val)
    (i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)))
    (j : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step u))) :
    (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i).val <
      (higham11_4_bunchKaufmanPathLocalPivotIndex k step u j).val := by
  have hleft :=
    higham11_4_bunchKaufmanPathLocalPivotIndex_lt_branch_end k step t i
  have hbridge :=
    higham11_4_bunchKaufmanPathPrefixSpan_branch_end_le_of_lt k step htu
  have hright :=
    higham11_4_bunchKaufmanPathLocalPivotIndex_prefix_le k step u j
  omega

/-- Local pivot slots from a strictly earlier branch and a later branch cannot
embed to the same global path index. -/
theorem higham11_4_bunchKaufmanPathLocalPivotIndex_ne_of_branch_lt
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    {t u : Fin k} (htu : t.val < u.val)
    (i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)))
    (j : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step u))) :
    higham11_4_bunchKaufmanPathLocalPivotIndex k step t i ≠
      higham11_4_bunchKaufmanPathLocalPivotIndex k step u j := by
  intro hidx
  have hlt :=
    higham11_4_bunchKaufmanPathLocalPivotIndex_lt_of_branch_lt
      k step htu i j
  have hval :
      (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i).val =
        (higham11_4_bunchKaufmanPathLocalPivotIndex k step u j).val :=
    congrArg Fin.val hidx
  omega

/-- Local pivot slots from branches with different path positions cannot embed
to the same global path index. -/
theorem higham11_4_bunchKaufmanPathLocalPivotIndex_ne_of_branch_val_ne
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    {t u : Fin k} (htu : t.val ≠ u.val)
    (i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)))
    (j : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step u))) :
    higham11_4_bunchKaufmanPathLocalPivotIndex k step t i ≠
      higham11_4_bunchKaufmanPathLocalPivotIndex k step u j := by
  rcases lt_or_gt_of_ne htu with hlt | hgt
  · exact
      higham11_4_bunchKaufmanPathLocalPivotIndex_ne_of_branch_lt
        k step hlt i j
  · intro hidx
    exact
      higham11_4_bunchKaufmanPathLocalPivotIndex_ne_of_branch_lt
        k step hgt j i hidx.symm

/-- Local pivot slots from distinct path branches cannot embed to the same
global path index. -/
theorem higham11_4_bunchKaufmanPathLocalPivotIndex_ne_of_branch_ne
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    {t u : Fin k} (htu : t ≠ u)
    (i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)))
    (j : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step u))) :
    higham11_4_bunchKaufmanPathLocalPivotIndex k step t i ≠
      higham11_4_bunchKaufmanPathLocalPivotIndex k step u j := by
  apply higham11_4_bunchKaufmanPathLocalPivotIndex_ne_of_branch_val_ne
  · intro hval
    exact htu (Fin.ext hval)

/-- Equal embedded local pivot slots must come from the same path branch. -/
theorem higham11_4_bunchKaufmanPathLocalPivotIndex_branch_eq_of_eq
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    {t u : Fin k}
    (i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)))
    (j : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step u)))
    (hidx :
      higham11_4_bunchKaufmanPathLocalPivotIndex k step t i =
        higham11_4_bunchKaufmanPathLocalPivotIndex k step u j) :
    t = u := by
  by_contra hne
  exact
    higham11_4_bunchKaufmanPathLocalPivotIndex_ne_of_branch_ne
      k step hne i j hidx

/-- The final pivot index of an earlier branch is strictly before the leading
pivot index of a later branch. -/
theorem higham11_4_bunchKaufmanPathLastPivotIndex_lt_leadingPivotIndex_of_branch_lt
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    {t u : Fin k} (htu : t.val < u.val) :
    (higham11_4_bunchKaufmanPathLastPivotIndex k step t).val <
      (higham11_4_bunchKaufmanPathLeadingPivotIndex k step u).val := by
  simpa [higham11_4_bunchKaufmanPathLastPivotIndex,
    higham11_4_bunchKaufmanPathLeadingPivotIndex] using
    higham11_4_bunchKaufmanPathLocalPivotIndex_lt_of_branch_lt
      k step htu
      (higham11_4_bunchKaufmanBranchLastLocalIndex (step t))
      (higham11_4_bunchKaufmanBranchLeadingLocalIndex (step u))

/-- Two global path indices lie in the same active Bunch-Kaufman pivot block when
both are represented by local slots of one path branch. -/
def higham11_4_BunchKaufmanPathSameBranchPivotPair
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (a b : Fin (higham11_4_bunchKaufmanPathPivotSpan k step)) : Prop :=
  ∃ t : Fin k,
    (∃ i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)),
      higham11_4_bunchKaufmanPathLocalPivotIndex k step t i = a) ∧
    (∃ j : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)),
      higham11_4_bunchKaufmanPathLocalPivotIndex k step t j = b)

/-- A global `D̂` matrix for an active Bunch-Kaufman path is block diagonal
relative to the accepted pivot blocks if entries outside same-branch pairs are
zero. -/
def higham11_4_BunchKaufmanPathBlockDiagonalD
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (D : Fin (higham11_4_bunchKaufmanPathPivotSpan k step) →
      Fin (higham11_4_bunchKaufmanPathPivotSpan k step) → ℝ) : Prop :=
  ∀ a b : Fin (higham11_4_bunchKaufmanPathPivotSpan k step),
    ¬ higham11_4_BunchKaufmanPathSameBranchPivotPair k step a b →
      D a b = 0

/-- Named concrete off-branch zero condition for the path `D̂` matrix: entries
whose row and column slots come from distinct active branches are zero. -/
def higham11_4_BunchKaufmanPathOffBranchDEntriesZero
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (D : Fin (higham11_4_bunchKaufmanPathPivotSpan k step) →
      Fin (higham11_4_bunchKaufmanPathPivotSpan k step) → ℝ) : Prop :=
  ∀ t u : Fin k,
    t ≠ u →
      ∀ i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)),
        ∀ j : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step u)),
          D (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i)
              (higham11_4_bunchKaufmanPathLocalPivotIndex k step u j) = 0

/-- Same-branch pairs in the trailing active path remain same-branch pairs
after embedding into the original nonempty path. -/
theorem higham11_4_BunchKaufmanPathSameBranchPivotPair_of_tail
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch)
    (a b : Fin (higham11_4_bunchKaufmanPathPivotSpan k (fun u : Fin k => step u.succ)))
    (hsame : higham11_4_BunchKaufmanPathSameBranchPivotPair k
      (fun u : Fin k => step u.succ) a b) :
    higham11_4_BunchKaufmanPathSameBranchPivotPair (k + 1) step
      (higham11_4_bunchKaufmanPathTailIndex k step a)
      (higham11_4_bunchKaufmanPathTailIndex k step b) := by
  rcases hsame with ⟨t, ⟨i, hi⟩, ⟨j, hj⟩⟩
  refine ⟨t.succ, ⟨i, ?_⟩, ⟨j, ?_⟩⟩
  · rw [← hi]
    exact (higham11_4_bunchKaufmanPathTailIndex_localPivotIndex k step t i).symm
  · rw [← hj]
    exact (higham11_4_bunchKaufmanPathTailIndex_localPivotIndex k step t j).symm

/-- A same-branch pair between two embedded tail indices descends to a
same-branch pair in the trailing active path. -/
theorem higham11_4_BunchKaufmanPathSameBranchPivotPair_tail_of_tailIndex
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch)
    (a b : Fin (higham11_4_bunchKaufmanPathPivotSpan k (fun u : Fin k => step u.succ)))
    (hsame : higham11_4_BunchKaufmanPathSameBranchPivotPair (k + 1) step
      (higham11_4_bunchKaufmanPathTailIndex k step a)
      (higham11_4_bunchKaufmanPathTailIndex k step b)) :
    higham11_4_BunchKaufmanPathSameBranchPivotPair k
      (fun u : Fin k => step u.succ) a b := by
  rcases higham11_4_bunchKaufmanPathLocalPivotIndex_exists_of_global_index
      k (fun u : Fin k => step u.succ) a with
    ⟨t, i, hi⟩
  rcases higham11_4_bunchKaufmanPathLocalPivotIndex_exists_of_global_index
      k (fun u : Fin k => step u.succ) b with
    ⟨u, j, hj⟩
  have ha_eq :
      higham11_4_bunchKaufmanPathTailIndex k step a =
        higham11_4_bunchKaufmanPathLocalPivotIndex (k + 1) step t.succ i := by
    rw [← hi]
    exact higham11_4_bunchKaufmanPathTailIndex_localPivotIndex k step t i
  have hb_eq :
      higham11_4_bunchKaufmanPathTailIndex k step b =
        higham11_4_bunchKaufmanPathLocalPivotIndex (k + 1) step u.succ j := by
    rw [← hj]
    exact higham11_4_bunchKaufmanPathTailIndex_localPivotIndex k step u j
  have hsame_local :
      higham11_4_BunchKaufmanPathSameBranchPivotPair (k + 1) step
        (higham11_4_bunchKaufmanPathLocalPivotIndex (k + 1) step t.succ i)
        (higham11_4_bunchKaufmanPathLocalPivotIndex (k + 1) step u.succ j) := by
    simpa [ha_eq, hb_eq] using hsame
  rcases hsame_local with ⟨w, ⟨iw, hw_t⟩, ⟨jw, hw_u⟩⟩
  have hwt : w = t.succ :=
    higham11_4_bunchKaufmanPathLocalPivotIndex_branch_eq_of_eq
      (k + 1) step iw i hw_t
  have hwu : w = u.succ :=
    higham11_4_bunchKaufmanPathLocalPivotIndex_branch_eq_of_eq
      (k + 1) step jw j hw_u
  have htu : t = u := by
    apply Fin.ext
    have hsucc : t.succ = u.succ := by
      simpa [hwt] using hwu
    have hval := congrArg Fin.val hsucc
    simpa using hval
  subst u
  rw [← hi, ← hj]
  exact ⟨t, ⟨i, rfl⟩, ⟨j, rfl⟩⟩

/-- A head branch local pivot and a trailing branch local pivot are never in
the same active Bunch-Kaufman pivot block. -/
theorem higham11_4_BunchKaufmanPathSameBranchPivotPair_not_head_tail_local
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch)
    (i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step 0)))
    (t : Fin k)
    (j : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t.succ))) :
    ¬ higham11_4_BunchKaufmanPathSameBranchPivotPair (k + 1) step
      (higham11_4_bunchKaufmanPathLocalPivotIndex (k + 1) step 0 i)
      (higham11_4_bunchKaufmanPathLocalPivotIndex (k + 1) step t.succ j) := by
  intro hsame
  rcases hsame with ⟨u, ⟨iu, hu_head⟩, ⟨ju, hu_tail⟩⟩
  have hu0 : u = 0 :=
    higham11_4_bunchKaufmanPathLocalPivotIndex_branch_eq_of_eq
      (k + 1) step iu i hu_head
  have husucc : u = t.succ :=
    higham11_4_bunchKaufmanPathLocalPivotIndex_branch_eq_of_eq
      (k + 1) step ju j hu_tail
  have hu0_val : u.val = 0 := by
    simpa using congrArg Fin.val hu0
  have husucc_val : u.val = t.val + 1 := by
    simpa using congrArg Fin.val husucc
  omega

/-- A trailing branch local pivot and a head branch local pivot are never in
the same active Bunch-Kaufman pivot block. -/
theorem higham11_4_BunchKaufmanPathSameBranchPivotPair_not_tail_head_local
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch)
    (t : Fin k)
    (i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t.succ)))
    (j : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step 0))) :
    ¬ higham11_4_BunchKaufmanPathSameBranchPivotPair (k + 1) step
      (higham11_4_bunchKaufmanPathLocalPivotIndex (k + 1) step t.succ i)
      (higham11_4_bunchKaufmanPathLocalPivotIndex (k + 1) step 0 j) := by
  intro hsame
  rcases hsame with ⟨u, ⟨iu, hu_tail⟩, ⟨ju, hu_head⟩⟩
  have husucc : u = t.succ :=
    higham11_4_bunchKaufmanPathLocalPivotIndex_branch_eq_of_eq
      (k + 1) step iu i hu_tail
  have hu0 : u = 0 :=
    higham11_4_bunchKaufmanPathLocalPivotIndex_branch_eq_of_eq
      (k + 1) step ju j hu_head
  have hu0_val : u.val = 0 := by
    simpa using congrArg Fin.val hu0
  have husucc_val : u.val = t.val + 1 := by
    simpa using congrArg Fin.val husucc
  omega

/-- A head branch local pivot and an arbitrary embedded tail index are never in
the same active Bunch-Kaufman pivot block. -/
theorem higham11_4_BunchKaufmanPathSameBranchPivotPair_not_head_tailIndex
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch)
    (i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step 0)))
    (a : Fin (higham11_4_bunchKaufmanPathPivotSpan k (fun u : Fin k => step u.succ))) :
    ¬ higham11_4_BunchKaufmanPathSameBranchPivotPair (k + 1) step
      (higham11_4_bunchKaufmanPathLocalPivotIndex (k + 1) step 0 i)
      (higham11_4_bunchKaufmanPathTailIndex k step a) := by
  intro hsame
  rcases higham11_4_bunchKaufmanPathLocalPivotIndex_exists_of_global_index
      k (fun u : Fin k => step u.succ) a with
    ⟨t, j, hj⟩
  have htail_eq :
      higham11_4_bunchKaufmanPathTailIndex k step a =
        higham11_4_bunchKaufmanPathLocalPivotIndex (k + 1) step t.succ j := by
    rw [← hj]
    exact higham11_4_bunchKaufmanPathTailIndex_localPivotIndex k step t j
  exact
    higham11_4_BunchKaufmanPathSameBranchPivotPair_not_head_tail_local
      k step i t j (by simpa [htail_eq] using hsame)

/-- An arbitrary embedded tail index and a head branch local pivot are never in
the same active Bunch-Kaufman pivot block. -/
theorem higham11_4_BunchKaufmanPathSameBranchPivotPair_not_tailIndex_head
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch)
    (a : Fin (higham11_4_bunchKaufmanPathPivotSpan k (fun u : Fin k => step u.succ)))
    (i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step 0))) :
    ¬ higham11_4_BunchKaufmanPathSameBranchPivotPair (k + 1) step
      (higham11_4_bunchKaufmanPathTailIndex k step a)
      (higham11_4_bunchKaufmanPathLocalPivotIndex (k + 1) step 0 i) := by
  intro hsame
  rcases higham11_4_bunchKaufmanPathLocalPivotIndex_exists_of_global_index
      k (fun u : Fin k => step u.succ) a with
    ⟨t, j, hj⟩
  have htail_eq :
      higham11_4_bunchKaufmanPathTailIndex k step a =
        higham11_4_bunchKaufmanPathLocalPivotIndex (k + 1) step t.succ j := by
    rw [← hj]
    exact higham11_4_bunchKaufmanPathTailIndex_localPivotIndex k step t j
  exact
    higham11_4_BunchKaufmanPathSameBranchPivotPair_not_tail_head_local
      k step t j i (by simpa [htail_eq] using hsame)

/-- Restrict a full-path matrix to the trailing active Bunch-Kaufman subpath. -/
def higham11_4_bunchKaufmanPathTailMatrix
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch)
    (D : Fin (higham11_4_bunchKaufmanPathPivotSpan (k + 1) step) →
      Fin (higham11_4_bunchKaufmanPathPivotSpan (k + 1) step) → ℝ) :
    Fin (higham11_4_bunchKaufmanPathPivotSpan k (fun u : Fin k => step u.succ)) →
      Fin (higham11_4_bunchKaufmanPathPivotSpan k (fun u : Fin k => step u.succ)) → ℝ :=
  fun a b => D
    (higham11_4_bunchKaufmanPathTailIndex k step a)
    (higham11_4_bunchKaufmanPathTailIndex k step b)

/-- A block-diagonal full-path `D̂` restricts to a block-diagonal trailing-path
matrix. -/
theorem higham11_4_BunchKaufmanPathBlockDiagonalD_tail
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch)
    (D : Fin (higham11_4_bunchKaufmanPathPivotSpan (k + 1) step) →
      Fin (higham11_4_bunchKaufmanPathPivotSpan (k + 1) step) → ℝ)
    (hblock : higham11_4_BunchKaufmanPathBlockDiagonalD (k + 1) step D) :
    higham11_4_BunchKaufmanPathBlockDiagonalD k (fun u : Fin k => step u.succ)
      (higham11_4_bunchKaufmanPathTailMatrix k step D) := by
  intro a b hnot
  exact hblock
    (higham11_4_bunchKaufmanPathTailIndex k step a)
    (higham11_4_bunchKaufmanPathTailIndex k step b)
    (fun hsame =>
      hnot (higham11_4_BunchKaufmanPathSameBranchPivotPair_tail_of_tailIndex
        k step a b hsame))

/-- A block-diagonal full-path `D̂` has zero entries from the head pivot block
to the embedded trailing path. -/
theorem higham11_4_BunchKaufmanPathBlockDiagonalD_head_tail_zero
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch)
    (D : Fin (higham11_4_bunchKaufmanPathPivotSpan (k + 1) step) →

    higham11_4_BunchKaufmanPathBranchwiseSourceSixGrowthCaps
      k step L D Dmax :=
  higham11_4_BunchKaufmanPathBranchwiseSourceSixGrowthCaps_of_scalar_and_twoByTwo_local_caps
    k step L D Dmax
    (fun t _ => by
      simpa [higham11_4_bunchKaufmanPathLeadingPivotIndex] using

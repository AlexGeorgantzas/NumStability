  higham11_15_aasenMiddleSolveBudget_infNorm_le_of_absLU_norm_bound
    fp n L_T_hat U_T_hat T_hat κmid hn
    (higham11_15_absLU_infNorm_le_of_componentwise_T_bound
      n L_T_hat U_T_hat T_hat κmid hκmid hentry)


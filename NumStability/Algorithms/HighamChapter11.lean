/-- Earlier branches end no later than any later branch's start in a scheduled
active Bunch-Kaufman path. -/
theorem higham11_4_bunchKaufmanPathStartOffsetsFrom_branch_end_le_of_lt
    (base k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (starts : Fin k → ℕ)
    (hstarts : higham11_4_BunchKaufmanPathStartOffsetsFrom base k step starts)
    {t u : Fin k} (htu : t.val < u.val) :
    starts t + higham11_4_bunchKaufmanBranchSupportOffset (step t) ≤
      starts u := by
  induction k generalizing base with
  | zero =>
      exact Fin.elim0 t
  | succ k ih =>
      cases t using Fin.cases with
      | zero =>
          cases u using Fin.cases with
          | zero =>
              omega
          | succ u =>
              have htail :=
                higham11_4_bunchKaufmanPathStartOffsetsFrom_tail
                  base k step starts hstarts
              have htail_base_le :=
                higham11_4_bunchKaufmanPathStartOffsetsFrom_base_le
                  (base + higham11_4_bunchKaufmanBranchSupportOffset (step 0))
                  k (fun t : Fin k => step t.succ)
                  (fun t : Fin k => starts t.succ) htail u
              have hhead :=
                higham11_4_bunchKaufmanPathStartOffsetsFrom_head
                  base (k + 1) step starts hstarts (by omega)
              have hzero : starts (0 : Fin (k + 1)) = base := by
                simpa using hhead
              simpa [hzero, add_comm, add_left_comm, add_assoc] using
                htail_base_le
      | succ t =>
          cases u using Fin.cases with
          | zero =>
              simp [Fin.val_succ] at htu
          | succ u =>
              have htail :=
                higham11_4_bunchKaufmanPathStartOffsetsFrom_tail
                  base k step starts hstarts
              have htu_tail : t.val < u.val := by
                simpa [Fin.val_succ] using htu
              exact
                ih (base + higham11_4_bunchKaufmanBranchSupportOffset (step 0))
                  (fun t : Fin k => step t.succ)
                  (fun t : Fin k => starts t.succ) htail htu_tail

/-- Start offsets are strictly ordered along a scheduled active
Bunch-Kaufman path. -/
theorem higham11_4_bunchKaufmanPathStartOffsetsFrom_lt_of_lt
    (base k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (starts : Fin k → ℕ)
    (hstarts : higham11_4_BunchKaufmanPathStartOffsetsFrom base k step starts)
    {t u : Fin k} (htu : t.val < u.val) :
    starts t < starts u := by
  have hend :=
    higham11_4_bunchKaufmanPathStartOffsetsFrom_branch_end_le_of_lt
      base k step starts hstarts htu
  exact Nat.lt_of_lt_of_le
    (Nat.lt_add_of_pos_right
      (higham11_4_bunchKaufmanBranchSupportOffset_pos (step t))) hend

/-- Start offsets are monotone with respect to path index in a scheduled
active Bunch-Kaufman path. -/
theorem higham11_4_bunchKaufmanPathStartOffsetsFrom_le_of_le
    (base k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)
    (starts : Fin k → ℕ)
    (hstarts : higham11_4_BunchKaufmanPathStartOffsetsFrom base k step starts)
    {t u : Fin k} (htu : t.val ≤ u.val) :
    starts t ≤ starts u := by
  by_cases hEq : t = u
  · subst u
    exact le_rfl
  · have hval_ne : t.val ≠ u.val := by
      intro hval
      exact hEq (Fin.ext hval)
    have hlt : t.val < u.val := lt_of_le_of_ne htu hval_ne
    exact
      (higham11_4_bunchKaufmanPathStartOffsetsFrom_lt_of_lt
        base k step starts hstarts hlt).le

/-- Branch endpoints are monotone with respect to path index in a scheduled
active Bunch-Kaufman path. -/
theorem higham11_4_bunchKaufmanPathStartOffsetsFrom_branch_end_le_branch_end_of_le
    (base k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)

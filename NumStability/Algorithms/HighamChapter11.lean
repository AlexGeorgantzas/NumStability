growth cap. -/
theorem higham11_8_aasenSourceNormwiseBackwardBound_of_infNorm_T_hat_le_printed_mul_infNorm
    (n : ℕ) (ΔA_inf γ15n25 : ℝ) (T_hat A : Fin n → Fin n → ℝ)
    (hγ : 0 ≤ γ15n25)
    (hbound :
      higham11_8_aasenNormwiseBackwardBound n ΔA_inf γ15n25
        (infNorm T_hat))
    (hTcap : infNorm T_hat ≤ (4 : ℝ) ^ (n - 2) * infNorm A) :
    higham11_8_aasenSourceNormwiseBackwardBound n ΔA_inf γ15n25
      (infNorm A) :=
  higham11_8_aasenSourceNormwiseBackwardBound_of_T_hat_cap
    n ΔA_inf γ15n25 (infNorm T_hat) (infNorm A) hγ hbound hTcap

/-- If the computed Aasen middle factor is bounded by `κ‖A‖∞` and `κ` is no
larger than the printed growth factor, then any existing `T_hat`-norm
backward-error bound has the printed source-norm form. -/
theorem higham11_8_aasenSourceNormwiseBackwardBound_of_infNorm_T_hat_le_kappa_mul_infNorm
    (n : ℕ) (ΔA_inf γ15n25 κ : ℝ)
    (T_hat A : Fin n → Fin n → ℝ)

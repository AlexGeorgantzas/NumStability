/-- Source-six path product bound from branch-local `|L̂|` row sums and a
growth-scaled local `D̂` cap. -/
theorem higham11_4_maxEntryNorm_absLDLTProduct_le_of_path_local_LD_caps_uniform_six_row_sum_growth_D_bound
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch) (hk : 0 < k)
    (L_hat D_hat : Fin (higham11_4_bunchKaufmanPathPivotSpan k step) →
      Fin (higham11_4_bunchKaufmanPathPivotSpan k step) → ℝ)
    (ρ_n Amax : ℝ) (hρ : 0 ≤ ρ_n) (hAmax : 0 ≤ Amax)
    (hblock : higham11_4_BunchKaufmanPathBlockDiagonalD k step D_hat)
    (hDlocal :
      higham11_4_BunchKaufmanPathLocalDEntryBound k step D_hat (ρ_n * Amax))
    (hLlocal :
      ∀ t : Fin k,
        ∀ i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t)),
          (∑ q : Fin (higham11_4_bunchKaufmanPathPivotSpan k step),
            |L_hat (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i) q|) ≤
              6) :
    maxEntryNorm (higham11_4_bunchKaufmanPathPivotSpan_pos k step hk)
        (higham11_4_absLDLTProduct
          (higham11_4_bunchKaufmanPathPivotSpan k step) L_hat D_hat) ≤
      36 * (higham11_4_bunchKaufmanPathPivotSpan k step : ℝ) * ρ_n * Amax := by
  have hDmax : 0 ≤ ρ_n * Amax := mul_nonneg hρ hAmax
  have hspan :
      (1 : ℝ) ≤ (higham11_4_bunchKaufmanPathPivotSpan k step : ℝ) := by
    exact_mod_cast Nat.succ_le_of_lt
      (higham11_4_bunchKaufmanPathPivotSpan_pos k step hk)
  have hbudget :
      (6 : ℝ) * (ρ_n * Amax) * 6 ≤
        36 * (higham11_4_bunchKaufmanPathPivotSpan k step : ℝ) * ρ_n * Amax := by
    calc
      (6 : ℝ) * (ρ_n * Amax) * 6 = 36 * (ρ_n * Amax) := by ring
      _ = (36 * 1) * (ρ_n * Amax) := by ring
      _ ≤ (36 * (higham11_4_bunchKaufmanPathPivotSpan k step : ℝ)) *
            (ρ_n * Amax) := by
          exact mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_left hspan (by norm_num)) hDmax
      _ = 36 * (higham11_4_bunchKaufmanPathPivotSpan k step : ℝ) *
            ρ_n * Amax := by ring
  exact
    higham11_4_maxEntryNorm_absLDLTProduct_le_of_path_local_LD_caps_uniform_row_sum_bound
      k step hk L_hat D_hat (ρ_n * Amax) 6 ρ_n Amax hDmax hblock hDlocal
      hLlocal hbudget


    (hω1_Amax : ω1 ≤ Amax) :
    |a11| ≤ Amax :=
  (higham11_4_bunch_kaufman_case2_pivot_entry_bound
    a11 arr ω1 ωr hω1 hcase).trans hω1_Amax


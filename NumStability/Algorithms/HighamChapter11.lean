/-- A nonempty path `D̂` matrix is block diagonal when the scheduled tail is
block diagonal and the head/tail cross entries are zero. -/
theorem higham11_4_BunchKaufmanPathBlockDiagonalD_cons
    (k : ℕ) (step : Fin (k + 1) → higham11_4_BunchKaufmanActiveBranch)
    (D : Fin (higham11_4_bunchKaufmanPathPivotSpan (k + 1) step) →
      Fin (higham11_4_bunchKaufmanPathPivotSpan (k + 1) step) → ℝ)
    (hhead_tail :
      ∀ i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step 0)),
        ∀ a : Fin (higham11_4_bunchKaufmanPathPivotSpan k
          (fun u : Fin k => step u.succ)),
          D (higham11_4_bunchKaufmanPathLocalPivotIndex (k + 1) step 0 i)
            (higham11_4_bunchKaufmanPathTailIndex k step a) = 0)
    (htail_head :
      ∀ a : Fin (higham11_4_bunchKaufmanPathPivotSpan k
          (fun u : Fin k => step u.succ)),
        ∀ i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step 0)),
          D (higham11_4_bunchKaufmanPathTailIndex k step a)
            (higham11_4_bunchKaufmanPathLocalPivotIndex (k + 1) step 0 i) = 0)
    (htail :
      higham11_4_BunchKaufmanPathBlockDiagonalD k
        (fun u : Fin k => step u.succ)
        (higham11_4_bunchKaufmanPathTailMatrix k step D)) :
    higham11_4_BunchKaufmanPathBlockDiagonalD (k + 1) step D :=
  higham11_4_BunchKaufmanPathBlockDiagonalD_of_offbranch_D_entries_zero
    (k + 1) step D
    (higham11_4_BunchKaufmanPathOffBranchDEntriesZero_cons
      k step D hhead_tail htail_head
      (fun t u htu i j =>
        htail
          (higham11_4_bunchKaufmanPathLocalPivotIndex k
            (fun v : Fin k => step v.succ) t i)
          (higham11_4_bunchKaufmanPathLocalPivotIndex k
            (fun v : Fin k => step v.succ) u j)
          (fun hsame => by
            rcases hsame with ⟨w, ⟨iw, hw_t⟩, ⟨jw, hw_u⟩⟩
            have hwt : w = t :=
              higham11_4_bunchKaufmanPathLocalPivotIndex_branch_eq_of_eq
                k (fun v : Fin k => step v.succ) iw i hw_t
            have hwu : w = u :=
              higham11_4_bunchKaufmanPathLocalPivotIndex_branch_eq_of_eq
                k (fun v : Fin k => step v.succ) jw j hw_u
            exact htu (hwt.symm.trans hwu))))


/-- Local `D̂` entry bounds and two-supported source-six `L̂` rows assemble
the named branchwise source-six/growth cap predicate. -/
theorem higham11_4_BunchKaufmanPathBranchwiseSourceSixGrowthCaps_of_local_D_entry_and_two_nonzero_L_rows
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)

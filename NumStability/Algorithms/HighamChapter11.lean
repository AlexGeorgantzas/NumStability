/-- **Theorem 11.7 uniform path coefficient majorant**.  Uniform caps for the
local step coefficient and recursive-tail coefficient give the pointwise
coefficient domination required by the concrete prefix-path endpoints. -/
theorem higham11_7_tridiagonalBranchPath_uniform_coeff_majorant_of_component_bounds
    (k : ℕ) (c_bound c_rec : Fin k → ℝ) (c_bound_cap c_rec_cap c : ℝ)
    (hbound : ∀ t : Fin k, c_bound t ≤ c_bound_cap)
    (hrec : ∀ t : Fin k, c_rec t ≤ c_rec_cap)
    (hcap : c_bound_cap + c_rec_cap ≤ c) :
    ∀ t : Fin k, c_bound t + c_rec t ≤ c := by
  intro t
  exact (add_le_add (hbound t) (hrec t)).trans hcap

/-- **Theorem 11.7 additive path coefficient majorant**.  The direct version
where the final per-branch coefficient is the sum of the two uniform component
caps. -/
theorem higham11_7_tridiagonalBranchPath_uniform_coeff_add_majorant_of_component_bounds
    (k : ℕ) (c_bound c_rec : Fin k → ℝ) (c_bound_cap c_rec_cap : ℝ)
    (hbound : ∀ t : Fin k, c_bound t ≤ c_bound_cap)
    (hrec : ∀ t : Fin k, c_rec t ≤ c_rec_cap) :
    ∀ t : Fin k, c_bound t + c_rec t ≤ c_bound_cap + c_rec_cap :=
  higham11_7_tridiagonalBranchPath_uniform_coeff_majorant_of_component_bounds
    k c_bound c_rec c_bound_cap c_rec_cap (c_bound_cap + c_rec_cap)
    hbound hrec le_rfl

/-- **Theorem 11.7 uniform component coefficient-sum identity**.  A constant
local-step plus recursive-tail coefficient cap summed over a finite pivot path
is the path length times the combined cap. -/
theorem higham11_7_tridiagonalBranchPath_uniform_component_coeff_sum_eq
    (k : ℕ) (c_bound_cap c_rec_cap : ℝ) :
    (∑ _t : Fin k, (c_bound_cap + c_rec_cap)) =
      (k : ℝ) * (c_bound_cap + c_rec_cap) := by
  simp [Finset.sum_const, nsmul_eq_mul, mul_add]

/-- **Theorem 11.7 uniform component coefficient-sum majorant**.  Pointwise
uniform caps for the local-step and recursive-tail coefficients aggregate to
the path-length times the combined component cap. -/
theorem higham11_7_tridiagonalBranchPath_uniform_component_coeff_sum_le
    (k : ℕ) (c_bound c_rec : Fin k → ℝ) (c_bound_cap c_rec_cap : ℝ)
    (hbound : ∀ t : Fin k, c_bound t ≤ c_bound_cap)
    (hrec : ∀ t : Fin k, c_rec t ≤ c_rec_cap) :
    (∑ t : Fin k, (c_bound t + c_rec t)) ≤
      (k : ℝ) * (c_bound_cap + c_rec_cap) := by
  calc
    (∑ t : Fin k, (c_bound t + c_rec t))
        ≤ ∑ _t : Fin k, (c_bound_cap + c_rec_cap) :=
          Finset.sum_le_sum (fun t _ht => add_le_add (hbound t) (hrec t))
    _ = (k : ℝ) * (c_bound_cap + c_rec_cap) :=
          higham11_7_tridiagonalBranchPath_uniform_component_coeff_sum_eq
            k c_bound_cap c_rec_cap

/-- **Theorem 11.7 uniform component coefficient-sum comparison**.  The
component coefficient-sum majorant can be discharged by any scalar cap above
the path-length times the combined local-step and recursive-tail caps. -/
theorem higham11_7_tridiagonalBranchPath_uniform_component_coeff_sum_le_of_le
    (k : ℕ) (c_bound c_rec : Fin k → ℝ) (c_bound_cap c_rec_cap C : ℝ)
    (hbound : ∀ t : Fin k, c_bound t ≤ c_bound_cap)
    (hrec : ∀ t : Fin k, c_rec t ≤ c_rec_cap)
    (hC : (k : ℝ) * (c_bound_cap + c_rec_cap) ≤ C) :
    (∑ t : Fin k, (c_bound t + c_rec t)) ≤ C :=

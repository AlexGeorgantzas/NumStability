                k step t hstep j)) := by
  simpa [higham11_7_tridiagonalPathFirstTrailingIndex_one] using
    higham11_7_tridiagonalLiftLocalBlockPerturbation_embedded_row_dot_eq_local
      (n := higham11_7_tridiagonalPathPivotSpan k step + 1)

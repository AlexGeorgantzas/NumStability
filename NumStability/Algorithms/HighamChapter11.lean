    (hLtail :
      ∀ t : Fin k,
        ∀ i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step t.succ)),
          (∑ q : Fin (higham11_4_bunchKaufmanPathPivotSpan (k + 1) step),
            |L_hat (higham11_4_bunchKaufmanPathLocalPivotIndex (k + 1) step t.succ i) q|)
              ≤ 6) :
    higham11_4_BunchKaufmanPathSourceSixGrowthLDPackage
      (k + 1) step L_hat D_hat ρ_n Amax :=
  higham11_4_BunchKaufmanPathSourceSixGrowthLDPackage_of_local_L_row_sum_bound
    (k + 1) step L_hat D_hat ρ_n Amax hblock
    (higham11_4_BunchKaufmanPathLocalDEntryBound_cons
      k step D_hat (ρ_n * Amax) hDhead hDtail)

              s ≠ q t i →
                L (higham11_4_bunchKaufmanPathLocalPivotIndex k step t i) s = 0) :
    higham11_4_BunchKaufmanPathBranchwiseSourceSixGrowthCaps
      k step L D Dmax :=
  higham11_4_BunchKaufmanPathBranchwiseSourceSixGrowthCaps_of_local_D_entry_and_L_row_sum_bounds
    k step L D Dmax hDlocal
    (higham11_4_BunchKaufmanPathLocalLRowSumBound_of_two_nonzero_rows
      k step L p q hpq hentry hzero)


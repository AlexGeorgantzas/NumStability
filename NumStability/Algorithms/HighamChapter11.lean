theorem higham11_4_BunchKaufmanPathBranchwiseSourceSixGrowthCaps_of_local_D_entry_and_single_nonzero_L_rows
    (k : ℕ) (step : Fin k → higham11_4_BunchKaufmanActiveBranch)

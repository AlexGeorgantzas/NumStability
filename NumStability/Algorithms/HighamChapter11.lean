theorem higham11_4_D_bound_of_prefix_growth_factor
    (n : ℕ) (D_hat : Fin n → Fin n → ℝ) (ρ0 Amax : ℝ) (r : ℕ → ℝ)
    (hAmax : 0 ≤ Amax)
    (h0 : r 0 = ρ0)
    (hstep : ∀ k, k < n - 1 →
      r (k + 1) ≤ (1 + higham11_1_bunchParlettAlpha⁻¹) * r k)
    (hD : ∀ k₁ k₂ : Fin n, |D_hat k₁ k₂| ≤ r (n - 1) * Amax) :
    ∀ k₁ k₂ : Fin n,
      |D_hat k₁ k₂| ≤

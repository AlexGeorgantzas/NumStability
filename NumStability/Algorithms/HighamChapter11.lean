          ρ_n * Amax)
    (hDtail :
      higham11_4_BunchKaufmanPathLocalDEntryBound k
        (fun u : Fin k => step u.succ)
        (higham11_4_bunchKaufmanPathTailMatrix k step D_hat) (ρ_n * Amax))
    (hLhead :
      ∀ i : Fin (higham11_4_bunchKaufmanBranchSupportOffset (step 0)),

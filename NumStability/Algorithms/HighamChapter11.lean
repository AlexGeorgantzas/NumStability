    ∃ ΔA1 ΔA2 : Fin n → Fin n → ℝ,
      (∀ i j : Fin n, |ΔA1 i j| ≤ c * u * Amax) ∧
      (∀ i j : Fin n, |ΔA2 i j| ≤ c * u * Amax) ∧

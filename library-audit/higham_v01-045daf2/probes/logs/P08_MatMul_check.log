NumStability.matMul_error_bound (fp : NumStability.FPModel) (m n p : ℕ) (A : Fin m → Fin n → ℝ) (B : Fin n → Fin p → ℝ)
  (hn : NumStability.gammaValid fp n) (i : Fin m) (j : Fin p) :
  |NumStability.fl_matMul fp m n p A B i j - ∑ k, A i k * B k j| ≤ NumStability.gamma fp n * ∑ k, |A i k| * |B k j|
